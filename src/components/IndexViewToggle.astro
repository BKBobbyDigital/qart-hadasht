---
/**
 * Cards / Table / Timeline view toggle for index pages.
 *
 * Renders a pill-style toggle with one button per view passed in via the
 * `views` prop. Persists the user's choice in localStorage under
 * `qh.indexView` so it sticks across sessions and pages.
 *
 * Pages using this component should structure markup as:
 *   <div data-view-container>
 *     <IndexViewToggle views={['cards', 'table', 'timeline']} />
 *     <div data-view-cards>...cards...</div>
 *     <div data-view-table>...table...</div>
 *     <div data-view-timeline>...timeline...</div>
 *   </div>
 *
 * The shared script below toggles which child is visible based on the
 * `data-view` attribute on the container.
 */
type ViewName = 'cards' | 'table' | 'timeline';
interface Props {
  views?: ViewName[];
  defaultView?: ViewName;
}
const { views = ['cards', 'table'], defaultView } = Astro.props;
const labels: Record<ViewName, string> = {
  cards: 'Cards',
  table: 'Table',
  timeline: 'Timeline',
};
// The data-default-view attribute on the toggle gets read by the script
// below to seed the initial view when no localStorage value exists.
const initialView = defaultView ?? views[0];
---

<div class="hidden sm:flex justify-end mb-4" data-default-view={initialView}>
  <div class="inline-flex border border-sand-300 rounded-full p-0.5 bg-sand-50 text-xs">
    {views.map((v) => (
      <button
        type="button"
        data-view-button={v}
        class="px-3 py-1 rounded-full uppercase tracking-wider font-semibold transition-colors"
        aria-label={`${labels[v]} view`}
      >
        {labels[v]}
      </button>
    ))}
  </div>
</div>

<style is:global>
  /* View subtrees both render to the DOM; the container's data-view
     attribute decides which is visible. Default-hide all non-active
     subtrees, then explicitly un-hide the active one. */
  [data-view-container][data-view='cards']    [data-view-table],
  [data-view-container][data-view='cards']    [data-view-timeline],
  [data-view-container][data-view='table']    [data-view-cards],
  [data-view-container][data-view='table']    [data-view-timeline],
  [data-view-container][data-view='timeline'] [data-view-cards],
  [data-view-container][data-view='timeline'] [data-view-table] { display: none; }

  /* Active button state */
  [data-view-container][data-view='cards']    [data-view-button='cards'],
  [data-view-container][data-view='table']    [data-view-button='table'],
  [data-view-container][data-view='timeline'] [data-view-button='timeline'] {
    background-color: #5b0f31; /* tyrian-700 */
    color: white;
  }
  /* Inactive button styling */
  [data-view-container] [data-view-button] { color: #6b5638; /* sand-700 */ }
  [data-view-container][data-view='cards']    [data-view-button='cards'],
  [data-view-container][data-view='table']    [data-view-button='table'],
  [data-view-container][data-view='timeline'] [data-view-button='timeline'] {
    color: white;
  }
  [data-view-container] [data-view-button]:hover {
    background-color: #f4ede0; /* sand-100 */
  }
  [data-view-container][data-view='cards']    [data-view-button='cards']:hover,
  [data-view-container][data-view='table']    [data-view-button='table']:hover,
  [data-view-container][data-view='timeline'] [data-view-button='timeline']:hover {
    background-color: #5b0f31; /* keep active button tyrian on hover */
  }

  /* Sortable table headers */
  th[data-sort-key] {
    cursor: pointer;
    user-select: none;
    position: relative;
  }
  th[data-sort-key]:hover {
    background-color: #f4ede0;
  }
  th[data-sort-key][data-sort-active='asc']::after,
  th[data-sort-key][data-sort-active='desc']::after {
    content: '';
    display: inline-block;
    margin-left: 6px;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    vertical-align: middle;
  }
  th[data-sort-key][data-sort-active='asc']::after {
    border-bottom: 5px solid #5b0f31;
  }
  th[data-sort-key][data-sort-active='desc']::after {
    border-top: 5px solid #5b0f31;
  }

  /* Mobile fallback: tables are unwieldy on small screens. Force cards on
     narrow viewports regardless of preference. */
  @media (max-width: 640px) {
    [data-view-container] [data-view-table] { display: none !important; }
    [data-view-container] [data-view-cards] { display: block !important; }
  }
</style>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'qh.indexView';

    function applyView(container, view) {
      container.setAttribute('data-view', view);
    }

    function setupContainer(container) {
      // Discover which views this container actually supports from the
      // buttons rendered. Any stored value outside this set falls back to
      // the first available view.
      const supported = new Set(
        Array.from(container.querySelectorAll('[data-view-button]'))
          .map((b) => b.getAttribute('data-view-button'))
          .filter(Boolean)
      );
      const stored = (() => {
        try { return localStorage.getItem(STORAGE_KEY); } catch { return null; }
      })();
      // Default view: read from the toggle's data-default-view attribute
      // if set, else fall back to cards (or the first supported view).
      const toggle = container.querySelector('[data-default-view]');
      const declared = toggle && toggle.getAttribute('data-default-view');
      const fallback = (declared && supported.has(declared))
        ? declared
        : (supported.has('cards') ? 'cards' : (supported.values().next().value || 'cards'));
      const initial = stored && supported.has(stored) ? stored : fallback;
      applyView(container, initial);

      container.querySelectorAll('[data-view-button]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const view = btn.getAttribute('data-view-button');
          if (!view || !supported.has(view)) return;
          applyView(container, view);
          try { localStorage.setItem(STORAGE_KEY, view); } catch { /* noop */ }
        });
      });

      // Wire up sortable table headers within this container.
      container.querySelectorAll('table[data-sortable]').forEach((table) => {
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        table.querySelectorAll('th[data-sort-key]').forEach((th) => {
          th.addEventListener('click', () => {
            const key = th.getAttribute('data-sort-key');
            if (!key) return;
            const current = th.getAttribute('data-sort-active');
            const next = current === 'asc' ? 'desc' : 'asc';
            // Clear other headers
            table.querySelectorAll('th[data-sort-active]').forEach((other) => {
              if (other !== th) other.removeAttribute('data-sort-active');
            });
            th.setAttribute('data-sort-active', next);

            const rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort((a, b) => {
              const av = a.getAttribute(`data-sort-${key}`) ?? '';
              const bv = b.getAttribute(`data-sort-${key}`) ?? '';
              const an = parseFloat(av);
              const bn = parseFloat(bv);
              const numeric = !Number.isNaN(an) && !Number.isNaN(bn);
              const cmp = numeric ? an - bn : av.localeCompare(bv);
              return next === 'asc' ? cmp : -cmp;
            });
            rows.forEach((r) => tbody.appendChild(r));
          });
        });
      });
    }

    // This script is inline (is:inline), so it executes at its position in
    // the page — above the table/view markup further down. Defer setup to
    // DOMContentLoaded so the sortable table and view subtrees exist when
    // we query for them (otherwise the sort click-handlers never attach).
    function init() {
      document.querySelectorAll('[data-view-container]').forEach(setupContainer);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
