---
import { getEntry } from 'astro:content';
import ConfidenceBadge from './ConfidenceBadge.astro';
import SourceDistance from './SourceDistance.astro';
import { renderSummaryHtml, type LinkRegistry, renderInline } from '../lib/autolink';

interface Props {
  claim: any;
  /**
   * The claim's own detail page puts the statement in its <h1>, so the card
   * there renders the apparatus only. Everywhere else the statement is the
   * point of the card and stays.
   */
  hideStatement?: boolean;
}
const { claim, hideStatement = false } = Astro.props;
const data = claim.data;

// Empty registry — claim cards are reused widely (claim index, embedded on
// entity pages, etc.) and don't have a clean way to get the full registry.
// Markdown formatting (headings, bullets, **bold**, *italic*, [text](url))
// still works; entity-name autolinking is skipped within the card body.
const emptyRegistry: LinkRegistry = { candidates: [] };
const disputeHtml = data.dispute_summary
  ? renderSummaryHtml(data.dispute_summary, emptyRegistry)
  : '';

// Resolve source references
const sourceEntries = await Promise.all(
  data.sources.map(async (s: any) => {
    const entry = await getEntry('sources', s.source.id);
    return { ...s, sourceData: entry?.data };
  })
);

// Modern works listed on the claim whose arguments the site has not checked
// in the work itself. Rendered apart from the cited sources, with no stance
// and no characterization, so the claim's evidence is not padded by books
// nobody has read.
const furtherReading = await Promise.all(
  (data.further_reading ?? []).map(async (r: any) => {
    const entry = await getEntry('sources', r.source.id);
    return { ...r, sourceData: entry?.data };
  })
);
---

<article class="border border-sand-300 rounded-lg bg-sand-50 p-5 my-4">
  <div class="flex items-start gap-3">
    <ConfidenceBadge confidence={data.confidence} />
    {!hideStatement && (
      <p class="font-serif text-lg leading-snug flex-1 m-0" set:html={renderInline(data.statement)}></p>
    )}
  </div>

  {data.scholarly_consensus && (
    <p class="text-sm text-sand-700 mt-3 italic">
      Scholarly consensus: <span set:html={renderInline(data.scholarly_consensus)} />
    </p>
  )}

  {data.dispute_summary && (
    <details class="mt-3 text-sm">
      <summary class="cursor-pointer font-medium text-tyrian-700">The debate →</summary>
      <div class="mt-2 prose-encyclopedia text-sand-900" set:html={disputeHtml} />
    </details>
  )}

  <div class="mt-4 pt-3 border-t border-sand-200">
    <p class="text-xs uppercase tracking-widest text-sand-700 font-semibold mb-2">Sources</p>
    <ul class="text-sm space-y-1.5">
      {sourceEntries.map((s: any) => (
        <li class="flex gap-2">
          <span class="text-sand-500 shrink-0">{s.stance === 'supports' ? '✓' : s.stance === 'contradicts' ? '✗' : '~'}</span>
          <span class="flex-1">
            <span class="inline-flex items-baseline gap-2 flex-wrap">
              <a href={`/sources/${s.source.id}`} class="font-medium text-tyrian-700 hover:underline">
                {s.sourceData?.author ? `${s.sourceData.author}, ` : ''}{s.sourceData?.title}
              </a>
              <SourceDistance source={s.sourceData} />
            </span>
            {s.passage_ref && <span class="text-sand-700"> {s.passage_ref}</span>}
            <span class="text-sand-700"> — <span set:html={renderInline(s.passage_summary)} /></span>
          </span>
        </li>
      ))}
    </ul>
  </div>

  {furtherReading.length > 0 && (
    <div class="mt-3 pt-3 border-t border-sand-200">
      <p class="text-xs uppercase tracking-widest text-sand-700 font-semibold mb-2">
        Further reading, not cited as evidence
      </p>
      <ul class="text-sm space-y-1">
        {furtherReading.map((r: any) => (
          <li>
            <a href={`/sources/${r.source.id}`} class="text-tyrian-700 hover:underline">
              {r.sourceData?.author ? `${r.sourceData.author}, ` : ''}{r.sourceData?.title}
            </a>
            {r.note && <span class="text-sand-700"> — <span set:html={renderInline(r.note)} /></span>}
          </li>
        ))}
      </ul>
      <p class="text-xs text-sand-700 mt-2">
        These works treat the subject; the site has not checked their
        arguments against the works themselves, so it does not say here what
        they conclude. <a href="/charter" class="text-tyrian-700 underline">Why this is separated</a>.
      </p>
    </div>
  )}
</article>
