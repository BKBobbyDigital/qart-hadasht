---
import { getEntry } from 'astro:content';
import ConfidenceBadge from './ConfidenceBadge.astro';

interface Props {
  claim: any;
}
const { claim } = Astro.props;
const data = claim.data;

// Resolve source references
const sourceEntries = await Promise.all(
  data.sources.map(async (s: any) => {
    const entry = await getEntry('sources', s.source.id);
    return { ...s, sourceData: entry?.data };
  })
);
---

<article class="border border-sand-300 rounded-lg bg-white/60 p-5 my-4">
  <div class="flex items-start gap-3">
    <ConfidenceBadge confidence={data.confidence} />
    <p class="font-serif text-lg leading-snug flex-1 m-0">{data.statement}</p>
  </div>

  {data.scholarly_consensus && (
    <p class="text-sm text-sand-700 mt-3 italic">
      Scholarly consensus: {data.scholarly_consensus}
    </p>
  )}

  {data.dispute_summary && (
    <details class="mt-3 text-sm">
      <summary class="cursor-pointer font-medium text-tyrian-700">The debate →</summary>
      <div class="mt-2 prose-encyclopedia text-sand-900" set:html={data.dispute_summary.replace(/\n/g, '<br/>')} />
    </details>
  )}

  <div class="mt-4 pt-3 border-t border-sand-200">
    <h4 class="text-xs uppercase tracking-widest text-sand-700 font-semibold mb-2">Sources</h4>
    <ul class="text-sm space-y-1.5">
      {sourceEntries.map((s: any) => (
        <li class="flex gap-2">
          <span class="text-sand-500 shrink-0">{s.stance === 'supports' ? '✓' : s.stance === 'contradicts' ? '✗' : '~'}</span>
          <span>
            <a href={`/sources/${s.source.id}`} class="font-medium text-tyrian-700 hover:underline">
              {s.sourceData?.author ? `${s.sourceData.author}, ` : ''}{s.sourceData?.title}
            </a>
            {s.passage_ref && <span class="text-sand-700"> {s.passage_ref}</span>}
            <span class="text-sand-700"> — {s.passage_summary}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</article>
