---
/**
 * Chip for editorial-take confidence: how strongly the site holds its own
 * synthesis. Distinct vocabulary from the claim-confidence scale, but shares
 * the same visual chip pattern so the two read as part of the same family.
 */

interface Props {
  confidence: 'tentative' | 'moderate' | 'strong';
  size?: 'sm' | 'xs';
}
const { confidence, size = 'sm' } = Astro.props;

// Three steps of a single neutral (slate). Editorial confidence is a
// distinct vocabulary from claim confidence (attested/inferred/contested
// /legendary) and source distance — both of which use the
// colored-dot palette. The chip stays in the same graphic family but
// uses a graduated neutral to signal "this is the site's voice" rather
// than competing with the epistemic scales.
const styles: Record<
  string,
  { dot: string; border: string; bg: string; text: string; title: string }
> = {
  tentative: {
    dot: 'bg-slate-300',
    border: 'border-slate-300',
    bg: 'bg-slate-50',
    text: 'text-slate-700',
    title: 'A working position — held lightly; we would not be surprised to revise.',
  },
  moderate: {
    dot: 'bg-slate-500',
    border: 'border-slate-300',
    bg: 'bg-slate-50',
    text: 'text-slate-800',
    title: 'A position we hold with some confidence; revisable but not lightly.',
  },
  strong: {
    dot: 'bg-slate-800',
    border: 'border-slate-400',
    bg: 'bg-slate-50',
    text: 'text-slate-900',
    title: 'A position we hold with high confidence given the available evidence.',
  },
};

const s = styles[confidence];
const sizeClasses =
  size === 'xs'
    ? 'text-[9px] px-1.5 py-0 gap-1'
    : 'text-[10px] px-2 py-0.5 gap-1.5';
const dotSize = size === 'xs' ? 'w-1 h-1' : 'w-1.5 h-1.5';
---

<span
  class={`inline-flex items-center font-semibold uppercase tracking-wider rounded-full border ${s.border} ${s.bg} ${s.text} ${sizeClasses}`}
  title={s.title}
>
  <span class={`inline-block rounded-full ${dotSize} ${s.dot}`} aria-hidden="true"></span>
  <span>{confidence} confidence</span>
</span>
