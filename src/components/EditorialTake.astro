---
import EditorialConfidenceChip from './EditorialConfidenceChip.astro';
import { autolink, renderSummaryHtml, type LinkRegistry } from '../lib/autolink';

interface Props {
  take: any;
}
const { take } = Astro.props;
const data = take.data;

// Empty link registry — the component is reused in multiple contexts
// (editorial-take detail page, embedded on entity pages, embedded in
// narratives) and doesn't have a clean way to get the full registry.
// Markdown formatting (**bold**, *italic*, [text](url), ## headings)
// still works via the inline-md passes inside autolink/renderSummaryHtml;
// entity-name autolinking just gets skipped here.
const emptyRegistry: LinkRegistry = { candidates: [] };
const positionHtml = autolink(data.position, emptyRegistry);
const reasoningHtml = renderSummaryHtml(data.reasoning, emptyRegistry);
---

<aside class="border-l-4 border-tyrian-500 bg-sand-50 p-5 my-6 rounded-r-lg">
  <div class="flex items-center gap-2 mb-2 flex-wrap">
    <span class="text-[11px] uppercase tracking-widest font-bold text-tyrian-700">Editorial take</span>
    <EditorialConfidenceChip confidence={data.confidence} />
  </div>
  <p class="font-serif text-xl mt-1 mb-2">{data.subject_question}</p>
  <p class="font-serif text-lg leading-snug text-sand-900" set:html={positionHtml} />
  <details class="mt-4 text-sm">
    <summary class="cursor-pointer font-medium text-tyrian-700">Reasoning →</summary>
    <div class="mt-2 prose-encyclopedia" set:html={reasoningHtml} />
    {data.competing_positions && data.competing_positions.length > 0 && (
      <div class="mt-4">
        <p class="text-xs uppercase tracking-widest font-semibold text-sand-700">Positions considered and rejected</p>
        <ul class="mt-2 space-y-3">
          {data.competing_positions.map((cp: any) => (
            <li class="border-l-2 border-sand-300 pl-3">
              <p class="font-medium" set:html={autolink(cp.position, emptyRegistry)} />
              <p class="text-sand-700 text-sm mt-1">Why rejected: <span set:html={autolink(cp.why_rejected, emptyRegistry)} /></p>
              {cp.held_by && <p class="text-sand-700 text-xs mt-1 italic" set:html={autolink('Held by: ' + cp.held_by, emptyRegistry)} />}
            </li>
          ))}
        </ul>
      </div>
    )}
  </details>
  <p class="mt-4 text-xs text-sand-700">
    Site position · last reviewed {data.last_reviewed} · {data.open_to_revision ? 'open to revision' : 'considered settled'}
  </p>
</aside>
