---
/**
 * Data-driven battle diagram renderer.
 *
 * Reads a BattleDiagramConfig (units, arrows, annotations per phase plus
 * a shared legend and caption) and renders the SVG figure. Each battle's
 * config lives at src/data/battles/<event-slug>.ts.
 *
 * Each phase tile is a button that opens a fullscreen <dialog> showing
 * the enlarged SVG with prev/next navigation, keyboard arrow keys, and
 * tap-on-backdrop-to-close behavior.
 */
import type {
  BattleDiagramConfig,
  BattlePhase,
  BattleUnit,
} from '../lib/battleDiagram';

interface Props {
  config: BattleDiagramConfig;
  /** Stable id prefix for arrow markers and a11y titles. Usually the battle slug. */
  idPrefix: string;
}
const { config, idPrefix } = Astro.props;

function unitLabelPos(u: BattleUnit): { x: number; y: number } {
  const offset = u.labelOffset ?? 6;
  if (u.rect) {
    const cx = u.rect.x + u.rect.w / 2;
    if (u.labelPosition === 'above') {
      return { x: cx, y: u.rect.y - offset };
    }
    if (u.labelPosition === 'below') {
      return { x: cx, y: u.rect.y + u.rect.h + offset + 4 };
    }
    return { x: cx, y: u.rect.y + u.rect.h / 2 + 3 };
  }
  return { x: 0, y: 0 };
}
---

<figure class="my-8" data-battle-diagram>
  <h2 class="font-serif text-xl mb-3" style="border: none; padding: 0;">
    {config.heading}
  </h2>

  <div class={config.phases.length >= 3 ? 'grid lg:grid-cols-3 gap-4' : 'grid lg:grid-cols-2 gap-4'}>
    {config.phases.map((phase: BattlePhase, idx: number) => {
      const viewBox = phase.viewBox ?? '0 0 400 320';
      const bg = phase.background ?? '#faf7f2';
      const titleId = `${idPrefix}-phase-${idx + 1}-title`;
      const markerId = `${idPrefix}-arrow-${idx + 1}`;
      // One marker per arrow color used in this phase, so arrowheads match.
      const arrowColors = [...new Set((phase.arrows ?? []).map((a) => a.color ?? '#1a0410'))];
      const markerIdFor = (c: string) => `${markerId}-${c.replace('#', '')}`;
      // One <pattern> per (kind, color) combo used by this phase's units.
      const patternCombos = [
        ...new Map(
          phase.units
            .filter((u: BattleUnit) => u.patternFill)
            .map((u: BattleUnit) => [`${u.patternFill}|${u.fill}`, { kind: u.patternFill!, color: u.fill }])
        ).values(),
      ];
      const patternIdFor = (kind: string, color: string) =>
        `${idPrefix}-${idx + 1}-${kind}-${color.replace('#', '')}`;
      const unitFill = (u: BattleUnit) =>
        u.patternFill ? `url(#${patternIdFor(u.patternFill, u.fill)})` : u.fill;
      return (
        <button
          type="button"
          class="phase-tile group block w-full text-left border border-sand-300 rounded-lg bg-sand-50 p-4 hover:bg-[#faf6ec] hover:border-tyrian-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-tyrian-700 active:bg-purple-100 transition-colors cursor-zoom-in"
          data-phase-index={idx}
          aria-label={`Open enlarged view of ${phase.label}`}
        >
          <div class="flex items-center justify-between mb-2">
            <span class="flex items-center gap-1.5 text-[11px] uppercase tracking-widest font-bold text-sand-700" data-phase-label>
              {phase.description && (
                <span class="inline-flex items-center justify-center w-[18px] h-[18px] rounded-full bg-ink-900 text-white text-[10px] font-bold tracking-normal shrink-0" style="background:#111111" aria-hidden="true">{idx + 1}</span>
              )}
              {phase.label}
            </span>
            <span class="text-[10px] text-sand-600 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity shrink-0">tap to enlarge ⤢</span>
          </div>
          {phase.description && (
            <p class="text-[11.5px] leading-snug text-sand-800 mb-2.5" data-phase-desc>{phase.description}</p>
          )}
          <svg viewBox={viewBox} xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-labelledby={titleId}>
            <title id={titleId}>{phase.title}</title>
            <defs>
              <marker id={markerId} markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
                <path d="M0,0 L0,6 L9,3 z" fill="#1a0410"/>
              </marker>
              {arrowColors.map((c) => (
                <marker id={markerIdFor(c)} markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
                  <path d="M0,0 L0,6 L9,3 z" fill={c}/>
                </marker>
              ))}
              {patternCombos.map((pc) =>
                pc.kind === 'hatch' ? (
                  <pattern id={patternIdFor(pc.kind, pc.color)} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <rect width="5" height="5" fill="#fdfbf4"/>
                    <line x1="0" y1="0" x2="0" y2="5" stroke={pc.color} stroke-width="2.2"/>
                  </pattern>
                ) : (
                  <pattern id={patternIdFor(pc.kind, pc.color)} width="6" height="6" patternUnits="userSpaceOnUse">
                    <rect width="6" height="6" fill="#fdfbf4"/>
                    <circle cx="3" cy="3" r="1.4" fill={pc.color}/>
                  </pattern>
                )
              )}
            </defs>
            <rect x="0" y="0" width="400" height="320" fill={bg}/>
            {phase.northArrow && (
              <g transform="translate(20, 25)">
                <line x1="0" y1="10" x2="0" y2="-8" stroke="#6b5638" stroke-width="1.5"/>
                <polygon points="0,-12 -4,-4 4,-4" fill="#6b5638"/>
                <text x="6" y="2" font-size="9" fill="#6b5638">N</text>
              </g>
            )}
            {(phase.rivers ?? []).map((r) => (
              <>
                <path d={r.path} stroke={r.color ?? '#7dd3fc'} stroke-width={r.width ?? 2} fill="none" opacity={r.opacity ?? 0.7}/>
                {r.label && (
                  <text x={r.labelX ?? 200} y={r.labelY ?? 32} text-anchor="middle" font-size="9" fill="#0369a1" font-style="italic">{r.label}</text>
                )}
              </>
            ))}
            {phase.units.map((u) => {
              const labelPos = unitLabelPos(u);
              const labelColor = u.labelColor ?? (u.labelPosition === 'inside' || u.labelPosition === 'center' ? '#fff' : '#1a0410');
              const labelSize = u.labelSize ?? 9;
              return (
                <>
                  {u.rect && (
                    <rect
                      x={u.rect.x}
                      y={u.rect.y}
                      width={u.rect.w}
                      height={u.rect.h}
                      rx={u.rect.rx}
                      fill={unitFill(u)}
                      stroke={u.stroke ?? '#1a0410'}
                      stroke-width={u.strokeWidth ?? 1}
                      stroke-dasharray={u.strokeDasharray}
                      opacity={u.opacity}
                    />
                  )}
                  {u.path && (
                    <path
                      d={u.path}
                      fill={unitFill(u)}
                      stroke={u.stroke ?? '#1a0410'}
                      stroke-width={u.strokeWidth ?? 1}
                      stroke-dasharray={u.strokeDasharray}
                      opacity={u.opacity}
                    />
                  )}
                  {u.label && u.rect && (
                    <text
                      x={labelPos.x}
                      y={labelPos.y}
                      text-anchor="middle"
                      font-size={labelSize}
                      fill={labelColor}
                      font-weight={u.labelWeight}
                      font-style={u.labelItalic ? 'italic' : undefined}
                    >{u.label}</text>
                  )}
                  {u.sublabel && u.rect && (
                    <text
                      x={u.rect.x + u.rect.w / 2}
                      y={u.rect.y + u.rect.h + (u.labelOffset ?? 6) + (u.labelSize ?? 9) + 6}
                      text-anchor="middle"
                      font-size={u.sublabelSize ?? 7}
                      fill={u.sublabelColor ?? u.labelColor ?? '#1a0410'}
                      font-style={u.sublabelItalic ? 'italic' : undefined}
                    >{u.sublabel}</text>
                  )}
                </>
              );
            })}
            {(phase.arrows ?? []).map((a) => (
              <path
                d={
                  a.via
                    ? `M ${a.from[0]} ${a.from[1]} Q ${a.via[0]} ${a.via[1]} ${a.to[0]} ${a.to[1]}`
                    : `M ${a.from[0]} ${a.from[1]} L ${a.to[0]} ${a.to[1]}`
                }
                stroke={a.color ?? '#1a0410'}
                stroke-width={a.width ?? 2.5}
                stroke-dasharray={a.dasharray}
                fill="none"
                marker-end={`url(#${markerIdFor(a.color ?? '#1a0410')})`}
              />
            ))}
            {(phase.annotations ?? []).map((an) => (
              <text
                x={an.x}
                y={an.y}
                text-anchor={an.anchor ?? 'middle'}
                font-size={an.size ?? 9}
                fill={an.color ?? '#1a0410'}
                font-style={an.italic ? 'italic' : undefined}
                font-weight={an.weight}
              >{an.text}</text>
            ))}
          </svg>
        </button>
      );
    })}
  </div>

  <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-sand-700">
    {config.legend.map((l, li) => (
      <span class="flex items-center gap-1.5">
        {l.pattern ? (
          <svg width="12" height="12" class="shrink-0" aria-hidden="true">
            <defs>
              {l.pattern === 'hatch' ? (
                <pattern id={`${idPrefix}-leg-${li}`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <rect width="5" height="5" fill="#fdfbf4"/>
                  <line x1="0" y1="0" x2="0" y2="5" stroke={l.fill} stroke-width="2.2"/>
                </pattern>
              ) : (
                <pattern id={`${idPrefix}-leg-${li}`} width="6" height="6" patternUnits="userSpaceOnUse">
                  <rect width="6" height="6" fill="#fdfbf4"/>
                  <circle cx="3" cy="3" r="1.4" fill={l.fill}/>
                </pattern>
              )}
            </defs>
            <rect width="12" height="12" fill={`url(#${idPrefix}-leg-${li})`} stroke={l.stroke ?? '#1a0410'} stroke-width="1"/>
          </svg>
        ) : (
          <span class="inline-block w-3 h-3" style={`background:${l.fill};border:1px solid ${l.stroke ?? '#1a0410'};`}></span>
        )}
        {l.label}
      </span>
    ))}
  </div>

  <figcaption class="mt-3 text-xs text-sand-700 italic">{config.caption}</figcaption>

  <dialog data-battle-dialog class="battle-dialog">
    <div class="battle-dialog-inner">
      <header class="battle-dialog-header">
        <div>
          <p class="text-[11px] uppercase tracking-widest font-bold text-sand-700" data-dialog-label></p>
          <p class="text-xs text-sand-800 mt-1 max-w-2xl" data-dialog-desc></p>
          <p class="text-xs text-sand-600 mt-0.5">
            <span data-dialog-current>1</span> / {config.phases.length}
          </p>
        </div>
        <button type="button" class="battle-dialog-close" data-dialog-close aria-label="Close enlarged view">×</button>
      </header>
      <div class="battle-dialog-svg" data-dialog-svg></div>
      <footer class="battle-dialog-footer">
        <button type="button" class="battle-dialog-nav" data-dialog-prev aria-label="Previous phase">‹ Previous</button>
        <button type="button" class="battle-dialog-nav" data-dialog-next aria-label="Next phase">Next ›</button>
      </footer>
    </div>
  </dialog>
</figure>

<style>
  .battle-dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(96vw, 1200px);
    width: 96vw;
    max-height: 96vh;
  }
  .battle-dialog::backdrop {
    background: rgba(17, 17, 17, 0.85);
    backdrop-filter: blur(2px);
  }
  .battle-dialog-inner {
    background: #f4f0e6;
    border-radius: 0.75rem;
    border: 1px solid #d6cdb5;
    padding: 1rem 1.25rem 1.25rem;
    max-height: 96vh;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .battle-dialog-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .battle-dialog-close {
    background: transparent;
    border: 1px solid transparent;
    font-size: 1.75rem;
    line-height: 1;
    padding: 0.125rem 0.625rem;
    border-radius: 0.375rem;
    color: #5b0f31;
    cursor: pointer;
  }
  .battle-dialog-close:hover,
  .battle-dialog-close:focus-visible {
    background: #faf6ec;
    border-color: #5b0f31;
    outline: none;
  }
  .battle-dialog-svg {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: auto;
  }
  .battle-dialog-svg svg {
    width: 100%;
    height: auto;
    max-height: 78vh;
    display: block;
  }
  .battle-dialog-footer {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid #d6cdb5;
  }
  .battle-dialog-nav {
    background: transparent;
    border: 1px solid #d6cdb5;
    border-radius: 0.375rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    color: #5b0f31;
    cursor: pointer;
  }
  .battle-dialog-nav:hover:not(:disabled),
  .battle-dialog-nav:focus-visible:not(:disabled) {
    background: #faf6ec;
    border-color: #5b0f31;
    outline: none;
  }
  .battle-dialog-nav:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
</style>

<script>
  function wireBattleDiagram(fig: HTMLElement) {
    const dialog = fig.querySelector('[data-battle-dialog]') as HTMLDialogElement | null;
    if (!dialog) return;
    const svgHost = fig.querySelector('[data-dialog-svg]') as HTMLElement;
    const labelEl = fig.querySelector('[data-dialog-label]') as HTMLElement;
    const descEl = fig.querySelector('[data-dialog-desc]') as HTMLElement;
    const currentEl = fig.querySelector('[data-dialog-current]') as HTMLElement;
    const prevBtn = fig.querySelector('[data-dialog-prev]') as HTMLButtonElement;
    const nextBtn = fig.querySelector('[data-dialog-next]') as HTMLButtonElement;
    const closeBtn = fig.querySelector('[data-dialog-close]') as HTMLButtonElement;
    const tiles = Array.from(fig.querySelectorAll('[data-phase-index]')) as HTMLElement[];
    let current = 0;

    function show(idx: number) {
      if (idx < 0 || idx >= tiles.length) return;
      current = idx;
      const tile = tiles[idx];
      const sourceSvg = tile.querySelector('svg');
      if (!sourceSvg) return;
      const clone = sourceSvg.cloneNode(true) as SVGSVGElement;
      clone.removeAttribute('class');
      svgHost.replaceChildren(clone);
      const labelText = tile.querySelector('[data-phase-label]')?.textContent ?? '';
      labelEl.textContent = labelText.replace(/\s+/g, ' ').trim();
      if (descEl) descEl.textContent = tile.querySelector('[data-phase-desc]')?.textContent ?? '';
      currentEl.textContent = String(idx + 1);
      prevBtn.disabled = idx === 0;
      nextBtn.disabled = idx === tiles.length - 1;
    }

    tiles.forEach((tile) => {
      tile.addEventListener('click', () => {
        show(parseInt(tile.dataset.phaseIndex || '0', 10));
        if (!dialog.open) dialog.showModal();
      });
    });

    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    closeBtn.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(current - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(current + 1);
      }
    });

    // Touch swipe
    let touchStartX = 0;
    let touchStartY = 0;
    dialog.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) show(current + 1);
        else show(current - 1);
      }
    }, { passive: true });
  }

  document.querySelectorAll<HTMLElement>('[data-battle-diagram]').forEach(wireBattleDiagram);
</script>
