---
/**
 * Reusable infobox panel for entity detail pages.
 *
 * Top-of-article on mobile, right-rail (sticky) on lg+ screens.
 * Each row of the rows array has the same shape regardless of entity type.
 *
 * Empty values render as "unknown" in muted style — by design, so missing
 * data reads as a deliberate gap rather than an absent row. Keeps boxes of
 * the same entity type visually identical.
 */

export type InfoboxRow = {
  label: string;
  /**
   * The value. Falsy/empty values render as the empty-state label
   * (default "unknown" — override per-row via emptyLabel).
   * - string | number: rendered as text (or as a link if href is given)
   * - InfoboxLink[]: rendered as a comma-separated list of links
   */
  value?: string | number | null | InfoboxLink[];
  /** Optional href for a single-value text row. Ignored if value is a list. */
  href?: string;
  /** Italic qualifier appended after the value, e.g. "legendary", "c.", "approximate". */
  qualifier?: string;
  /**
   * Override the default "unknown" label for empty values. Use "none" for
   * count-style rows ("Claims: none" rather than "Claims: unknown").
   */
  emptyLabel?: string;
};

export type InfoboxLink = {
  text: string;
  href?: string;
};

interface Props {
  title: string;
  subtitle?: string;
  rows: InfoboxRow[];
  /**
   * Disable the component's own sticky-right-rail and grid-placement
   * classes. Use when the Infobox is being placed inside an outer
   * wrapper that already handles sticky positioning (e.g. when
   * stacked with a ContentToc).
   */
  nonSticky?: boolean;
}

const { title, subtitle, rows, nonSticky = false } = Astro.props;
const wrapperClass = nonSticky
  ? 'mb-4 lg:mb-0'
  : 'mb-4 lg:mb-0 lg:col-start-2 lg:row-start-1 lg:sticky lg:top-6 self-start';

const isEmpty = (v: InfoboxRow['value']) =>
  v === undefined ||
  v === null ||
  v === '' ||
  (Array.isArray(v) && v.length === 0);
---

<aside
  class={wrapperClass}
  aria-label={`Quick facts about ${title}`}
>
  <details class="border-2 border-tyrian-700 rounded-lg bg-sand-100" open>
    <summary class="cursor-pointer lg:cursor-default list-none px-3 py-2 lg:p-4 lg:pb-3 lg:border-b lg:border-tyrian-700 flex items-center justify-between gap-2">
      <div class="min-w-0">
        <div class="eyebrow">Quick facts</div>
        <div class="font-serif text-base lg:text-lg text-ink-900 leading-tight mt-1">{title}</div>
        {subtitle && <div class="text-[11px] lg:text-xs text-sand-700 italic mt-1">{subtitle}</div>}
      </div>
      <span class="qh-infobox-arrow lg:hidden text-sand-700 text-xs shrink-0">▾</span>
    </summary>
    <dl class="space-y-3 px-3 pb-3 lg:px-4 lg:pb-4 lg:pt-3 text-sm">
      {rows.map((row) => (
        <div>
          <dt class="text-[10px] uppercase tracking-widest font-semibold text-sand-700">{row.label}</dt>
          <dd class="text-ink-900 leading-snug mt-1">
            {isEmpty(row.value) ? (
              <span class="text-sand-700 italic">{row.emptyLabel ?? 'unknown'}</span>
            ) : Array.isArray(row.value) ? (
              <span>
                {(row.value as InfoboxLink[]).map((link, i) => (
                  <>
                    {i > 0 && <span class="text-sand-700">, </span>}
                    {link.href ? (
                      <a href={link.href} class="text-tyrian-700 hover:underline">{link.text}</a>
                    ) : (
                      <span>{link.text}</span>
                    )}
                  </>
                ))}
              </span>
            ) : row.href ? (
              <a href={row.href} class="text-tyrian-700 hover:underline">{row.value}</a>
            ) : (
              <span>{row.value}</span>
            )}
            {row.qualifier && !isEmpty(row.value) && (
              <span class="text-sand-700 italic"> ({row.qualifier})</span>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </details>
</aside>

<style is:global>
  /* Rotate the disclosure caret when expanded. */
  aside[aria-label^='Quick facts'] details[open] > summary > .qh-infobox-arrow {
    display: inline-block;
    transform: rotate(180deg);
  }
  /* On lg+, the infobox is always expanded — disable the toggle. */
  @media (min-width: 1024px) {
    aside[aria-label^='Quick facts'] details > summary { pointer-events: none; }
  }
  /* Suppress default disclosure marker across browsers. */
  aside[aria-label^='Quick facts'] details > summary::-webkit-details-marker { display: none; }
  aside[aria-label^='Quick facts'] details > summary::marker { display: none; }
</style>
