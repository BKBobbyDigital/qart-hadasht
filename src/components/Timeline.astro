---
import { getCollection, getEntry } from 'astro:content';

interface Props {
  startYear?: number;
  endYear?: number;
}

const { startYear = -820, endYear = -140 } = Astro.props;

// Curated keystone events — the structural high points only.
// Same intuition as the homepage "Start here" chips: this is a map,
// not the territory. /events has the full data.
const keystoneSlugs = [
  'founding-of-carthage',
  'founding-of-ebusus',
  'battle-of-alalia',
  'first-treaty-with-rome',
  'battle-of-himera',
  'battle-of-crimisus',
  'first-punic-war-outbreak',
  'crossing-of-the-alps',
  'battle-of-cannae',
  'battle-of-zama',
  'destruction-of-carthage',
];

const keystones = (
  await Promise.all(
    keystoneSlugs.map(async (slug) => {
      const e: any = await getEntry('events', slug);
      if (!e) return null;
      return {
        id: slug,
        name: e.data.name,
        year: e.data.date_start.value,
        type: e.data.type,
      };
    })
  )
)
  .filter(Boolean)
  .sort((a: any, b: any) => a.year - b.year) as Array<{ id: string; name: string; year: number; type: string }>;

const allEvents = await getCollection('events');
const wars = allEvents
  .filter((e) => e.data.type === 'war' && e.data.date_end)
  .map((e) => ({
    id: e.id,
    name: e.data.name,
    start: e.data.date_start.value,
    end: e.data.date_end!.value,
  }))
  .sort((a, b) => a.start - b.start);

const allPeriods = (await getCollection('periods')).sort(
  (a: any, b: any) => a.data.start_year - b.data.start_year
);

// Year → percentage along the timeline
const totalSpan = endYear - startYear;
const xPct = (year: number) => ((year - startYear) / totalSpan) * 100;

// Tick marks every century
const ticks: number[] = [];
for (let y = Math.ceil(startYear / 100) * 100; y <= endYear; y += 100) {
  ticks.push(y);
}

// War lanes — stagger overlapping wars
type War = typeof wars[number];
const warLanes: War[][] = [];
for (const war of wars) {
  let placed = false;
  for (const lane of warLanes) {
    if (lane.every((existing) => existing.end < war.start || existing.start > war.end)) {
      lane.push(war);
      placed = true;
      break;
    }
  }
  if (!placed) warLanes.push([war]);
}

// Keystone label lanes — alternate above/below to reduce overlap
// for events that cluster (the Hannibalic period particularly).
// Greedy: assign lane based on min spacing in same lane.
const keystoneLaneSpacingYears = 35;
type KeystoneLaned = typeof keystones[number] & { lane: number };
const keystoneLanesLastX: number[] = [];
const keystonesLaned: KeystoneLaned[] = keystones.map((k) => {
  let lane = -1;
  for (let i = 0; i < keystoneLanesLastX.length; i++) {
    if (k.year - keystoneLanesLastX[i] >= keystoneLaneSpacingYears) {
      lane = i;
      break;
    }
  }
  if (lane === -1) {
    lane = keystoneLanesLastX.length;
    keystoneLanesLastX.push(k.year);
  } else {
    keystoneLanesLastX[lane] = k.year;
  }
  return { ...k, lane };
});
const keystoneLaneCount = Math.max(1, keystoneLanesLastX.length);

// Layout dimensions
const keystoneLaneHeight = 22;
const keystoneAreaHeight = keystoneLaneCount * keystoneLaneHeight + 14;
const dotRowHeight = 16;        // the line of dots itself
const warLaneHeight = 22;
const warAreaHeight = warLanes.length * warLaneHeight + 4;
const periodStripHeight = 22;
const tickHeight = 24;
const containerHeight =
  keystoneAreaHeight + dotRowHeight + warAreaHeight + periodStripHeight + tickHeight;

// Where the central "spine" of the timeline sits — between keystone labels
// (above) and war bands (below)
const spineFromBottom = tickHeight + periodStripHeight + warAreaHeight + dotRowHeight / 2;

// Period color palette
const periodColors = ['#f4ede0', '#e8dcc4'];
---

<figure class="my-8">
  <div class="border border-sand-300 rounded-lg bg-sand-50 p-3 sm:p-4 overflow-x-auto">
    <div class="relative" style={`height: ${containerHeight}px; min-width: 760px;`}>

      <!-- Period strip across the bottom -->
      {allPeriods
        .filter((p: any) => Math.min(p.data.end_year, endYear) > Math.max(p.data.start_year, startYear))
        .map((p: any, i: number) => {
          const start = Math.max(p.data.start_year, startYear);
          const end = Math.min(p.data.end_year, endYear);
          const left = xPct(start);
          const width = xPct(end) - left;
          const slug = p.id.replace(/\.md$/, '');
          // Compress long titles for the band label
          const label = p.data.title
            .replace(/^The /, '')
            .replace(/and early /i, '/early ')
            .replace(/and the /, ' & ');
          return (
            <a
              href={`/periods/${slug}`}
              class="absolute flex items-center justify-center text-[10px] uppercase tracking-wider font-medium text-sand-700 hover:text-tyrian-700 transition-colors truncate px-1"
              style={`
                left: ${left}%;
                width: ${width}%;
                bottom: ${tickHeight}px;
                height: ${periodStripHeight}px;
                background-color: ${periodColors[i % 2]};
                border-left: 1px solid #d4bc94;
              `}
              title={`${p.data.title} (${Math.abs(p.data.start_year)}–${Math.abs(p.data.end_year)} BCE)`}
            >
              <span class="truncate">{label}</span>
            </a>
          );
        })}

      <!-- War bands above the period strip -->
      {warLanes.map((lane, laneIdx) =>
        lane.map((war) => {
          const left = xPct(war.start);
          const width = xPct(war.end) - left;
          const bottom = tickHeight + periodStripHeight + 4 + laneIdx * warLaneHeight;
          const display = war.name
            .replace(/^The /, '')
            .replace(/Punic War/, 'Punic')
            .replace(/Sicilian War/, 'Sicilian');
          return (
            <a
              href={`/events/${war.id}`}
              class="absolute border border-tyrian-400 bg-tyrian-100 hover:bg-tyrian-200 rounded text-[11px] flex items-center px-2 truncate transition-colors font-serif text-tyrian-900"
              style={`
                left: ${left}%;
                width: ${width}%;
                bottom: ${bottom}px;
                height: ${warLaneHeight - 4}px;
                min-width: 18px;
              `}
              title={`${war.name} (${Math.abs(war.start)}–${Math.abs(war.end)} BCE)`}
            >
              <span class="truncate">{display}</span>
            </a>
          );
        })
      )}

      <!-- The horizontal spine -->
      <div
        class="absolute left-0 right-0 h-px bg-sand-700"
        style={`bottom: ${spineFromBottom}px;`}
      ></div>

      <!-- Keystone event dots on the spine + labels above with connector lines -->
      {keystonesLaned.map((k) => {
        const dotBottom = spineFromBottom - 5;       // 10px diameter dot centered on spine
        const labelBottom = spineFromBottom + 8 + (keystoneLaneCount - 1 - k.lane) * keystoneLaneHeight;
        const connectorHeight = labelBottom - (spineFromBottom + 5);
        return (
          <a
            href={`/events/${k.id}`}
            class="absolute group"
            style={`left: ${xPct(k.year)}%; bottom: 0; width: 0; height: 0;`}
            title={`${k.name} (${Math.abs(k.year)} BCE)`}
          >
            <div
              class="absolute rounded-full bg-tyrian-700 border-2 border-sand-50 -translate-x-1/2 group-hover:scale-125 transition-transform"
              style={`bottom: ${dotBottom}px; width: 10px; height: 10px;`}
            ></div>
            <div
              class="absolute w-px bg-sand-400 -translate-x-1/2"
              style={`bottom: ${spineFromBottom + 5}px; height: ${connectorHeight}px;`}
            ></div>
            <div
              class="absolute -translate-x-1/2 text-[11px] font-serif text-tyrian-700 group-hover:text-tyrian-900 whitespace-nowrap"
              style={`bottom: ${labelBottom}px;`}
            >
              <span class="font-medium">{k.name.replace(/^Battle of /, '').replace(/^Founding of /, '').replace(/^The /, '')}</span>
              <span class="text-sand-700 ml-1 tabular-nums">{Math.abs(k.year)}</span>
            </div>
          </a>
        );
      })}

      <!-- Tick marks (year axis at bottom) -->
      {ticks.map((year) => (
        <div
          class="absolute flex flex-col items-center -translate-x-1/2"
          style={`left: ${xPct(year)}%; bottom: 0;`}
        >
          <div class="w-px h-2 bg-sand-700 mb-1"></div>
          <div class="text-[10px] text-sand-700 tabular-nums">{Math.abs(year)} BCE</div>
        </div>
      ))}
    </div>
  </div>
  <figcaption class="mt-2 text-xs text-sand-700 italic">
    A structural overview: periods at the bottom, wars as bands above them, and
    {' '}{keystones.length} keystone events labeled on the central spine. For the
    full event list see <a href="/events" class="text-tyrian-700 hover:underline not-italic">all events</a>.
  </figcaption>
</figure>
