---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { thingSchema } from '../../lib/structuredData';
import { stripMarkdownForMeta } from '../../lib/autolink';
import Infobox, { type InfoboxRow } from '../../components/Infobox.astro';
import Bibliography from '../../components/Bibliography.astro';
import MaterialEvidence from '../../components/MaterialEvidence.astro';
import { formatHistoricalDate, formatDateRange, dateQualifier } from '../../lib/historicalDate';
import { autolink, buildLinkRegistry, renderSummaryHtml } from '../../lib/autolink';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const institutions = await getCollection('institutions');
  return institutions.map((i) => ({
    params: { slug: i.id },
    props: { institution: i },
  }));
}

const { institution } = Astro.props;
const d = institution.data;

const fmtDate = (date: any) => {
  if (!date) return null;
  const year = Math.abs(date.value);
  const era = date.value < 0 ? 'BCE' : 'CE';
  return `${date.circa ? 'c. ' : ''}${year} ${era}`;
};

// Curated principal source IDs (from frontmatter)
const principalSourceIds = (d.principal_sources ?? []).map((s: any) => s.id);

// Reverse lookup: claims that reference this institution
const allClaims = await getCollection('claims');
const referencingClaims = allClaims.filter((c) =>
  (c.data.entities ?? []).some((e: any) => e.type === 'institution' && e.slug === institution.id)
);

// Material evidence: artifacts co-referenced with this institution in
// any of the referencing claims.
const allArtifacts = await getCollection('artifacts');
const artifactSlugs = new Set<string>();
for (const c of referencingClaims) {
  for (const e of (c.data.entities ?? []) as any[]) {
    if (e.type === 'artifact') artifactSlugs.add(e.slug);
  }
}
const materialEvidence = allArtifacts.filter((a) => artifactSlugs.has(a.id));

// Reverse lookup: events that reference this institution
const allEvents = await getCollection('events');
const referencingEvents = allEvents
  .filter((e) =>
    (e.data.referenced_institutions ?? []).some((ref: any) => ref.id === institution.id)
  )
  .sort((a, b) => a.data.date_start.value - b.data.date_start.value);

// Reverse lookup: narratives whose primary_entities include this institution
const allNarratives = await getCollection('narratives');
const referencingNarratives = allNarratives.filter((n: any) =>
  (n.data.primary_entities ?? []).some((e: any) => e.type === 'institution' && e.slug === institution.id)
);

// Reverse lookup: people who reference this institution
const allPeople = await getCollection('people');
const referencingPeople = allPeople
  .filter((p) =>
    (p.data.referenced_institutions ?? []).some((ref: any) => ref.id === institution.id)
  )
  .sort((a, b) => a.data.name_display.localeCompare(b.data.name_display));

// Auto-link registry
const allPlaces = await getCollection('places');
const allInstitutions = await getCollection('institutions');
const allGroups = await getCollection('groups');
const allThemes = await getCollection('themes');
const allDeities = await getCollection('deities');
const linkRegistry = buildLinkRegistry({
  events: allEvents,
  people: allPeople,
  places: allPlaces,
  institutions: allInstitutions,
  groups: allGroups,
  themes: allThemes,
  deities: allDeities,
  artifacts: allArtifacts,
});

const typeLabel = d.type.charAt(0).toUpperCase() + d.type.slice(1);
const activeText = formatDateRange(d.active_from, d.active_to);
const activeQual = dateQualifier(d.active_from);

const institutionInfoboxRows: InfoboxRow[] = [
  { label: 'Type', value: typeLabel },
  { label: 'Polity', value: d.polity ?? null },
  { label: 'Active', value: activeText, qualifier: activeQual },
  {
    label: 'Referenced in',
    value: referencingEvents.length > 0
      ? `${referencingEvents.length} event${referencingEvents.length === 1 ? '' : 's'}`
      : null,
    href: referencingEvents.length > 0 ? '#events' : undefined,
    emptyLabel: 'none',
  },
  {
    label: 'Associated people',
    value: referencingPeople.length > 0 ? `${referencingPeople.length}` : null,
    href: referencingPeople.length > 0 ? '#people' : undefined,
    emptyLabel: 'none',
  },
];
---

<BaseLayout title={d.name_display} description={stripMarkdownForMeta(d.summary)} jsonld={thingSchema(d, { description: stripMarkdownForMeta(d.summary) })}>
  <div class="max-w-5xl mx-auto px-6 py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-10 lg:items-start">
    <Infobox
      title={d.name_display}
      subtitle={`${typeLabel}${d.polity ? ` · ${d.polity}` : ''}`}
      rows={institutionInfoboxRows}
    />
    <article class="lg:col-start-1 lg:row-start-1 min-w-0">
      <span hidden data-pagefind-filter="type:Institutions" data-pagefind-meta="type:Institution"></span>
    <p class="eyebrow mb-3">Institution · {d.type}</p>
    <h1 class="font-serif text-4xl sm:text-5xl mb-3">{d.name_display}</h1>
    <p class="text-sand-700">
      {d.polity}
      {(d.active_from || d.active_to) && (
        <>
          {' · '}
          {d.active_from && <>active {fmtDate(d.active_from)}</>}
          {d.active_from && d.active_to && <> to </>}
          {d.active_to && <>{fmtDate(d.active_to)}</>}
        </>
      )}
    </p>

    {(d.name_punic || d.name_greek || d.name_latin) && (
      <section class="mt-8 border border-sand-300 rounded-lg p-5 bg-white/60">
        <h2 class="font-serif text-xl mb-3">Names</h2>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
          {d.name_punic && (<><dt class="font-semibold text-sand-700">Punic</dt><dd>{d.name_punic} {d.name_punic_script && <span class="font-phoenician text-tyrian-700 ml-2">{d.name_punic_script}</span>}</dd></>)}
          {d.name_greek && (<><dt class="font-semibold text-sand-700">Greek</dt><dd>{d.name_greek}</dd></>)}
          {d.name_latin && (<><dt class="font-semibold text-sand-700">Latin</dt><dd>{d.name_latin}</dd></>)}
        </dl>
      </section>
    )}

    <div class="prose-encyclopedia mt-8 text-lg text-sand-900">
      <div set:html={renderSummaryHtml(d.summary, linkRegistry, { excludeKey: `institution:${institution.id}` })} />
    </div>

    {referencingEvents.length > 0 && (
      <section class="mt-12 pt-6 border-t border-sand-300" id="events">
        <h2 class="font-serif text-2xl mb-3">Referenced in events</h2>
        <ul class="space-y-2">
          {referencingEvents.map((e) => (
            <li class="flex items-baseline gap-3">
              <span class="text-sm text-sand-700 shrink-0 tabular-nums">
                {Math.abs(e.data.date_start.value)} BCE
              </span>
              <a href={`/events/${e.id}`} class="text-tyrian-700 hover:underline font-serif">
                {e.data.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {referencingPeople.length > 0 && (
      <section class="mt-12 pt-6 border-t border-sand-300" id="people">
        <h2 class="font-serif text-2xl mb-3">Associated people</h2>
        <ul class="space-y-2">
          {referencingPeople.map((p) => (
            <li>
              <a href={`/people/${p.id}`} class="text-tyrian-700 hover:underline font-serif">
                {p.data.name_display}
              </a>
              {p.data.polity && <span class="text-xs text-sand-700 ml-2">{p.data.polity}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <MaterialEvidence artifacts={materialEvidence} />

    {referencingNarratives.length > 0 && (
      <section class="mt-12 pt-6 border-t border-sand-300" id="narratives">
        <h2 class="font-serif text-2xl mb-3">Narratives</h2>
        <ul class="space-y-3">
          {referencingNarratives.map((n: any) => (
            <li>
              <a href={`/narratives/${n.id.replace(/\.md$/, '')}`} class="block p-3 border border-sand-300 rounded-lg hover:bg-sand-100 hover:border-tyrian-500 transition-colors">
                <p class="font-serif text-lg text-tyrian-700 leading-snug">{n.data.title}</p>
                <p class="text-sm text-sand-900 mt-1">{n.data.thesis.slice(0, 240)}{n.data.thesis.length > 240 ? '…' : ''}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <Bibliography claims={referencingClaims} principalSourceIds={principalSourceIds} />
    </article>
  </div>
</BaseLayout>
