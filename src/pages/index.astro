---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

// ─── Curated "Start here" chips ──────────────────────────────────────────────
//
// A mix of events, people, and places — the most-iconic entry points into
// the Carthaginian story. Resolves to live entity data so titles and dates
// stay accurate as content evolves.
type ChipKind = 'event' | 'person' | 'place';
type StartHereSpec = { kind: ChipKind; slug: string };

const startHereSpecs: StartHereSpec[] = [
  { kind: 'person', slug: 'hannibal-barca' },
  { kind: 'event', slug: 'founding-of-carthage' },
  { kind: 'event', slug: 'crossing-of-the-alps' },
  { kind: 'event', slug: 'battle-of-cannae' },
  { kind: 'event', slug: 'battle-of-zama' },
  { kind: 'event', slug: 'destruction-of-carthage' },
  { kind: 'person', slug: 'dido' },
  { kind: 'person', slug: 'scipio-africanus' },
  { kind: 'place', slug: 'carthage' },
  { kind: 'person', slug: 'cato-the-elder' },
];

type Chip = { kind: ChipKind; href: string; label: string; date: string };

const startHereChips: Chip[] = await Promise.all(
  startHereSpecs.map(async (s): Promise<Chip | null> => {
    if (s.kind === 'event') {
      const e: any = await getEntry('events', s.slug);
      if (!e) return null;
      const d = e.data;
      const date = d.date_start.precision === 'legendary'
        ? `legendary ${Math.abs(d.date_start.value)} BCE`
        : (d.date_end
            ? `${Math.abs(d.date_start.value)}–${Math.abs(d.date_end.value)} BCE`
            : `${Math.abs(d.date_start.value)} BCE`);
      return { kind: 'event', href: `/events/${s.slug}`, label: d.name, date };
    }
    if (s.kind === 'person') {
      const p: any = await getEntry('people', s.slug);
      if (!p) return null;
      const d = p.data;
      let date = '';
      if (d.birth?.precision === 'legendary' || d.death?.precision === 'legendary') {
        date = 'legendary';
      } else if (d.birth && d.death) {
        date = `${Math.abs(d.birth.value)}–${Math.abs(d.death.value)} BCE`;
      } else if (d.death) {
        date = `d. ${Math.abs(d.death.value)} BCE`;
      } else if (d.birth) {
        date = `b. ${Math.abs(d.birth.value)} BCE`;
      } else if (d.floruit) {
        date = `fl. ${Math.abs(d.floruit.value)} BCE`;
      }
      return { kind: 'person', href: `/people/${s.slug}`, label: d.name_display, date };
    }
    // place
    const pl: any = await getEntry('places', s.slug);
    if (!pl) return null;
    return { kind: 'place', href: `/places/${s.slug}`, label: pl.data.name_display, date: pl.data.modern_location ? `today: ${pl.data.modern_location}` : '' };
  })
).then((arr) => arr.filter(Boolean) as Chip[]);

const kindStyle: Record<ChipKind, string> = {
  event: 'border-amber-300 bg-amber-50 hover:bg-amber-100',
  person: 'border-tyrian-300 bg-tyrian-50 hover:bg-tyrian-100',
  place: 'border-emerald-300 bg-emerald-50 hover:bg-emerald-100',
};
const kindLabel: Record<ChipKind, string> = {
  event: 'event',
  person: 'person',
  place: 'place',
};

// ─── Featured threads ────────────────────────────────────────────────────────
//
// Curated reading paths the homepage surfaces. Hand-picked for variety of
// scope and to showcase what threads do that index pages don't.
const featuredThreadSlugs = [
  'hannibals-life',
  'road-to-146',
  'why-cannae-didnt-end-the-war',
  'the-tophet-question',
];
const featuredThreads = await Promise.all(
  featuredThreadSlugs.map(async (slug) => {
    const t: any = await getEntry('threads', slug);
    return t;
  })
).then((arr) => arr.filter(Boolean));

const scopeColors: Record<string, string> = {
  biography: 'border-tyrian-300 bg-tyrian-50',
  question: 'border-amber-300 bg-amber-50',
  debate: 'border-rose-300 bg-rose-50',
  period: 'border-sand-300 bg-sand-50',
  theatre: 'border-emerald-300 bg-emerald-50',
};
---

<BaseLayout title="Qart-Hadasht">
  <section class="bg-sand-100 border-b border-tyrian-700">
    <div class="max-w-5xl mx-auto px-5 sm:px-6 py-12 sm:py-20">
      <p class="eyebrow mb-4">An encyclopedia of ancient Carthage</p>
      <p class="font-phoenician text-4xl sm:text-5xl text-tyrian-700 mb-4 leading-none">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
      <h1 class="font-serif text-5xl sm:text-7xl text-ink-900 leading-none">Qart-Hadasht</h1>
      <p class="text-sand-700 mt-4 text-lg sm:text-xl font-serif italic">
        <em>kart-ha-DASHT</em> — "New City." What the Carthaginians called Carthage.
      </p>
      <p class="mt-8 max-w-2xl text-base sm:text-lg text-ink-900 leading-relaxed">
        An evolving encyclopedia of ancient Carthage from its founding to its
        destruction in 146 BCE. Every claim is sourced, every confidence
        level made explicit, every gap in the record named.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-10">
    <p class="eyebrow mb-2">Section 01</p>
    <h2 class="font-serif text-3xl sm:text-4xl mb-6">Start here</h2>
    <ul class="flex flex-wrap gap-2">
      {startHereChips.map((c) => (
        <li>
          <a
            href={c.href}
            class={`inline-flex items-baseline gap-2 px-3 py-1.5 border rounded-full text-sm transition-colors ${kindStyle[c.kind]}`}
            title={kindLabel[c.kind]}
          >
            <span class="font-serif text-sand-900">{c.label}</span>
            {c.date && <span class="text-[11px] text-sand-700 tabular-nums">· {c.date}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-10 border-t border-tyrian-700">
    <p class="eyebrow mb-2">Section 02</p>
    <h2 class="font-serif text-3xl sm:text-4xl mb-3">Reading threads</h2>
    <p class="text-sand-700 mb-6 text-base max-w-2xl">
      Curated multi-page journeys through the encyclopedia. Each is an ordered
      path of stops with editorial annotation. A way in if you want shape
      rather than search.
    </p>
    <ul class="grid sm:grid-cols-2 gap-4">
      {featuredThreads.map((t: any) => (
        <li>
          <a href={`/threads/${t.id.replace(/\.md$/, '')}`} class={`block p-5 border-2 rounded-lg hover:border-tyrian-700 transition-colors h-full ${scopeColors[t.data.scope] ?? "border-sand-300 bg-sand-50"}`}>
            <div class="flex items-baseline justify-between gap-3 flex-wrap">
              <h3 class="font-serif text-lg text-tyrian-900">{t.data.title}</h3>
              <span class="text-[10px] uppercase tracking-widest text-sand-700 shrink-0">
                {t.data.scope} · {t.data.stops.length} stops
              </span>
            </div>
            <p class="text-sm text-ink-900 mt-2 line-clamp-3">{t.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-sand-700">
      <a href="/threads" class="text-tyrian-700 hover:underline">All reading threads →</a>
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-tyrian-700">
    <p class="eyebrow mb-2">Section 03</p>
    <h2 class="font-serif text-3xl sm:text-4xl mb-8">From the encyclopedia</h2>
    <div class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-10 items-start">
      <p class="font-phoenician text-5xl text-tyrian-700 leading-none md:mt-1">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
      <div class="prose-encyclopedia text-ink-900 max-w-2xl">
        <p class="text-base">
          I'm not a historian. I'm just someone who loves ancient Carthage and
          thinks the city deserves a better place on the open web than it
          currently has. Most of what survives about Carthage was written by
          its enemies; what little is now widely read is mostly the dramatic
          highlights — Hannibal crossing the Alps, the destruction in 146 BCE
          — with the long arc and the structural questions left out. I wanted
          a reference I could actually use, and decided to build one.
        </p>
        <p class="text-sm text-sand-700">
          The synthesis is mine; the underlying scholarship is everyone else's,
          and is named at the bottom of each claim and source page. Where I
          take a position (the labeled <a href="/editorialTakes" class="text-tyrian-700">editorial takes</a>),
          I show my reasoning. Where I'm wrong, please tell me. <a href="/about" class="text-tyrian-700">More about the project →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-tyrian-700">
    <p class="eyebrow mb-2">Section 04</p>
    <h2 class="font-serif text-3xl sm:text-4xl mb-8">What this is</h2>
    <div class="grid md:grid-cols-3 gap-8 text-ink-900">
      <div>
        <h3 class="font-serif text-xl mb-2">Sourced, not summarized</h3>
        <p class="text-sm leading-relaxed">
          Every factual claim links to the ancient and modern sources that
          support, qualify, or contradict it, with passage-level citations.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Honest about what we don't know</h3>
        <p class="text-sm leading-relaxed">
          Claims are tagged <em>attested</em>, <em>inferred</em>,
          <em>contested</em>, or <em>legendary</em>. Open questions get their
          own pages: gaps in the record are part of the history.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Beyond the Roman frame</h3>
        <p class="text-sm leading-relaxed">
          Most of what survives about Carthage was written by its enemies.
          This encyclopedia foregrounds Carthaginian self-understanding
          where the evidence allows.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
