---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events')).sort(
  (a, b) => a.data.date_start.value - b.data.date_start.value
);
const people = await getCollection('people');
const sources = await getCollection('sources');
---

<BaseLayout title="Qart-Hadasht">
  <section class="bg-sand-100 border-b border-sand-300">
    <div class="max-w-5xl mx-auto px-6 py-16">
      <p class="font-phoenician text-4xl text-tyrian-700 mb-2">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
      <h1 class="font-serif text-5xl leading-tight">Qart-Hadasht</h1>
      <p class="text-sand-700 mt-2 text-lg">
        <em>kart-ha-DASHT</em> — "New City." What the Carthaginians called Carthage.
      </p>
      <p class="mt-6 max-w-2xl text-lg text-sand-900">
        An evolving encyclopedia of ancient Carthage from its founding to its destruction in 146 BCE.
        Every claim is sourced, every confidence level made explicit, every gap in the record named.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12">
    <h2 class="font-serif text-3xl mb-6">What this is</h2>
    <div class="grid md:grid-cols-3 gap-6 text-sand-900">
      <div>
        <h3 class="font-serif text-xl mb-2">Sourced, not summarized</h3>
        <p class="text-sm leading-relaxed">
          Every factual claim is linked to the ancient and modern sources that
          support, qualify, or contradict it — with passage-level citations.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Honest about what we don't know</h3>
        <p class="text-sm leading-relaxed">
          Claims are tagged <em>attested</em>, <em>inferred</em>, <em>contested</em>, or
          <em>legendary</em>. Open questions get their own pages — gaps in the
          record are part of the history.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Beyond the Roman frame</h3>
        <p class="text-sm leading-relaxed">
          Most of what survives about Carthage was written by its enemies. This
          encyclopedia foregrounds Carthaginian self-understanding where the
          evidence allows.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8">
    <h2 class="font-serif text-3xl mb-6">Start here</h2>
    <ul class="space-y-3">
      {events.map((e) => (
        <li>
          <a href={`/events/${e.id}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white transition-colors">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-serif text-xl text-tyrian-700">{e.data.name}</h3>
              <span class="text-sm text-sand-700 shrink-0">{Math.abs(e.data.date_start.value)} BCE</span>
            </div>
            <p class="text-sm text-sand-900 mt-2">{e.data.summary.slice(0, 240)}...</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8">
    <div class="grid md:grid-cols-2 gap-8">
      <div>
        <h2 class="font-serif text-2xl mb-4">People</h2>
        <ul class="space-y-2">
          {people.map((p) => (
            <li>
              <a href={`/people/${p.id}`} class="text-tyrian-700 hover:underline">
                {p.data.name_display}
              </a>
              {p.data.name_punic && (
                <span class="text-sand-700 text-sm"> · {p.data.name_punic}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="font-serif text-2xl mb-4">Sources</h2>
        <ul class="space-y-2">
          {sources.map((s) => (
            <li>
              <a href={`/sources/${s.id}`} class="text-tyrian-700 hover:underline">
                {s.data.author ? `${s.data.author}, ` : ''}<em>{s.data.title}</em>
              </a>
              <span class="text-sand-700 text-sm"> · {s.data.is_primary ? 'primary' : 'modern'}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
