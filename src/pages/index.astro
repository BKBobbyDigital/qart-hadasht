---
import { renderInline } from '../lib/autolink';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection } from 'astro:content';

// Trim a long summary down to a single editorial gloss. Prefers the
// first complete sentence; falls back to a word-boundary truncation.
function trimGloss(s: string | undefined, max = 200): string {
  if (!s) return '';
  const clean = s
    .replace(/\[([^\]\n]+)\]\([^)\s]+\)/g, '$1')
    .replace(/\*\*([^\n]+?)\*\*/g, '$1')
    .replace(/(?<![*\w])\*([^*\n]+?)\*(?![*\w])/g, '$1')
    .replace(/(?<![_\w])_([^_\n]+?)_(?![_\w])/g, '$1');
  const flat = clean.replace(/\s+/g, ' ').trim();
  if (flat.length <= max) return flat;
  const periodIdx = flat.indexOf('. ');
  if (periodIdx > 0 && periodIdx < max) return flat.slice(0, periodIdx + 1);
  const cut = flat.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > 0 ? cut.slice(0, lastSpace) : cut) + '…';
}

// ─── Lead story ──────────────────────────────────────────────────────────────
// The marquee slot. Hand-curated (a single editable spot) — swap the copy
// and href to feature a different flagship piece (take, narrative, or
// comparison) whenever. Currently the destruction editorial take: a famous
// topic that also showcases the labeled-position format.
const lead = {
  kicker: 'Editorial take · The destruction',
  headline: 'Carthage was destroyed because it had not become weak enough',
  standfirst:
    "The Treaty of 201 was meant to leave Carthage permanently constrained. Fifty years later Rome erased the city anyway. The site's reading of why, and what the sources actually support.",
  meta: 'Read the take · confidence: moderate',
  href: '/editorialTakes/destruction-not-weak-enough',
};

// ─── Famous entry points ─────────────────────────────────────────────────────
// The familiar front door. Hand-curated framings (not entity summaries) so
// the copy can do the pulling. Swap freely.
const famous = [
  {
    kicker: 'Person',
    title: 'Hannibal Barca',
    gloss: 'The war he carried into Italy, and what he was actually after.',
    href: '/people/hannibal-barca',
  },
  {
    kicker: 'The founding',
    title: 'Dido, the queen',
    gloss: 'Where the founding legend ends and the evidence begins.',
    href: '/people/dido',
  },
  {
    kicker: 'The Tophet',
    title: 'Child sacrifice?',
    gloss: 'The practice happened. The scale is unrecoverable.',
    href: '/narratives/the-tophet-controversy',
  },
  {
    kicker: 'The myth',
    title: '“They salted the earth”',
    gloss: "Everyone knows Rome salted the fields so nothing would grow. It didn't happen.",
    href: '/openQuestions/tpw-salt-the-earth',
  },
];

// ─── Read deeper: the novel formats ──────────────────────────────────────────
// One of each distinctive format, teased. These are what the open-web
// Carthage record doesn't do.
const leadNarrative = await getEntry('narratives', 'the-barcid-iberian-state');
const featuredComparison = await getEntry('sourceComparisons', 'cannae');
const leadThread = await getEntry('threads', 'hannibals-life');

// Live counts for the "all X" links (were hard-coded and had gone stale).
const takeCount = (await getCollection('editorialTakes')).length;
const narrativeCount = (await getCollection('narratives')).length;
const comparisonCount = (await getCollection('sourceComparisons')).length;
const questionCount = (await getCollection('openQuestions')).length;
---

<BaseLayout title="Qart-Hadasht"
  description="An evolving encyclopedia of ancient Carthage from its legendary founding (~814 BCE) to its destruction in 146 BCE. Every claim is sourced, every confidence level made explicit, and every gap in the surviving record named."
>
  <!-- Screen-reader/SEO document heading. The masthead wordmark is a <p>
       (so entity pages own the single visible <h1>); the homepage's visible
       lead is the marquee below. -->
  <h1 class="sr-only">Qart-Hadasht — An Encyclopedia of Ancient Carthage</h1>

  <!-- ── Lead story ─────────────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-6 pt-10 pb-8">
    <div class="grid lg:grid-cols-[1.55fr_1fr] gap-10 lg:gap-14 pb-9 border-b-[3px] border-ink-900">
      <div class="min-w-0">
        <p class="eyebrow mb-3">{lead.kicker}</p>
        <a href={lead.href} class="group block">
          <h2 class="font-serif font-extrabold text-[clamp(2.2rem,4.4vw,3.5rem)] leading-[1.0] tracking-[-0.035em] text-ink-900 text-balance group-hover:text-tyrian-900 transition-colors">
            {lead.headline}
          </h2>
        </a>
        <p class="mt-5 text-xl leading-snug font-medium text-ink-900 max-w-[42ch]">{lead.standfirst}</p>
        <a href={lead.href} class="mt-5 inline-block text-[13px] font-semibold uppercase tracking-wider text-tyrian-700 hover:underline">{lead.meta} →</a>
      </div>
      <aside class="lg:border-l lg:border-sand-300 lg:pl-8 self-start">
        <p class="eyebrow no-bar mb-3">Where this site differs</p>
        <p class="font-heritage text-xl leading-snug italic text-ink-900">“Most of what survives about Carthage was written by its enemies. This site reads against that.”</p>
        <p class="mt-4 text-sm text-sand-700 leading-relaxed">
          Every claim is sourced and confidence-tagged. Where the site takes a
          position, it says so and names the readings it rejects.
          <a href="/methodology" class="text-tyrian-700 hover:underline">How the method works →</a>
        </p>
      </aside>
    </div>
  </section>

  <!-- ── Famous entry points ────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-6 py-9">
    <p class="eyebrow mb-5">Start with the famous stories</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-7">
      {famous.map((f) => (
        <a href={f.href} class="group block border-t-2 border-ink-900 pt-3 pb-4 px-2 -mx-2 rounded-lg hover:bg-tyrian-50 transition-colors">
          <p class="text-[10px] uppercase tracking-widest font-extrabold text-tyrian-700">{f.kicker}</p>
          <h3 class="font-serif font-extrabold text-[1.3rem] leading-[1.08] tracking-tight text-ink-900 mt-1.5 group-hover:text-tyrian-900" set:html={renderInline(f.title)}></h3>
          <p class="text-sm text-sand-700 mt-2 leading-snug">{f.gloss}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Read deeper: the novel formats ─────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-6 py-9 border-t border-sand-300">
    <p class="eyebrow mb-2">Read deeper</p>
    <h2 class="font-serif text-3xl sm:text-4xl mb-2">What this site does that others don't</h2>
    <p class="text-sand-700 mb-6 max-w-2xl">
      The open-web record of Carthage is mostly the highlights. These formats
      put the synthesis, and the evidence for it, in front.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {leadNarrative && (
        <a href={`/narratives/${leadNarrative.id.replace(/\.md$/, '')}`} class="flex flex-col h-full p-5 border border-tyrian-300 bg-sand-50 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors">
          <p class="text-[10px] uppercase tracking-widest font-extrabold text-tyrian-700">Narrative · {leadNarrative.data.scope}</p>
          <h3 class="font-serif text-xl text-ink-900 mt-2 leading-tight">{leadNarrative.data.title}</h3>
          <p class="text-sm text-ink-900 mt-3 leading-relaxed line-clamp-5 flex-1">{trimGloss(leadNarrative.data.thesis, 230)}</p>
          <p class="mt-4 text-xs text-tyrian-700 font-medium">Read the essay →</p>
        </a>
      )}
      {featuredComparison && (
        <a href={`/sourceComparisons/${featuredComparison.id}`} class="flex flex-col h-full p-5 border border-tyrian-300 bg-sand-50 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors">
          <p class="text-[10px] uppercase tracking-widest font-extrabold text-tyrian-700">Source comparison · {featuredComparison.data.source_passages.length} sources</p>
          <h3 class="font-serif text-xl text-ink-900 mt-2 leading-tight">{featuredComparison.data.title}</h3>
          <p class="text-sm text-ink-900 mt-3 leading-relaxed line-clamp-5 flex-1">{trimGloss(featuredComparison.data.summary, 230)}</p>
          <p class="mt-4 text-xs text-tyrian-700 font-medium">{featuredComparison.data.points_of_difference.length} points of difference →</p>
        </a>
      )}
      {leadThread && (
        <a href={`/threads/${leadThread.id.replace(/\.md$/, '')}`} class="flex flex-col h-full p-5 border border-tyrian-300 bg-sand-50 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors">
          <p class="text-[10px] uppercase tracking-widest font-extrabold text-tyrian-700">Reading thread · {leadThread.data.stops.length} stops</p>
          <h3 class="font-serif text-xl text-ink-900 mt-2 leading-tight">{leadThread.data.title}</h3>
          <p class="text-sm text-ink-900 mt-3 leading-relaxed line-clamp-5 flex-1" set:html={renderInline(trimGloss(leadThread.data.summary, 230))}></p>
          <p class="mt-4 text-xs text-tyrian-700 font-medium">Begin the thread →</p>
        </a>
      )}
    </div>
    <p class="mt-6 text-sm text-sand-700 flex flex-wrap gap-x-5 gap-y-1">
      <a href="/narratives" class="text-tyrian-700 hover:underline">All {narrativeCount} narratives →</a>
      <a href="/editorialTakes" class="text-tyrian-700 hover:underline">{takeCount} editorial takes →</a>
      <a href="/sourceComparisons" class="text-tyrian-700 hover:underline">{comparisonCount} source comparisons →</a>
      <a href="/openQuestions" class="text-tyrian-700 hover:underline">{questionCount} open questions →</a>
      <a href="/maps" class="text-tyrian-700 hover:underline">Maps →</a>
    </p>
  </section>

  <!-- ── Personal voice ─────────────────────────────────────────────────── -->
  <section class="border-t-4 border-tyrian-700 bg-[#f6f6f7]">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <p class="eyebrow no-bar mb-5">From the encyclopedia</p>
      <div class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-10 items-start">
        <p class="font-phoenician text-5xl text-tyrian-700 leading-none md:mt-1">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
        <div class="max-w-2xl">
          <p class="font-heritage text-xl sm:text-2xl leading-snug text-ink-900">
            I'm not a historian. I'm just someone who loves ancient Carthage and
            thinks the city deserves a better place on the open web than it
            currently has. The synthesis is mine; the underlying scholarship is
            everyone else's.
          </p>
          <p class="text-sm text-sand-700 mt-4 leading-relaxed">
            What little of Carthage is now widely read is mostly the dramatic
            highlights, with the long arc and the structural questions left out.
            I wanted a reference I could actually use, so I built one. Where I
            take a position, I show my reasoning. Where I'm wrong, please tell me.
            <a href="/about" class="text-tyrian-700 hover:underline">More about the project →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What this is ───────────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-6 py-12">
    <p class="eyebrow mb-6">What this is</p>
    <div class="grid md:grid-cols-3 gap-8 text-ink-900">
      <div>
        <h3 class="font-serif text-xl mb-2">Sourced, not summarized</h3>
        <p class="text-sm leading-relaxed">
          Every factual claim links to the ancient and modern sources that
          support, qualify, or contradict it, with passage-level citations.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Honest about what we don't know</h3>
        <p class="text-sm leading-relaxed">
          Claims are tagged <em>attested</em>, <em>inferred</em>,
          <em>contested</em>, or <em>legendary</em>. Open questions get their
          own pages: gaps in the record are part of the history.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Beyond the Roman frame</h3>
        <p class="text-sm leading-relaxed">
          The surviving record is overwhelmingly Greek and Roman, written from
          outside. This encyclopedia foregrounds Carthaginian self-understanding
          where the evidence allows.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
