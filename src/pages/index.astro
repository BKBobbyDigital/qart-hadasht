---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

const periods = (await getCollection('periods')).sort(
  (a: any, b: any) => a.data.start_year - b.data.start_year
);
const fmtYear = (y: number) => `${Math.abs(y)} ${y < 0 ? 'BCE' : 'CE'}`;

// ─── Curated "Start here" chips ──────────────────────────────────────────────
//
// A mix of events, people, and places — the most-iconic entry points into
// the Carthaginian story. Resolves to live entity data so titles and dates
// stay accurate as content evolves.
type ChipKind = 'event' | 'person' | 'place';
type StartHereSpec = { kind: ChipKind; slug: string };

const startHereSpecs: StartHereSpec[] = [
  { kind: 'person', slug: 'hannibal-barca' },
  { kind: 'event', slug: 'founding-of-carthage' },
  { kind: 'event', slug: 'crossing-of-the-alps' },
  { kind: 'event', slug: 'battle-of-cannae' },
  { kind: 'event', slug: 'battle-of-zama' },
  { kind: 'event', slug: 'destruction-of-carthage' },
  { kind: 'person', slug: 'dido' },
  { kind: 'person', slug: 'scipio-africanus' },
  { kind: 'place', slug: 'carthage' },
  { kind: 'person', slug: 'cato-the-elder' },
];

type Chip = { kind: ChipKind; href: string; label: string; date: string };

const startHereChips: Chip[] = await Promise.all(
  startHereSpecs.map(async (s): Promise<Chip | null> => {
    if (s.kind === 'event') {
      const e: any = await getEntry('events', s.slug);
      if (!e) return null;
      const d = e.data;
      const date = d.date_start.precision === 'legendary'
        ? `legendary ${Math.abs(d.date_start.value)} BCE`
        : (d.date_end
            ? `${Math.abs(d.date_start.value)}–${Math.abs(d.date_end.value)} BCE`
            : `${Math.abs(d.date_start.value)} BCE`);
      return { kind: 'event', href: `/events/${s.slug}`, label: d.name, date };
    }
    if (s.kind === 'person') {
      const p: any = await getEntry('people', s.slug);
      if (!p) return null;
      const d = p.data;
      let date = '';
      if (d.birth?.precision === 'legendary' || d.death?.precision === 'legendary') {
        date = 'legendary';
      } else if (d.birth && d.death) {
        date = `${Math.abs(d.birth.value)}–${Math.abs(d.death.value)} BCE`;
      } else if (d.death) {
        date = `d. ${Math.abs(d.death.value)} BCE`;
      } else if (d.birth) {
        date = `b. ${Math.abs(d.birth.value)} BCE`;
      } else if (d.floruit) {
        date = `fl. ${Math.abs(d.floruit.value)} BCE`;
      }
      return { kind: 'person', href: `/people/${s.slug}`, label: d.name_display, date };
    }
    // place
    const pl: any = await getEntry('places', s.slug);
    if (!pl) return null;
    return { kind: 'place', href: `/places/${s.slug}`, label: pl.data.name_display, date: pl.data.modern_location ? `today: ${pl.data.modern_location}` : '' };
  })
).then((arr) => arr.filter(Boolean) as Chip[]);

// Color hint per chip kind
const kindStyle: Record<ChipKind, string> = {
  event: 'border-amber-300 bg-amber-50 hover:bg-amber-100',
  person: 'border-tyrian-300 bg-tyrian-50 hover:bg-tyrian-100',
  place: 'border-emerald-300 bg-emerald-50 hover:bg-emerald-100',
};
const kindLabel: Record<ChipKind, string> = {
  event: 'event',
  person: 'person',
  place: 'place',
};
---

<BaseLayout title="Qart-Hadasht">
  <section class="bg-sand-100 border-b border-sand-300">
    <div class="max-w-5xl mx-auto px-5 sm:px-6 py-10 sm:py-16">
      <p class="font-phoenician text-3xl sm:text-4xl text-tyrian-700 mb-2">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
      <h1 class="font-serif text-3xl sm:text-5xl leading-tight">Qart-Hadasht</h1>
      <p class="text-sand-700 mt-2 text-base sm:text-lg">
        <em>kart-ha-DASHT</em> — "New City." What the Carthaginians called Carthage.
      </p>
      <p class="mt-5 sm:mt-6 max-w-2xl text-base sm:text-lg text-sand-900">
        An evolving encyclopedia of ancient Carthage from its founding to its
        destruction in 146 BCE. Every claim is sourced, every confidence
        level made explicit, every gap in the record named.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8">
    <h2 class="font-serif text-2xl mb-4">Start here</h2>
    <ul class="flex flex-wrap gap-2">
      {startHereChips.map((c) => (
        <li>
          <a
            href={c.href}
            class={`inline-flex items-baseline gap-2 px-3 py-1.5 border rounded-full text-sm transition-colors ${kindStyle[c.kind]}`}
            title={kindLabel[c.kind]}
          >
            <span class="font-serif text-sand-900">{c.label}</span>
            {c.date && <span class="text-[11px] text-sand-700 tabular-nums">· {c.date}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8">
    <h2 class="font-serif text-3xl mb-2">Browse by period</h2>
    <p class="text-sand-700 mb-6 text-sm max-w-2xl">
      Seven eras, each with a synthesis of the events, people, places, and
      themes that shaped it. The narrative connective tissue between the
      entity pages.
    </p>
    <ol class="grid sm:grid-cols-2 gap-3">
      {periods.map((p: any) => (
        <li>
          <a href={`/periods/${p.id.replace(/\.md$/, '')}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white transition-colors h-full">
            <div class="flex items-baseline justify-between gap-3 flex-wrap">
              <h3 class="font-serif text-lg text-tyrian-700">{p.data.title}</h3>
              <span class="text-xs text-sand-700 tabular-nums shrink-0">
                {fmtYear(p.data.start_year)} – {fmtYear(p.data.end_year)}
              </span>
            </div>
            <p class="text-xs text-sand-900 mt-2 line-clamp-3">{p.data.summary}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8 border-t border-sand-300 mt-8">
    <h2 class="font-serif text-3xl mb-6">What this is</h2>
    <div class="grid md:grid-cols-3 gap-6 text-sand-900">
      <div>
        <h3 class="font-serif text-xl mb-2">Sourced, not summarized</h3>
        <p class="text-sm leading-relaxed">
          Every factual claim links to the ancient and modern sources that
          support, qualify, or contradict it, with passage-level citations.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Honest about what we don't know</h3>
        <p class="text-sm leading-relaxed">
          Claims are tagged <em>attested</em>, <em>inferred</em>,
          <em>contested</em>, or <em>legendary</em>. Open questions get their
          own pages: gaps in the record are part of the history.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Beyond the Roman frame</h3>
        <p class="text-sm leading-relaxed">
          Most of what survives about Carthage was written by its enemies.
          This encyclopedia foregrounds Carthaginian self-understanding
          where the evidence allows.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
