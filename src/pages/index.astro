---
import { renderInline } from '../lib/autolink';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

// Trim a long summary down to a single editorial gloss. Prefers the
// first complete sentence; falls back to a word-boundary truncation.
function trimGloss(s: string | undefined, max = 200): string {
  if (!s) return '';
  // Strip inline markdown (*italic*, **bold**, [text](url)) so glosses
  // never show literal markers in plain-text card previews.
  const clean = s
    .replace(/\[([^\]\n]+)\]\([^)\s]+\)/g, '$1')
    .replace(/\*\*([^\n]+?)\*\*/g, '$1')
    .replace(/(?<![*\w])\*([^*\n]+?)\*(?![*\w])/g, '$1')
    .replace(/(?<![_\w])_([^_\n]+?)_(?![_\w])/g, '$1');
  const flat = clean.replace(/\s+/g, ' ').trim();
  if (flat.length <= max) return flat;
  const periodIdx = flat.indexOf('. ');
  if (periodIdx > 0 && periodIdx < max) return flat.slice(0, periodIdx + 1);
  const cut = flat.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return (lastSpace > 0 ? cut.slice(0, lastSpace) : cut) + '…';
}

// ─── Headline editorial takes ────────────────────────────────────────────────
// Three positions the site argues that nobody else does in this form.
// These are the sharpest possible front door — a first-time visitor
// sees immediately what makes this encyclopedia distinct.
const featuredTakeSlugs = [
  'destruction-not-weak-enough',
  'masinissa-strategic-opportunist',
  'tophet-happened-scale-unrecoverable',
];
const featuredTakes = (await Promise.all(
  featuredTakeSlugs.map(async (slug) => await getEntry('editorialTakes', slug))
)).filter(Boolean) as any[];

// ─── Long-form narratives ────────────────────────────────────────────────────
// Three substantive interpretive arcs — the "long arc and structural
// questions" the pull-quote promises, vs the dramatic-highlights
// framing that dominates the open-web Carthage record.
const featuredNarrativeSlugs = [
  'mago-of-carthage',
  'punic-continuity-in-roman-africa',
  'the-barcid-iberian-state',
];
const featuredNarratives = (await Promise.all(
  featuredNarrativeSlugs.map(async (slug) => await getEntry('narratives', slug))
)).filter(Boolean) as any[];

// ─── Open questions ──────────────────────────────────────────────────────────
// Gaps as first-class entities. Two featured: one the long-arc duration
// question (load-bearing for the no-hard-endpoint discipline), and one
// a famous claim the site reframes (salt-the-earth — almost everyone
// gets this wrong).
const featuredQuestionSlugs = [
  'duration-of-punic-cultural-identity',
  'tpw-salt-the-earth',
];
const featuredQuestions = (await Promise.all(
  featuredQuestionSlugs.map(async (slug) => await getEntry('openQuestions', slug))
)).filter(Boolean) as any[];

// ─── Featured source comparison ──────────────────────────────────────────────
// Showcase the new source-rivalry reading interface. Cannae is the POC
// and the strongest example: four ancient sources, six points of
// difference worked out, with the methodological pay-off (the Maharbal
// exchange almost certainly not historical) genuinely interesting.
const featuredComparison = await getEntry('sourceComparisons', 'cannae');

// ─── Featured threads ────────────────────────────────────────────────────────
const featuredThreadSlugs = [
  'hannibals-life',
  'road-to-146',
  'why-cannae-didnt-end-the-war',
  'the-tophet-question',
];
const featuredThreads = (await Promise.all(
  featuredThreadSlugs.map(async (slug) => await getEntry('threads', slug))
)).filter(Boolean) as any[];

const confidenceLabel: Record<string, string> = {
  tentative: 'tentative',
  moderate: 'moderate',
  strong: 'strong',
};
---

<BaseLayout title="Qart-Hadasht"
  description="An evolving encyclopedia of ancient Carthage from its legendary founding (~814 BCE) to its destruction in 146 BCE. Every claim is sourced, every confidence level made explicit, and every gap in the surviving record named."
>
  <section class="max-w-6xl mx-auto px-6 py-12">
    <!-- Accessibility-only page heading. The masthead wordmark is now a
         <p> (so entity pages have a single <h1> for their topic); the
         homepage needs its own <h1> for screen readers and SEO. -->
    <h1 class="sr-only">Qart-Hadasht — An Encyclopedia of Ancient Carthage</h1>
    <!-- Editorial pull-quote: the project's pitch sentence sets the
         encyclopedia's stance before the Start Here cards offer entry
         points. -->
    <blockquote class="border-l-2 border-tyrian-700 pl-6 mb-12 max-w-3xl">
      <p class="font-serif text-xl sm:text-2xl leading-snug text-ink-900">
        An evolving encyclopedia of ancient Carthage from its founding to its
        destruction in 146 BCE. Every claim is sourced, every confidence
        level made explicit, every gap in the record named.
      </p>
      <footer class="mt-3 text-sm text-sand-700 italic">
        <em>Qart-Hadasht</em> — <em>kart-ha-DASHT</em>, "New City."
        What the Carthaginians called Carthage.
      </footer>
    </blockquote>

    <p class="eyebrow mb-3">Where this site differs</p>
    <h2 class="font-serif text-3xl sm:text-4xl mb-3">Headline positions</h2>
    <p class="text-sand-700 mb-6 max-w-2xl">
      Three positions the site argues with full reasoning and
      explicitly named competing readings. Each take is labeled
      with confidence (<em>tentative</em>, <em>moderate</em>,
      <em>strong</em>) and links to the underlying claims.
    </p>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredTakes.map((t: any) => (
        <li>
          <a
            href={`/editorialTakes/${t.id}`}
            class="flex flex-col h-full p-5 border border-tyrian-300 bg-sand-50 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors"
          >
            <p class="text-[10px] uppercase tracking-widest font-semibold text-tyrian-700">
              Editorial take · {confidenceLabel[t.data.confidence] ?? t.data.confidence}
            </p>
            <h3 class="font-serif text-lg text-tyrian-900 mt-2 leading-snug" set:html={renderInline(t.data.subject_question)}></h3>
            <p class="text-sm text-ink-900 mt-3 leading-relaxed line-clamp-4 flex-1">{trimGloss(t.data.position, 220)}</p>
            <p class="mt-4 text-xs text-tyrian-700 font-medium">Read the take →</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-sand-700">
      <a href="/editorialTakes" class="text-tyrian-700 hover:underline">All 21 editorial takes →</a>
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-10 border-t border-tyrian-700">
    <p class="eyebrow mb-3">The long arc and structural questions</p>
    <h2 class="font-serif text-3xl sm:text-4xl mb-3">Long-form readings</h2>
    <p class="text-sand-700 mb-6 max-w-2xl">
      Long-form interpretive arcs the open-web Carthage record
      under-treats. Substantive synthesis with full source apparatus.
    </p>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredNarratives.map((n: any) => (
        <li>
          <a
            href={`/narratives/${n.id.replace(/\.md$/, '')}`}
            class="flex flex-col h-full p-5 border border-sand-300 bg-white/60 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors"
          >
            <p class="text-[10px] uppercase tracking-widest font-semibold text-sand-700">
              Narrative · {n.data.scope}
            </p>
            <h3 class="font-serif text-xl text-ink-900 mt-2 leading-tight">{n.data.title}</h3>
            <p class="text-sm text-ink-900 mt-3 leading-relaxed line-clamp-5 flex-1">{trimGloss(n.data.thesis, 240)}</p>
            <p class="mt-4 text-xs text-tyrian-700 font-medium">Read →</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-sand-700">
      <a href="/narratives" class="text-tyrian-700 hover:underline">All 33 narratives →</a>
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-10 border-t border-tyrian-700">
    <p class="eyebrow mb-3">Gaps as first-class entities</p>
    <h2 class="font-serif text-3xl sm:text-4xl mb-3">What we don't know</h2>
    <p class="text-sand-700 mb-6 max-w-2xl">
      Questions the surviving evidence doesn't resolve. Each gets its
      own page with the evidence summary, candidate answers, and what
      would resolve it.
    </p>
    <ul class="grid sm:grid-cols-2 gap-4">
      {featuredQuestions.map((q: any) => (
        <li>
          <a
            href={`/openQuestions/${q.id}`}
            class="flex flex-col h-full p-5 border border-sand-400 bg-sand-50 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors"
          >
            <p class="text-[10px] uppercase tracking-widest font-semibold text-sand-700">Open question</p>
            <h3 class="font-serif text-lg text-ink-900 mt-2 leading-snug">{q.data.question}</h3>
            <p class="text-xs text-sand-700 mt-3">
              {(q.data.candidate_answers ?? []).length} candidate answer{(q.data.candidate_answers ?? []).length === 1 ? '' : 's'} weighed
            </p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-sand-700">
      <a href="/openQuestions" class="text-tyrian-700 hover:underline">All open questions →</a>
    </p>
  </section>

  {featuredComparison && (
    <section class="max-w-6xl mx-auto px-6 py-10 border-t border-tyrian-700">
      <p class="eyebrow mb-3">Reading the sources against each other</p>
      <h2 class="font-serif text-3xl sm:text-4xl mb-3">Compare the ancient sources</h2>
      <p class="text-sand-700 mb-6 max-w-2xl">
        Side-by-side parallel readings of contested events through the
        multiple ancient sources that preserve them. Where Polybius,
        Livy, Appian, and Plutarch agree and where they don't,
        surfaced directly rather than collapsed into a synthetic
        summary.
      </p>
      <a
        href={`/sourceComparisons/${featuredComparison.id}`}
        class="block p-6 border border-tyrian-300 bg-sand-50 rounded-lg hover:bg-tyrian-50 transition-colors"
      >
        <p class="text-[10px] uppercase tracking-widest font-semibold text-tyrian-700">Source comparison</p>
        <h3 class="font-serif text-2xl text-tyrian-900 mt-2 leading-snug">{featuredComparison.data.title}</h3>
        <p class="text-sm text-sand-900 mt-3 leading-relaxed">
          {trimGloss(featuredComparison.data.summary, 320)}
        </p>
        <p class="text-xs text-tyrian-700 mt-4 font-medium">
          {featuredComparison.data.source_passages.length} sources in parallel · {featuredComparison.data.points_of_difference.length} points of difference →
        </p>
      </a>
    </section>
  )}

  <section class="max-w-6xl mx-auto px-6 py-10 border-t border-tyrian-700">
    <p class="eyebrow mb-3">Historical atlas</p>
    <a
      href="/maps/extent-over-time"
      class="flex flex-col sm:flex-row gap-6 sm:gap-8 items-start p-6 border border-sand-400 bg-sand-50 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors"
    >
      <div class="flex-shrink-0 flex items-center justify-center w-full sm:w-48 aspect-[4/3] bg-sand-50 border border-tyrian-300 rounded-md">
        <p class="font-phoenician text-tyrian-700 text-3xl sm:text-4xl tracking-wider">𐤒𐤓𐤕</p>
      </div>
      <div class="flex-1">
        <h2 class="font-serif text-2xl sm:text-3xl mb-2 tracking-tight">Carthaginian territory, 550–146 BCE</h2>
        <p class="text-sand-900 leading-relaxed">
          Six centuries of Mediterranean shape in five toggleable
          states — from the network hegemony of the mid-6th century
          through the African heartland on the eve of destruction.
          Visual encoding distinguishes directly-administered hinterland,
          tributary zones, and territory lost since the prior state.
        </p>
        <p class="mt-3 text-sm text-tyrian-700 font-medium">Explore the map →</p>
      </div>
    </a>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-10 border-t border-tyrian-700">
    <h2 class="font-serif text-3xl sm:text-4xl mb-3">Reading threads</h2>
    <p class="text-sand-700 mb-6 text-base max-w-2xl">
      Curated multi-page journeys through the encyclopedia. Each is an ordered
      path of stops with editorial annotation. A way in if you want shape
      rather than search.
    </p>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {featuredThreads.map((t: any) => (
        <li>
          <a
            href={`/threads/${t.id.replace(/\.md$/, '')}`}
            class="flex flex-col h-full p-5 border border-sand-300 bg-white/60 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors"
          >
            <p class="text-[10px] uppercase tracking-widest font-semibold text-sand-700">
              Thread · {t.data.scope}
            </p>
            <h3 class="font-serif text-lg text-ink-900 mt-1.5 leading-snug">{t.data.title}</h3>
            <p class="text-sm text-sand-900 mt-3 leading-relaxed line-clamp-6 flex-1" set:html={renderInline(t.data.summary)}></p>
            <div class="mt-4 pt-3 border-t border-sand-200 flex items-baseline justify-between text-xs">
              <span class="text-sand-700">{t.data.stops.length} stops</span>
              <span class="text-tyrian-700 font-medium">Begin →</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-sand-700">
      <a href="/threads" class="text-tyrian-700 hover:underline">All reading threads →</a>
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-12 border-t border-tyrian-700">
    <h2 class="font-serif text-3xl sm:text-4xl mb-8">From the encyclopedia</h2>
    <div class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-10 items-start">
      <p class="font-phoenician text-5xl text-tyrian-700 leading-none md:mt-1">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
      <div class="prose-encyclopedia text-ink-900 max-w-2xl">
        <p class="text-base">
          I'm not a historian. I'm just someone who loves ancient Carthage and
          thinks the city deserves a better place on the open web than it
          currently has. Most of what survives about Carthage was written by
          its enemies; what little is now widely read is mostly the dramatic
          highlights — Hannibal crossing the Alps, the destruction in 146 BCE
          — with the long arc and the structural questions left out. I wanted
          a reference I could actually use, and decided to build one.
        </p>
        <p class="text-sm text-sand-700">
          The synthesis is mine; the underlying scholarship is everyone else's,
          and is named at the bottom of each claim and source page. Where I
          take a position (the labeled <a href="/editorialTakes" class="text-tyrian-700">editorial takes</a>),
          I show my reasoning. Where I'm wrong, please tell me. <a href="/about" class="text-tyrian-700">More about the project →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-12 border-t border-tyrian-700">
    <h2 class="font-serif text-3xl sm:text-4xl mb-8">What this is</h2>
    <div class="grid md:grid-cols-3 gap-8 text-ink-900">
      <div>
        <h3 class="font-serif text-xl mb-2">Sourced, not summarized</h3>
        <p class="text-sm leading-relaxed">
          Every factual claim links to the ancient and modern sources that
          support, qualify, or contradict it, with passage-level citations.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Honest about what we don't know</h3>
        <p class="text-sm leading-relaxed">
          Claims are tagged <em>attested</em>, <em>inferred</em>,
          <em>contested</em>, or <em>legendary</em>. Open questions get their
          own pages: gaps in the record are part of the history.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Beyond the Roman frame</h3>
        <p class="text-sm leading-relaxed">
          Most of what survives about Carthage was written by its enemies.
          This encyclopedia foregrounds Carthaginian self-understanding
          where the evidence allows.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
