---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import { getCollection } from 'astro:content';

const periods = (await getCollection('periods')).sort(
  (a: any, b: any) => a.data.start_year - b.data.start_year
);
const fmtYear = (y: number) => `${Math.abs(y)} ${y < 0 ? 'BCE' : 'CE'}`;

const allEvents = (await getCollection('events')).sort(
  (a, b) => a.data.date_start.value - b.data.date_start.value
);

// Curate "start here" events — the most-read entry points
const featuredSlugs = [
  'founding-of-carthage',
  'battle-of-cannae',
  'battle-of-zama',
  'destruction-of-carthage',
];
const featuredEvents = featuredSlugs
  .map((slug) => allEvents.find((e) => e.id === slug))
  .filter(Boolean);

const allNarratives = await getCollection('narratives');
const biographies = allNarratives
  .filter((n) => n.data.scope === 'biography')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const themes = (await getCollection('themes'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const totalCounts = {
  events: allEvents.length,
  people: (await getCollection('people')).length,
  places: (await getCollection('places')).length,
  sources: (await getCollection('sources')).length,
  narratives: allNarratives.length,
  themes: themes.length,
};
---

<BaseLayout title="Qart-Hadasht">
  <section class="bg-sand-100 border-b border-sand-300">
    <div class="max-w-5xl mx-auto px-5 sm:px-6 py-10 sm:py-16">
      <p class="font-phoenician text-3xl sm:text-4xl text-tyrian-700 mb-2">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
      <h1 class="font-serif text-3xl sm:text-5xl leading-tight">Qart-Hadasht</h1>
      <p class="text-sand-700 mt-2 text-base sm:text-lg">
        <em>kart-ha-DASHT</em> — "New City." What the Carthaginians called Carthage.
      </p>
      <p class="mt-5 sm:mt-6 max-w-2xl text-base sm:text-lg text-sand-900">
        An evolving encyclopedia of ancient Carthage from its founding to its
        destruction in 146 BCE. Every claim is sourced, every confidence
        level made explicit, every gap in the record named.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-10">
    <h2 class="font-serif text-3xl mb-4">The arc</h2>
    <p class="text-sand-700 mb-2 text-sm">
      Six and a half centuries of Carthaginian history at a glance. Wars are
      shown as colored bands; individual events as dots. Click anything to
      navigate.
    </p>
    <Timeline />
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8">
    <h2 class="font-serif text-3xl mb-2">Browse by period</h2>
    <p class="text-sand-700 mb-6 text-sm max-w-2xl">
      Seven eras, each with a synthesis of the events, people, places, and
      themes that shaped it. The narrative connective tissue between the
      entity pages.
    </p>
    <ol class="grid sm:grid-cols-2 gap-3">
      {periods.map((p: any) => (
        <li>
          <a href={`/periods/${p.id.replace(/\.md$/, '')}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white transition-colors h-full">
            <div class="flex items-baseline justify-between gap-3 flex-wrap">
              <h3 class="font-serif text-lg text-tyrian-700">{p.data.title}</h3>
              <span class="text-xs text-sand-700 tabular-nums shrink-0">
                {fmtYear(p.data.start_year)} – {fmtYear(p.data.end_year)}
              </span>
            </div>
            <p class="text-xs text-sand-900 mt-2 line-clamp-3">{p.data.summary}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8">
    <h2 class="font-serif text-3xl mb-6">What this is</h2>
    <div class="grid md:grid-cols-3 gap-6 text-sand-900">
      <div>
        <h3 class="font-serif text-xl mb-2">Sourced, not summarized</h3>
        <p class="text-sm leading-relaxed">
          Every factual claim links to the ancient and modern sources that
          support, qualify, or contradict it, with passage-level citations.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Honest about what we don't know</h3>
        <p class="text-sm leading-relaxed">
          Claims are tagged <em>attested</em>, <em>inferred</em>,
          <em>contested</em>, or <em>legendary</em>. Open questions get their
          own pages: gaps in the record are part of the history.
        </p>
      </div>
      <div>
        <h3 class="font-serif text-xl mb-2">Beyond the Roman frame</h3>
        <p class="text-sm leading-relaxed">
          Most of what survives about Carthage was written by its enemies.
          This encyclopedia foregrounds Carthaginian self-understanding
          where the evidence allows.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-8">
    <h2 class="font-serif text-3xl mb-6">Start here</h2>
    <ul class="grid sm:grid-cols-2 gap-3">
      {featuredEvents.map((e: any) => (
        <li>
          <a href={`/events/${e.id}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white transition-colors h-full">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-serif text-xl text-tyrian-700">{e.data.name}</h3>
              <span class="text-sm text-sand-700 shrink-0">{Math.abs(e.data.date_start.value)} BCE</span>
            </div>
            <p class="text-sm text-sand-900 mt-2">{e.data.summary.slice(0, 200)}...</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-sand-700">
      <a href="/events" class="text-tyrian-700 hover:underline">Browse all events →</a>
    </p>
  </section>

  {biographies.length > 0 && (
    <section class="max-w-5xl mx-auto px-6 py-8">
      <h2 class="font-serif text-3xl mb-2">Biographies</h2>
      <p class="text-sand-700 mb-6 text-sm">
        Long-form lives of the major figures of the Carthaginian story.
      </p>
      <ul class="grid sm:grid-cols-2 gap-3">
        {biographies.map((n) => (
          <li>
            <a href={`/narratives/${n.id.replace(/\.md$/, '')}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white transition-colors h-full">
              <h3 class="font-serif text-lg text-tyrian-700">{n.data.title}</h3>
              <p class="text-sm text-sand-900 mt-2">{n.data.thesis.slice(0, 180)}...</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="max-w-5xl mx-auto px-6 py-8">
    <h2 class="font-serif text-3xl mb-2">Themes</h2>
    <p class="text-sand-700 mb-6 text-sm">
      Cross-cutting topics: religion, daily life, language, trade, identity.
    </p>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {themes.map((t) => (
        <li>
          <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="block p-3 border border-sand-300 rounded-lg hover:bg-white transition-colors h-full">
            <h3 class="font-serif text-base text-tyrian-700">{t.data.title}</h3>
            <p class="text-xs text-sand-700 mt-1">{t.data.scope.replace('_', ' ')}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-sand-700">
      <a href="/civilization" class="text-tyrian-700 hover:underline">The Civilization hub →</a>
    </p>
  </section>
</BaseLayout>
