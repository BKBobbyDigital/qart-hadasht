---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { FamilyTreeConfig } from '../../lib/familyTree';
import { byDynastyChronology } from '../../lib/familyTree';

const dynastyModules = import.meta.glob('../../data/dynasties/*.ts', { eager: true });
type Entry = { slug: string; config: FamilyTreeConfig };
const entries: Entry[] = Object.entries(dynastyModules).map(([path, mod]) => {
  const stem = path.split('/').pop()!.replace(/\.ts$/, '');
  return { slug: stem, config: (mod as any).default as FamilyTreeConfig };
});
// Chronological (oldest first) so the list reads as a timeline.
entries.sort((a, b) => byDynastyChronology(a.config, b.config));
---

<BaseLayout title="Dynasties"
  description="Family-tree readings of the aristocratic and royal houses that shaped Carthaginian history: the Barcids, the Numidian Massylii, and the Magonids."
>
  <div class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="font-serif mb-3">Dynasties</h1>
    <p class="text-sand-700 mb-3">
      Family-tree readings of the aristocratic and royal houses that
      shaped Carthaginian history. Each tree presents the
      generations as a connected diagram with clickable nodes that
      lead to the individual person pages.
    </p>
    <p class="text-sand-700 mb-8 text-sm italic">
      Ancient prosopography is hard to follow in prose alone. The
      trees make the relationships among Hamilcar's children,
      between Carthaginian and Numidian royal lines, and across
      generations of the same house, directly visible.
    </p>

    {entries.length === 0 && (
      <p class="text-sand-700 italic">No dynasties yet.</p>
    )}

    <ul class="space-y-4">
      {entries.map(({ slug, config }) => (
        <li>
          <a href={`/dynasties/${slug}`} class="flex items-start gap-4 p-5 border border-sand-300 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors">
            <svg width="28" height="28" viewBox="0 0 22 22" class="flex-shrink-0 mt-1 text-tyrian-700" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="11" cy="3.5" r="2"/>
              <circle cx="4" cy="14" r="2"/>
              <circle cx="11" cy="14" r="2"/>
              <circle cx="18" cy="14" r="2"/>
              <path d="M 11 5.5 L 11 9 M 4 12 L 4 9 L 18 9 L 18 12 M 11 9 L 11 12"/>
            </svg>
            <div class="min-w-0">
              <h2 class="font-serif text-2xl text-tyrian-700">{config.title}</h2>
              {config.period && <p class="text-xs uppercase tracking-wider text-sand-700 mt-1 font-medium">{config.period}</p>}
              <p class="text-sm text-ink-900 mt-2">{config.subtitle}</p>
              <p class="text-xs text-sand-700 mt-3">
                {Object.keys(config.nodes).length} individuals across {config.edges.filter((e) => e.kind === 'parent').length > 0 ? 'multiple generations' : 'one generation'}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
