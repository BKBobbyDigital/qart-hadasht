---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FamilyTree from '../../components/FamilyTree.astro';
import VersionStamp from '../../components/VersionStamp.astro';
import type { FamilyTreeConfig } from '../../lib/familyTree';
import { getCollection } from 'astro:content';

// Eagerly import every dynasty config under src/data/dynasties/*.ts.
const dynastyModules = import.meta.glob('../../data/dynasties/*.ts', { eager: true });
const dynastyConfigs: Record<string, FamilyTreeConfig> = {};
for (const [path, mod] of Object.entries(dynastyModules)) {
  const stem = path.split('/').pop()!.replace(/\.ts$/, '');
  dynastyConfigs[stem] = (mod as any).default;
}

export async function getStaticPaths() {
  const dynastyModules = import.meta.glob('../../data/dynasties/*.ts', { eager: true });
  return Object.entries(dynastyModules).map(([path, mod]) => {
    const stem = path.split('/').pop()!.replace(/\.ts$/, '');
    return {
      params: { slug: stem },
      props: { config: (mod as any).default as FamilyTreeConfig, slug: stem },
    };
  });
}

const { config, slug } = Astro.props as { config: FamilyTreeConfig; slug: string };

// If a matching group page exists with the same slug, link to it.
const allGroups = await getCollection('groups');
const matchingGroup: any = allGroups.find((g) => g.id === slug) ?? null;
---

<BaseLayout title={config.title} description={config.subtitle}>
  <article class="max-w-5xl mx-auto px-6 py-12">
    <span hidden data-pagefind-filter="type:Dynasties" data-pagefind-meta="type:Dynasty"></span>

    <p class="eyebrow mb-3">
      Dynasty · <a href="/dynasties" class="text-tyrian-700 hover:underline">All dynasties</a>
    </p>

    <FamilyTree config={config} idPrefix={slug} />

    {matchingGroup && (
      <section class="mt-10 pt-6 border-t border-sand-300">
        <p class="text-sm text-sand-700">
          Read more about this family as a collective entity:{' '}
          <a href={`/groups/${matchingGroup.id}`} class="text-tyrian-700 hover:underline font-serif">
            {matchingGroup.data.name_display}
          </a>
        </p>
      </section>
    )}

    <VersionStamp date="2026-05-12" filePath={`src/data/dynasties/${slug}.ts`} />
  </article>
</BaseLayout>
