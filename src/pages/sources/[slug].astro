---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sourceSchema } from '../../lib/structuredData';
import { stripMarkdownForMeta, renderInline } from '../../lib/autolink';
import Infobox, { type InfoboxRow } from '../../components/Infobox.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import { formatHistoricalDate, dateQualifier } from '../../lib/historicalDate';
import { autolink, buildLinkRegistry, renderSummaryHtml } from '../../lib/autolink';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  return sources.map((s) => ({
    params: { slug: s.id },
    props: { source: s },
  }));
}

const { source } = Astro.props;
const d = source.data;

// Find claims that cite this source
const allClaims = await getCollection('claims');
const claimsCiting = allClaims.filter((c) =>
  c.data.sources.some((s: any) => s.source.id === source.id)
);

// ─── Build the citation digest ────────────────────────────────────────────────
// One entry per (claim, source-row) — surfaces passage_ref, passage_summary,
// passage_quote, and stance so the source page reads as a digest of what
// this source preserves about Carthaginian history rather than a bare list
// of claim statements.
type Citation = {
  claim: typeof claimsCiting[number];
  passage_ref?: string;
  passage_summary: string;
  passage_quote?: string;
  stance: 'supports' | 'contradicts' | 'qualifies';
};
const citations: Citation[] = claimsCiting.flatMap((c) =>
  c.data.sources
    .filter((s: any) => s.source.id === source.id)
    .map((s: any) => ({
      claim: c,
      passage_ref: s.passage_ref,
      passage_summary: s.passage_summary,
      passage_quote: s.passage_quote,
      stance: s.stance,
    }))
);

// Natural sort by passage_ref so "3.22" precedes "15.11" and entries flow
// in approximate textual order. Pad each numeric run so string compare
// works numerically. Missing refs sort to the end.
function naturalKey(ref: string | undefined): string {
  if (!ref) return '￿';
  return ref.replace(/\d+/g, (n) => n.padStart(6, '0'));
}
citations.sort((a, b) => naturalKey(a.passage_ref).localeCompare(naturalKey(b.passage_ref)));

// ─── Topic chips: entities this source's citations touch ──────────────────────
// Aggregate entity references across all citing claims, dedupe, resolve
// display labels. Capped to keep the chip cluster readable.
const TOPIC_COLLECTION: Record<string, string> = {
  event: 'events',
  person: 'people',
  place: 'places',
  institution: 'institutions',
  theme: 'themes',
  group: 'groups',
  deity: 'deities',
};
const topicSeen = new Set<string>();
const topicRefs: Array<{ type: string; slug: string }> = [];
for (const c of claimsCiting) {
  for (const e of (c.data.entities ?? []) as any[]) {
    if (!TOPIC_COLLECTION[e.type]) continue;
    const key = `${e.type}:${e.slug}`;
    if (topicSeen.has(key)) continue;
    topicSeen.add(key);
    topicRefs.push({ type: e.type, slug: e.slug });
  }
}
const topics = (
  await Promise.all(
    topicRefs.map(async (t) => {
      const collection = TOPIC_COLLECTION[t.type];
      const entry: any = await getEntry(collection as any, t.slug);
      if (!entry) return null;
      const label =
        entry.data.name_display ||
        entry.data.name ||
        entry.data.title ||
        t.slug;
      return {
        label,
        href: `/${collection}/${entry.id.replace(/\.md$/, '')}`,
      };
    })
  )
).filter(Boolean) as Array<{ label: string; href: string }>;
topics.sort((a, b) => a.label.localeCompare(b.label));

// Stance display config — symbol + tone color. Reuses the ✓/~/✗ glyph
// idiom from ClaimCard so readers learn it once.
const stanceStyle: Record<string, { symbol: string; label: string; cls: string }> = {
  supports: { symbol: '✓', label: 'supports', cls: 'text-emerald-700' },
  qualifies: { symbol: '~', label: 'qualifies', cls: 'text-amber-700' },
  contradicts: { symbol: '✗', label: 'contradicts', cls: 'text-rose-700' },
};

// Find events that list this source as a principal narrator
const allEvents = await getCollection('events');
const eventsUsingAsPrincipal = allEvents
  .filter((e) =>
    (e.data.principal_sources ?? []).some((s: any) => s.id === source.id)
  )
  .sort((a, b) => a.data.date_start.value - b.data.date_start.value);

// Auto-link registry
const allPeople = await getCollection('people');
const allPlaces = await getCollection('places');
const allInstitutions = await getCollection('institutions');
const allGroups = await getCollection('groups');
const allThemes = await getCollection('themes');
const allDeities = await getCollection('deities');
const allArtifacts = await getCollection('artifacts');
const linkRegistry = buildLinkRegistry({
  events: allEvents,
  people: allPeople,
  places: allPlaces,
  institutions: allInstitutions,
  groups: allGroups,
  themes: allThemes,
  deities: allDeities,
  artifacts: allArtifacts,
});
const summaryHtml = d.summary
  ? renderSummaryHtml(d.summary, linkRegistry, { excludeKey: `source:${source.id}` })
  : '';

// ─── Infobox derivations ─────────────────────────────────────────────────────
const typeLabel = d.type.replace('_', ' ');
const typeLabelCap = typeLabel.charAt(0).toUpperCase() + typeLabel.slice(1);

const accessLabel = d.access_to_witnesses
  ? d.access_to_witnesses.replace('_', ' ')
  : null;

const distanceText = d.temporal_distance_years
  ? `~${d.temporal_distance_years} years from events`
  : null;

const sourceInfoboxRows: InfoboxRow[] = [
  { label: 'Author', value: d.author ?? null },
  {
    label: 'Composed',
    value: formatHistoricalDate(d.date_composed),
    qualifier: dateQualifier(d.date_composed),
  },
  {
    label: 'Language',
    value: d.language.charAt(0).toUpperCase() + d.language.slice(1),
  },
  { label: 'Type', value: typeLabelCap },
  { label: 'Distance from events', value: distanceText },
  { label: 'Access', value: accessLabel },
  {
    label: 'Cited in',
    value: claimsCiting.length > 0
      ? `${claimsCiting.length} claim${claimsCiting.length === 1 ? '' : 's'}`
      : null,
    href: claimsCiting.length > 0 ? '#claims' : undefined,
    emptyLabel: 'none',
  },
];
---

<BaseLayout title={d.title} description={stripMarkdownForMeta(d.summary ?? '')} jsonld={sourceSchema(d, { description: stripMarkdownForMeta(d.summary ?? '') })}>
  <div class="max-w-5xl mx-auto px-6 py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-10 lg:items-start">
    <Infobox
      title={d.title}
      subtitle={d.is_primary ? `Primary source · ${typeLabel}` : `Modern scholarship · ${typeLabel}`}
      rows={sourceInfoboxRows}
    />
    <article class="lg:col-start-1 lg:row-start-1 min-w-0">
      <span hidden data-pagefind-filter="type:Sources" data-pagefind-meta="type:Source"></span>
    <p class="eyebrow mb-3">
      {d.is_primary ? 'Primary source' : 'Modern scholarship'} · {d.type.replace('_', ' ')}
    </p>
    <h1 class="font-serif text-4xl sm:text-5xl mb-3">{d.title}</h1>
    {d.author && <p class="text-xl text-sand-700 italic">{d.author}</p>}

    <div class="prose-encyclopedia mt-8 text-sand-900" set:html={summaryHtml} />

    {d.bias_notes && (
      <section class="mt-8 border-l-4 border-amber-300 bg-amber-50 p-5 rounded-r-lg">
        <h2 class="font-serif text-xl mb-2">Bias and reliability notes</h2>
        <p class="text-ink-900" set:html={renderInline(d.bias_notes)}></p>
      </section>
    )}

    {d.public_domain_translation && (
      <section class="mt-8">
        <h2 class="font-serif text-xl mb-2">Public-domain translation</h2>
        <p class="text-sm">
          <a href={d.public_domain_translation.url} class="text-tyrian-700 hover:underline" target="_blank" rel="noopener noreferrer">
            {d.public_domain_translation.translator} ({d.public_domain_translation.year}) — read at Perseus →
          </a>
        </p>
      </section>
    )}

    {eventsUsingAsPrincipal.length > 0 && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">Principal source for</h2>
        <ul class="space-y-2">
          {eventsUsingAsPrincipal.map((e) => (
            <li class="flex items-baseline gap-3">
              <span class="text-sm text-sand-700 shrink-0 tabular-nums w-20">
                {Math.abs(e.data.date_start.value)} BCE
              </span>
              <a href={`/events/${e.id}`} class="text-tyrian-700 hover:underline font-serif">
                {e.data.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {citations.length > 0 && (
      <section class="mt-12" id="claims">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-2">What this source preserves</h2>
        <p class="text-sm text-sand-700 mb-6">
          {citations.length} passage{citations.length === 1 ? '' : 's'} cited across the encyclopedia, in approximate textual order. Each entry is the encyclopedia's paraphrase of what the source says at the cited locus, with the claim it informs.
        </p>

        {topics.length > 0 && (
          <div class="mb-6">
            <p class="text-[11px] uppercase tracking-widest font-semibold text-sand-700 mb-2">Topics covered</p>
            <div class="flex flex-wrap gap-1.5">
              {topics.map((t) => (
                <a
                  href={t.href}
                  class="text-xs px-2 py-1 border border-sand-300 rounded-full text-sand-900 hover:border-tyrian-500 hover:text-tyrian-700 transition-colors"
                >
                  {t.label}
                </a>
              ))}
            </div>
          </div>
        )}

        <ol class="space-y-6">
          {citations.map((c) => {
            const stance = stanceStyle[c.stance] ?? stanceStyle.supports;
            return (
              <li class="border-l-2 border-tyrian-300 pl-4">
                <div class="flex items-baseline gap-3 flex-wrap">
                  <span class="font-mono text-sm text-tyrian-700 tabular-nums font-semibold">
                    {c.passage_ref ?? '— passage unspecified —'}
                  </span>
                  <span class={`text-xs ${stance.cls}`} title={`This source ${stance.label} the cited claim`}>
                    <span class="font-bold">{stance.symbol}</span> {stance.label}
                  </span>
                </div>
                <p class="mt-2 text-sand-900 leading-relaxed" set:html={renderInline(c.passage_summary)}></p>
                {c.passage_quote && (
                  <blockquote class="mt-3 border-l-2 border-sand-300 pl-3 italic text-sm text-sand-800">
                    &ldquo;{c.passage_quote}&rdquo;
                  </blockquote>
                )}
                <div class="mt-2 flex items-baseline gap-2 flex-wrap text-xs">
                  <span class="text-sand-700">On the claim:</span>
                  <a href={`/claims/${c.claim.id}`} class="text-tyrian-700 hover:underline" set:html={renderInline(c.claim.data.statement)}></a>
                  <ConfidenceBadge confidence={c.claim.data.confidence} size="xs" />
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    )}
    </article>
  </div>
</BaseLayout>
