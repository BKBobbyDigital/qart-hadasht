---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  return sources.map((s) => ({
    params: { slug: s.id },
    props: { source: s },
  }));
}

const { source } = Astro.props;
const d = source.data;

// Find claims that cite this source
const allClaims = await getCollection('claims');
const claimsCiting = allClaims.filter((c) =>
  c.data.sources.some((s: any) => s.source.id === source.id)
);
---

<BaseLayout title={d.title} description={d.summary}>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <p class="text-xs uppercase tracking-widest text-sand-700 mb-2">
      {d.is_primary ? 'Primary source' : 'Modern scholarship'} · {d.type.replace('_', ' ')}
    </p>
    <h1 class="font-serif text-4xl mb-2">{d.title}</h1>
    {d.author && <p class="text-xl text-sand-700 italic">{d.author}</p>}

    <div class="mt-6 grid sm:grid-cols-2 gap-4 text-sm">
      <div class="border border-sand-300 rounded p-4 bg-white/60">
        <h3 class="text-xs uppercase tracking-widest text-sand-700 font-semibold mb-2">Composition</h3>
        {d.date_composed && (
          <p>{d.date_composed.circa ? 'c. ' : ''}{Math.abs(d.date_composed.value)} {d.date_composed.value < 0 ? 'BCE' : 'CE'}</p>
        )}
        <p class="text-sand-700 capitalize">Language: {d.language}</p>
      </div>
      {d.access_to_witnesses && (
        <div class="border border-sand-300 rounded p-4 bg-white/60">
          <h3 class="text-xs uppercase tracking-widest text-sand-700 font-semibold mb-2">Reliability</h3>
          <p class="capitalize">{d.access_to_witnesses.replace('_', ' ')} access</p>
          {d.temporal_distance_years && (
            <p class="text-sand-700">~{d.temporal_distance_years} years from events</p>
          )}
        </div>
      )}
    </div>

    <div class="prose-encyclopedia mt-8 text-sand-900">
      <p>{d.summary}</p>
    </div>

    {d.bias_notes && (
      <section class="mt-8 border-l-4 border-amber-300 bg-amber-50 p-5 rounded-r-lg">
        <h2 class="font-serif text-xl mb-2">Bias and reliability notes</h2>
        <p class="text-sand-900">{d.bias_notes}</p>
      </section>
    )}

    {d.public_domain_translation && (
      <section class="mt-8">
        <h2 class="font-serif text-xl mb-2">Public-domain translation</h2>
        <p class="text-sm">
          <a href={d.public_domain_translation.url} class="text-tyrian-700 hover:underline" target="_blank" rel="noopener noreferrer">
            {d.public_domain_translation.translator} ({d.public_domain_translation.year}) — read at Perseus →
          </a>
        </p>
      </section>
    )}

    {claimsCiting.length > 0 && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">Claims citing this source</h2>
        <ul class="space-y-2">
          {claimsCiting.map((c) => {
            const citation = c.data.sources.find((s: any) => s.source.id === source.id);
            return (
              <li class="border border-sand-300 rounded p-3 text-sm">
                <p>{c.data.statement}</p>
                {citation?.passage_ref && (
                  <p class="text-sand-700 text-xs mt-1">Cited at {citation.passage_ref}</p>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
