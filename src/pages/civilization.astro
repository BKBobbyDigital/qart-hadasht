---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

const themes = (await getCollection('themes')).sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);
const institutions = (await getCollection('institutions')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);
const carthage = await getEntry('places', 'carthage');
const events = (await getCollection('events')).sort(
  (a, b) => a.data.date_start.value - b.data.date_start.value
);
const groups = (await getCollection('groups')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);
---

<BaseLayout title="Civilization" description="The civilization of Carthage: themes, institutions, the city, the events that shaped it.">
  <section class="bg-sand-100 border-b border-sand-300">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <p class="text-xs uppercase tracking-widest text-sand-700 mb-2">Hub</p>
      <h1 class="font-serif text-5xl leading-tight">Civilization</h1>
      <p class="mt-4 max-w-2xl text-lg text-sand-900">
        Carthage was a city, but Carthaginian civilization was more than a
        city. This page collects everything cross-cutting: the religion, the
        institutions, the themes that span every event and every place. Use
        it as a map of where to go.
      </p>
    </div>
  </section>

  {carthage && (
    <section class="max-w-5xl mx-auto px-6 py-10">
      <h2 class="font-serif text-2xl mb-4">The city</h2>
      <a href={`/places/${carthage.id}`} class="block p-5 border border-tyrian-300 bg-tyrian-50 rounded-lg hover:bg-tyrian-100">
        <h3 class="font-serif text-2xl text-tyrian-900">{carthage.data.name_display}</h3>
        <p class="font-phoenician text-tyrian-700 mt-1">{carthage.data.names_alt?.punic_script}</p>
        <p class="text-sand-900 mt-2 text-sm">{carthage.data.summary.slice(0, 320)}...</p>
      </a>
    </section>
  )}

  <section class="max-w-5xl mx-auto px-6 py-6">
    <h2 class="font-serif text-2xl mb-4">Themes</h2>
    <p class="text-sand-700 mb-5 text-sm">
      Cross-cutting topics: religion, daily life, language, trade, identity,
      the open questions of Carthaginian society.
    </p>
    {themes.length === 0 ? (
      <p class="text-sand-700 italic">No themes yet.</p>
    ) : (
      <ul class="grid sm:grid-cols-2 gap-3">
        {themes.map((t) => (
          <li>
            <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white">
              <h3 class="font-serif text-lg text-tyrian-700">{t.data.title}</h3>
              <p class="text-xs uppercase tracking-wider text-sand-700 mt-1">{t.data.scope.replace('_', ' ')}</p>
              <p class="text-sm text-sand-900 mt-2">{t.data.summary.slice(0, 180)}...</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="max-w-5xl mx-auto px-6 py-6">
    <h2 class="font-serif text-2xl mb-4">Institutions</h2>
    <p class="text-sand-700 mb-5 text-sm">
      Formal civic, political, and sacred bodies of Carthage.
    </p>
    {institutions.length === 0 ? (
      <p class="text-sand-700 italic">No institutions yet.</p>
    ) : (
      <ul class="grid sm:grid-cols-2 gap-3">
        {institutions.map((i) => (
          <li>
            <a href={`/institutions/${i.id}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white">
              <h3 class="font-serif text-lg text-tyrian-700">{i.data.name_display}</h3>
              <p class="text-xs uppercase tracking-wider text-sand-700 mt-1">{i.data.type}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  {groups.length > 0 && (
    <section class="max-w-5xl mx-auto px-6 py-6">
      <h2 class="font-serif text-2xl mb-4">Groups and peoples</h2>
      <ul class="grid sm:grid-cols-2 gap-3">
        {groups.map((g) => (
          <li>
            <a href={`/groups/${g.id}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white">
              <h3 class="font-serif text-lg text-tyrian-700">{g.data.name_display}</h3>
              <p class="text-xs uppercase tracking-wider text-sand-700 mt-1">{g.data.type.replace('_', ' ')}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="max-w-5xl mx-auto px-6 py-10">
    <h2 class="font-serif text-2xl mb-4">Events that shaped it</h2>
    <ul class="space-y-2">
      {events.map((e) => (
        <li class="flex items-baseline gap-3">
          <span class="text-sm text-sand-700 shrink-0 tabular-nums">
            {Math.abs(e.data.date_start.value)} BCE
          </span>
          <a href={`/events/${e.id}`} class="text-tyrian-700 hover:underline font-serif">
            {e.data.name}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
