---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexViewToggle from '../../components/IndexViewToggle.astro';
import TanitMark from '../../components/TanitMark.astro';
import { getCollection } from 'astro:content';

const places = (await getCollection('places')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);

// Reverse-lookup event count per place
const allEvents = await getCollection('events');
const eventsByPlace = new Map<string, number>();
for (const e of allEvents) {
  const ids = new Set<string>();
  if (e.data.place?.id) ids.add(e.data.place.id);
  for (const p of e.data.places ?? []) ids.add(p.id);
  for (const id of ids) eventsByPlace.set(id, (eventsByPlace.get(id) ?? 0) + 1);
}
---

<BaseLayout title="Places"
  description="The cities, colonies, battlefields, rivers, and regions of the Carthaginian world, from the African heartland across the western Mediterranean and Atlantic."
>
  <div class="max-w-6xl mx-auto px-6 py-12" data-view-container>
    <div class="flex items-baseline justify-between gap-4 mb-3">
      <h1 class="font-serif">Places</h1>
      <IndexViewToggle />
    </div>
    <p class="text-sand-700 mb-8 max-w-2xl">
      Cities, battlefields, sanctuaries, harbors, and regions across the
      Punic Mediterranean. Where the ancient identification is uncertain,
      multiple candidate locations are recorded.
    </p>

    <div data-view-cards>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {places.map((p) => (
          <li>
            <a
              href={`/places/${p.id}`}
              class="flex flex-col h-full border border-sand-300 bg-white/60 rounded-lg overflow-hidden hover:bg-sand-100 hover:border-tyrian-500 active:bg-tyrian-50 transition-colors"
            >
              {p.data.image ? (
                <div class="aspect-[4/3] bg-sand-100 overflow-hidden">
                  <img
                    src={p.data.image.src}
                    alt={p.data.image.alt}
                    loading="lazy"
                    class="w-full h-full object-cover"
                  />
                </div>
              ) : (
                <div class="aspect-[4/3] bg-sand-100 flex items-center justify-center text-tyrian-700/30">
                  <TanitMark size={48} />
                </div>
              )}
              <div class="p-4 flex flex-col flex-1">
                <p class="text-[10px] uppercase tracking-widest font-semibold text-sand-700">{p.data.type}</p>
                <h2 class="font-serif text-lg text-ink-900 mt-1 leading-tight">{p.data.name_display}</h2>
                {p.data.modern_location && (
                  <p class="text-xs text-sand-700 mt-1.5 leading-snug">{p.data.modern_location}</p>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div data-view-table class="overflow-x-auto">
      <table data-sortable class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-sand-300 bg-sand-50">
            <th data-sort-key="name" data-sort-active="asc" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Name</th>
            <th data-sort-key="type" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Type</th>
            <th data-sort-key="modern" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Modern location</th>
            <th data-sort-key="events" class="text-right font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Events</th>
          </tr>
        </thead>
        <tbody>
          {places.map((p) => (
            <tr
              class="border-b border-sand-200 hover:bg-sand-100 active:bg-tyrian-50 transition-colors"
              data-sort-name={p.data.name_display}
              data-sort-type={p.data.type}
              data-sort-modern={p.data.modern_location ?? ''}
              data-sort-events={eventsByPlace.get(p.id) ?? 0}
            >
              <td class="px-3 py-2"><a href={`/places/${p.id}`} class="font-serif text-tyrian-700 hover:underline">{p.data.name_display}</a></td>
              <td class="px-3 py-2 text-sand-900 capitalize">{p.data.type}</td>
              <td class="px-3 py-2 text-sand-700">{p.data.modern_location ?? ''}</td>
              <td class="px-3 py-2 text-right text-sand-700 tabular-nums">{eventsByPlace.get(p.id) || ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</BaseLayout>
