---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Map from '../../components/Map.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const places = await getCollection('places');
  return places.map((p) => ({
    params: { slug: p.id },
    props: { place: p },
  }));
}

const { place } = Astro.props;
const d = place.data;

// Reverse lookup: events whose primary place or places includes this place
const allEvents = await getCollection('events');
const eventsHere = allEvents
  .filter((e) =>
    e.data.place?.id === place.id ||
    (e.data.places ?? []).some((p: any) => p.id === place.id)
  )
  .sort((a, b) => a.data.date_start.value - b.data.date_start.value);

// Build the points array for the map. Include candidates if present, otherwise primary.
type MapPoint = { label: string; lat: number; lon: number; confidence?: string; notes?: string; marker_kind?: string };
let mapPoints: MapPoint[] = [];
let mapCaption = '';
if (d.candidates && d.candidates.length > 0) {
  mapPoints = d.candidates.map((c: any) => ({
    label: c.label,
    lat: c.lat,
    lon: c.lon,
    confidence: c.confidence,
    notes: c.notes,
    marker_kind: 'subject',
  }));
  mapCaption = 'Candidate locations. Marker color reflects scholarly confidence in each identification.';
} else if (d.primary) {
  mapPoints = [{
    label: d.primary.label,
    lat: d.primary.lat,
    lon: d.primary.lon,
    confidence: d.primary.confidence,
    notes: d.primary.notes,
    marker_kind: 'subject',
  }];
}

// For battlefields with candidates, optionally add Carthage as a geographic reference point.
if (d.candidates && d.candidates.length > 0 && place.id !== 'carthage') {
  const allPlaces = await getCollection('places');
  const carthage = allPlaces.find((p) => p.id === 'carthage');
  if (carthage?.data.primary) {
    mapPoints.push({
      label: 'Carthage (reference)',
      lat: carthage.data.primary.lat,
      lon: carthage.data.primary.lon,
      marker_kind: 'reference',
    });
  }
}
---

<BaseLayout title={d.name_display} description={d.summary}>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <p class="text-xs uppercase tracking-widest text-sand-700 mb-2">{d.type}</p>
    <h1 class="font-serif text-4xl mb-3">{d.name_display}</h1>
    {d.modern_location && <p class="text-sand-700">Modern: {d.modern_location}</p>}

    {d.names_alt && (
      <section class="mt-8 border border-sand-300 rounded-lg p-5 bg-white/60">
        <h2 class="font-serif text-xl mb-3">Names</h2>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
          {d.names_alt.punic && (<><dt class="font-semibold text-sand-700">Punic</dt><dd>{d.names_alt.punic} {d.names_alt.punic_script && <span class="font-phoenician text-tyrian-700 ml-2">{d.names_alt.punic_script}</span>}</dd></>)}
          {d.names_alt.greek && (<><dt class="font-semibold text-sand-700">Greek</dt><dd>{d.names_alt.greek}</dd></>)}
          {d.names_alt.latin && (<><dt class="font-semibold text-sand-700">Latin</dt><dd>{d.names_alt.latin}</dd></>)}
          {d.names_alt.modern && (<><dt class="font-semibold text-sand-700">Modern</dt><dd>{d.names_alt.modern}</dd></>)}
        </dl>
      </section>
    )}

    <div class="prose-encyclopedia mt-8 text-lg text-sand-900">
      <p>{d.summary}</p>
    </div>

    {mapPoints.length > 0 && (
      <>
        <Map points={mapPoints} caption={mapCaption} />
        {d.candidates && d.candidates.length > 0 && (
          <div class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-sand-700 -mt-3 mb-2">
            <span class="flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-full bg-emerald-800 border-2 border-white shadow-sm"></span> certain</span>
            <span class="flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-full bg-green-700 border-2 border-white shadow-sm"></span> probable</span>
            <span class="flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-full bg-amber-700 border-2 border-white shadow-sm"></span> possible</span>
            <span class="flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-full bg-gray-500 border-2 border-white shadow-sm"></span> speculative</span>
            <span class="flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded-full bg-tyrian-700 border-2 border-white shadow-sm opacity-60"></span> reference</span>
          </div>
        )}
      </>
    )}

    {eventsHere.length > 0 && (
      <section class="mt-12 pt-6 border-t border-sand-300">
        <h2 class="font-serif text-2xl mb-3">Events here</h2>
        <ul class="space-y-2">
          {eventsHere.map((e) => (
            <li class="flex items-baseline gap-3">
              <span class="text-sm text-sand-700 shrink-0 tabular-nums w-20">
                {Math.abs(e.data.date_start.value)} BCE
              </span>
              <a href={`/events/${e.id}`} class="text-tyrian-700 hover:underline font-serif">
                {e.data.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.candidates && d.candidates.length > 0 && (
      <section class="mt-8">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">Candidate locations</h2>
        <p class="text-sm text-sand-700 mb-4">
          The location of this place is contested. The candidates below reflect
          the main proposals in the textual and archaeological evidence.
        </p>
        <ul class="space-y-3">
          {d.candidates.map((c: any) => (
            <li class="border border-sand-300 rounded-lg p-4">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-serif text-lg">{c.label}</h3>
                <span class="text-xs uppercase tracking-wider text-sand-700">{c.confidence}</span>
              </div>
              <p class="text-xs text-sand-700 mt-1">{c.lat.toFixed(4)}, {c.lon.toFixed(4)}</p>
              {c.notes && <p class="text-sm mt-2 text-sand-900">{c.notes}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
