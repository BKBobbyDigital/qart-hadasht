---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleSchema } from '../../lib/structuredData';
import { stripMarkdownForMeta, renderInline } from '../../lib/autolink';
import ClaimCard from '../../components/ClaimCard.astro';
import EditorialTake from '../../components/EditorialTake.astro';
import Map from '../../components/Map.astro';
import HistoricalMap from '../../components/HistoricalMap.astro';
import BattleDiagram from '../../components/BattleDiagram.astro';
import type { BattleDiagramConfig } from '../../lib/battleDiagram';
import Infobox, { type InfoboxRow, type InfoboxLink } from '../../components/Infobox.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import Bibliography from '../../components/Bibliography.astro';
import MaterialEvidence from '../../components/MaterialEvidence.astro';
import { formatHistoricalDate, formatDateRange, dateQualifier } from '../../lib/historicalDate';
import { autolink, buildLinkRegistry, renderSummaryHtml } from '../../lib/autolink';
import { getCollection, getEntry } from 'astro:content';

// Eagerly import every map config under src/data/maps/*.json so the
// event frontmatter `map_id` field can resolve at build time.
const mapModules = import.meta.glob('../../data/maps/*.json', { eager: true });
const mapConfigs: Record<string, any> = {};
for (const [path, mod] of Object.entries(mapModules)) {
  const stem = path.split('/').pop()!.replace(/\.json$/, '');
  mapConfigs[stem] = (mod as any).default ?? mod;
}

// Eagerly import every battle diagram config under src/data/battles/*.ts.
// The event render route auto-detects a config matching the event slug
// and embeds the diagram, no per-slug check.
const battleModules = import.meta.glob('../../data/battles/*.ts', { eager: true });
const battleConfigs: Record<string, BattleDiagramConfig> = {};
for (const [path, mod] of Object.entries(battleModules)) {
  const stem = path.split('/').pop()!.replace(/\.ts$/, '');
  battleConfigs[stem] = (mod as any).default;
}

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const data = event.data;

// Resolve participants
const participants = await Promise.all(
  data.participants.map(async (p: any) => {
    const person = await getEntry('people', p.person.id);
    return { ...p, personData: person?.data };
  })
);

// Find claims that reference this event
const allClaims = await getCollection('claims');
const relatedClaims = allClaims.filter((c) =>
  c.data.entities?.some((e) => e.type === 'event' && e.slug === event.id)
);

// Material evidence: artifacts co-referenced with this event in any
// of the related claims.
const allArtifacts = await getCollection('artifacts');
const artifactSlugs = new Set<string>();
for (const c of relatedClaims) {
  for (const e of (c.data.entities ?? []) as any[]) {
    if (e.type === 'artifact') artifactSlugs.add(e.slug);
  }
}
const materialEvidence = allArtifacts.filter((a) => artifactSlugs.has(a.id));

// Find editorial takes referencing this event
const allTakes = await getCollection('editorialTakes');
const relatedTakes = allTakes.filter((t) =>
  t.data.subject_entity?.type === 'event' && t.data.subject_entity?.slug === event.id
);

// Find open questions referencing this event
const allQuestions = await getCollection('openQuestions');
const relatedQuestions = allQuestions.filter((q) =>
  q.data.relevant_entities?.some((e: any) => e.type === 'event' && e.slug === event.id)
);

// Find a narrative whose primary subject is this event
const allNarratives = await getCollection('narratives');
const matchingNarrative = allNarratives.find((n) =>
  n.data.primary_entities?.some((e: any) => e.type === 'event' && e.slug === event.id)
);

// Find source comparisons whose subject is this event
const allComparisons = await getCollection('sourceComparisons');
const relatedComparisons = allComparisons.filter((c: any) =>
  c.data.subject_event?.id === event.id
);

// Causal links — what this event caused, and what caused it
const allCausalLinks = await getCollection('causalLinks');
const causedByLinks = allCausalLinks.filter((l) => l.data.effect.id === event.id);
const ledToLinks = allCausalLinks.filter((l) => l.data.cause.id === event.id);

const resolveLinkedEvent = async (slug: string) => {
  return await getEntry('events', slug);
};
const causedByResolved = await Promise.all(
  causedByLinks.map(async (l) => ({ link: l, event: await resolveLinkedEvent(l.data.cause.id) }))
);
const ledToResolved = await Promise.all(
  ledToLinks.map(async (l) => ({ link: l, event: await resolveLinkedEvent(l.data.effect.id) }))
);

// Related events — bidirectional. This event's own list, plus reverse lookups
// from any other event that references this one.
const allEvents = await getCollection('events');
type RelatedEntry = { event: any; relation: string; notes?: string };
const relatedDirect: RelatedEntry[] = await Promise.all(
  (data.related_events ?? []).map(async (r: any) => ({
    event: await getEntry('events', r.event.id),
    relation: r.relation,
    notes: r.notes,
  }))
);
const relatedReverse: RelatedEntry[] = allEvents
  .filter((e) => e.id !== event.id)
  .flatMap((e) =>
    (e.data.related_events ?? [])
      .filter((r: any) => r.event.id === event.id)
      .map((r: any) => ({ event: e, relation: r.relation, notes: r.notes }))
  );
// Dedupe (a forward + reverse pair to the same target should count once)
const relatedSeen = new Set<string>();
const relatedAll: RelatedEntry[] = [...relatedDirect, ...relatedReverse].filter((r) => {
  if (!r.event) return false;
  if (relatedSeen.has(r.event.id)) return false;
  relatedSeen.add(r.event.id);
  return true;
});

// Resolve referenced institutions and themes
const referencedInstitutions = await Promise.all(
  (data.referenced_institutions ?? []).map(async (ref: any) => await getEntry('institutions', ref.id))
);
const referencedThemes = await Promise.all(
  (data.referenced_themes ?? []).map(async (ref: any) => await getEntry('themes', ref.id))
);

const hasContext =
  causedByResolved.length > 0 ||
  ledToResolved.length > 0 ||
  relatedAll.length > 0 ||
  referencedInstitutions.filter(Boolean).length > 0 ||
  referencedThemes.filter(Boolean).length > 0;

// Resolve place
const place = data.place ? await getEntry('places', data.place.id) : null;

// Build map points for the event's geographic context
type MapPoint = { label: string; lat: number; lon: number; confidence?: string; notes?: string; marker_kind?: string };
const eventMapPoints: MapPoint[] = [];
if (place) {
  const pd = place.data;
  if (pd.candidates && pd.candidates.length > 0) {
    pd.candidates.forEach((c: any) => eventMapPoints.push({
      label: c.label,
      lat: c.lat,
      lon: c.lon,
      confidence: c.confidence,
      notes: c.notes,
      marker_kind: 'subject',
    }));
  } else if (pd.primary) {
    eventMapPoints.push({
      label: pd.name_display,
      lat: pd.primary.lat,
      lon: pd.primary.lon,
      confidence: pd.primary.confidence,
      marker_kind: 'subject',
    });
  }
}
// Add Carthage as reference if event is not at Carthage itself
if (eventMapPoints.length > 0 && place?.id !== 'carthage') {
  const allPlaces = await getCollection('places');
  const carthage = allPlaces.find((p) => p.id === 'carthage');
  if (carthage?.data.primary) {
    eventMapPoints.push({
      label: 'Carthage (reference)',
      lat: carthage.data.primary.lat,
      lon: carthage.data.primary.lon,
      marker_kind: 'reference',
    });
  }
}

// Format date
const year = Math.abs(data.date_start.value);
const era = data.date_start.value < 0 ? 'BCE' : 'CE';

// ─── Infobox derivations ─────────────────────────────────────────────────────
const dateText = formatDateRange(data.date_start, data.date_end);
const dateQual = dateQualifier(data.date_start);

// Belligerents — distinct sides among participants
const sides = Array.from(
  new Set(
    (data.participants ?? [])
      .map((p: any) => p.side)
      .filter((s: string | undefined): s is string => Boolean(s))
  )
);
const belligerents: InfoboxLink[] = sides.map((s) => ({ text: s }));

// Commanders — participants whose role contains "commander" or "general"
const commanderRoles = /command|general|leader|admiral|consul|suffete|king/i;
const commanderEntries: InfoboxLink[] = participants
  .filter((p: any) => commanderRoles.test(p.role) && p.personData)
  .map((p: any) => ({
    text: p.personData.name_display,
    href: `/people/${p.person.id}`,
  }));

// Parent war — any event of type 'war' whose related_events references this one
const parentWar = allEvents.find(
  (e) =>
    e.id !== event.id &&
    e.data.type === 'war' &&
    (e.data.related_events ?? []).some((r: any) => r.event.id === event.id)
);
const partOfLink: InfoboxLink[] = parentWar
  ? [{ text: parentWar.data.name, href: `/events/${parentWar.id}` }]
  : [];

// Sources cited count — distinct source ids from claims about this event,
// plus principal_sources declared on the event itself
const sourceIds = new Set<string>();
(data.principal_sources ?? []).forEach((s: any) => sourceIds.add(s.id));
relatedClaims.forEach((c) =>
  (c.data.sources ?? []).forEach((s: any) => sourceIds.add(s.source.id))
);
const sourcesCount = sourceIds.size;

// ─── Auto-link registry for the summary prose ───────────────────────────────
const allPeople = await getCollection('people');
const allPlaces = await getCollection('places');
const allInstitutions = await getCollection('institutions');
const allGroups = await getCollection('groups');
const allThemes = await getCollection('themes');
const allDeities = await getCollection('deities');
const linkRegistry = buildLinkRegistry({
  events: allEvents,
  people: allPeople,
  places: allPlaces,
  institutions: allInstitutions,
  groups: allGroups,
  themes: allThemes,
  deities: allDeities,
  artifacts: allArtifacts,
});
const summaryHtml = renderSummaryHtml(data.summary, linkRegistry, {
  excludeKey: `event:${event.id}`,
});

// Resolve source entries for the Sources cited section
const sourcesCited = (
  await Promise.all(
    Array.from(sourceIds).map(async (id) => await getEntry('sources', id))
  )
)
  .filter(Boolean)
  .sort((a: any, b: any) => a!.data.title.localeCompare(b!.data.title));

// Type label, capitalized
const typeLabel = data.type.charAt(0).toUpperCase() + data.type.slice(1);

// War-type events are themselves the top of the war hierarchy — the "Part of"
// row would always read "unknown" and that's misleading. Skip for wars.
// Also skip when no parent war is found at all (i.e., the event is genuinely
// standalone — a treaty, founding, etc. with no parent war association).
const isTopLevelWar = data.type === 'war';
const showPartOf = !isTopLevelWar && partOfLink.length > 0;

// Belligerents and Commanders only apply to military-type events. For
// treaties, foundings, political, cultural, disaster events the concept
// doesn't fit and rendering "unknown" is misleading.
const militaryTypes = new Set(['battle', 'siege', 'war', 'expedition']);
const isMilitary = militaryTypes.has(data.type);

const infoboxRows: InfoboxRow[] = [
  {
    label: 'Date',
    value: dateText,
    qualifier: dateQual,
  },
  {
    label: 'Type',
    value: typeLabel,
  },
  {
    label: 'Location',
    value: place
      ? [{ text: place.data.name_display, href: `/places/${place.id}` }]
      : [],
  },
  ...(isMilitary
    ? [
        { label: 'Belligerents', value: belligerents } as InfoboxRow,
        { label: 'Commanders', value: commanderEntries } as InfoboxRow,
      ]
    : []),
  ...(data.outcome
    ? [{ label: 'Outcome', value: data.outcome } as InfoboxRow]
    : []),
  ...(showPartOf
    ? [{
        label: 'Part of',
        value: partOfLink,
      } as InfoboxRow]
    : []),
  {
    label: 'Sources cited',
    value: sourcesCount > 0 ? `${sourcesCount}` : null,
    href: sourcesCount > 0 ? '#bibliography' : undefined,
    emptyLabel: 'none',
  },
];
---

<BaseLayout title={data.name} description={stripMarkdownForMeta(data.summary)} jsonld={articleSchema(data.name, data, { description: stripMarkdownForMeta(data.summary) })}>
  <div class="max-w-5xl mx-auto px-6 py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-10 lg:items-start">
    <Infobox
      title={data.name}
      subtitle={`${typeLabel} · ${year} ${era}`}
      rows={infoboxRows}
    />
    <article class="lg:col-start-1 lg:row-start-1 min-w-0">
      <span hidden data-pagefind-filter="type:Events" data-pagefind-meta="type:Event"></span>
    <p class="eyebrow mb-3">{data.type}</p>
    <h1 class="font-serif mb-3">{data.name}</h1>
    <p class="text-lg text-sand-700">
      {year} {era}
      {place && (
        <>
          · <a href={`/places/${place.id}`} class="text-tyrian-700 hover:underline">{place.data.name_display}</a>
        </>
      )}
    </p>

    <div class="prose-encyclopedia mt-6 text-lg text-sand-900" set:html={summaryHtml} />

    {data.map_id && mapConfigs[data.map_id] && (
      <HistoricalMap
        config={mapConfigs[data.map_id]}
        caption={data.map_caption}
      />
    )}

    {!data.map_id && eventMapPoints.length > 0 && (
      <Map
        points={eventMapPoints}
        height="320px"
        caption={place?.data.candidates && place.data.candidates.length > 0
          ? `The location of this event is contested — candidate sites are shown along with Carthage as a geographic reference.`
          : undefined}
      />
    )}

    {battleConfigs[event.id] && (
      <BattleDiagram config={battleConfigs[event.id]} idPrefix={event.id} />
    )}

    {hasContext && (
      <section class="mt-8">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">Context</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {causedByResolved.length > 0 && (
            <div class="border border-sand-300 rounded-lg p-4 bg-sand-50">
              <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">Caused by</h3>
              <ul class="space-y-2 text-sm">
                {causedByResolved.map((r: any) => r.event && (
                  <li>
                    <a href={`/events/${r.event.id}`} class="font-serif text-tyrian-700 hover:underline">{r.event.data.name}</a>
                    <p class="text-xs text-sand-700 mt-0.5">{r.link.data.relation}</p>
                    <div class="mt-1"><ConfidenceBadge confidence={r.link.data.confidence} size="xs" /></div>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {ledToResolved.length > 0 && (
            <div class="border border-sand-300 rounded-lg p-4 bg-sand-50">
              <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">Led to</h3>
              <ul class="space-y-2 text-sm">
                {ledToResolved.map((r: any) => r.event && (
                  <li>
                    <a href={`/events/${r.event.id}`} class="font-serif text-tyrian-700 hover:underline">{r.event.data.name}</a>
                    <p class="text-xs text-sand-700 mt-0.5">{r.link.data.relation}</p>
                    <div class="mt-1"><ConfidenceBadge confidence={r.link.data.confidence} size="xs" /></div>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {referencedInstitutions.filter(Boolean).length > 0 && (
            <div class="border border-sand-300 rounded-lg p-4 bg-sand-50">
              <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">Institutions</h3>
              <ul class="space-y-2 text-sm">
                {referencedInstitutions.filter(Boolean).map((i: any) => (
                  <li>
                    <a href={`/institutions/${i.id}`} class="font-serif text-tyrian-700 hover:underline">{i.data.name_display}</a>
                    <p class="text-xs text-sand-700 mt-0.5">{i.data.type}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {referencedThemes.filter(Boolean).length > 0 && (
            <div class="border border-sand-300 rounded-lg p-4 bg-sand-50">
              <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">Themes</h3>
              <ul class="space-y-2 text-sm">
                {referencedThemes.filter(Boolean).map((t: any) => (
                  <li>
                    <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="font-serif text-tyrian-700 hover:underline">{t.data.title}</a>
                    <p class="text-xs text-sand-700 mt-0.5">{t.data.scope.replace('_', ' ')}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {relatedAll.length > 0 && (
            <div class="border border-sand-300 rounded-lg p-4 bg-sand-50">
              <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">Related events</h3>
              <ul class="space-y-2 text-sm">
                {relatedAll.map((r) => (
                  <li>
                    <a href={`/events/${r.event.id}`} class="font-serif text-tyrian-700 hover:underline">{r.event.data.name}</a>
                    <p class="text-xs text-sand-700 mt-0.5">{r.relation}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    {matchingNarrative && (
      <a href={`/narratives/${matchingNarrative.id.replace(/\.md$/, '')}`} class="block mt-6 p-4 border border-tyrian-300 bg-sand-50 rounded-lg hover:bg-tyrian-50 transition-colors">
        <p class="text-[11px] uppercase tracking-widest font-bold text-tyrian-700">Read the full narrative →</p>
        <p class="font-serif text-lg text-tyrian-900 mt-1">{matchingNarrative.data.title}</p>
        <p class="text-sm text-sand-900 mt-1" set:html={renderInline(matchingNarrative.data.thesis)}></p>
      </a>
    )}

    {relatedComparisons.map((c: any) => (
      <a href={`/sourceComparisons/${c.id}`} class="block mt-4 p-4 border border-tyrian-300 bg-sand-50 rounded-lg hover:bg-tyrian-50 transition-colors">
        <p class="text-[11px] uppercase tracking-widest font-bold text-tyrian-700">Compare the ancient sources →</p>
        <p class="font-serif text-lg text-tyrian-900 mt-1">{c.data.title}</p>
        <p class="text-xs text-sand-700 mt-1">{c.data.source_passages.length} sources in parallel</p>
      </a>
    ))}

    {participants.length > 0 && (
      <section class="mt-10">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">Participants</h2>
        <ul class="grid sm:grid-cols-2 gap-3">
          {participants.map((p: any) => (
            <li class="border border-sand-300 rounded p-3">
              <a href={`/people/${p.person.id}`} class="font-medium text-tyrian-700 hover:underline">
                {p.personData?.name_display}
              </a>
              <p class="text-xs text-sand-700 mt-1">{p.role} · {p.side}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedClaims.length > 0 && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">What we know</h2>
        <p class="text-sm text-sand-700 mb-4">
          Each claim below is tagged with its epistemic confidence and linked to the
          ancient and modern sources that support, qualify, or contradict it.
        </p>
        {relatedClaims.map((c) => <ClaimCard claim={c} />)}
      </section>
    )}

    {relatedTakes.length > 0 && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">Editorial</h2>
        {relatedTakes.map((t) => <EditorialTake take={t} />)}
      </section>
    )}

    {relatedQuestions.length > 0 && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">Open questions</h2>
        <ul class="space-y-3">
          {relatedQuestions.map((q) => (
            <li class="border border-amber-200 bg-amber-50 rounded p-4">
              <h3 class="font-serif text-lg text-amber-900">{q.data.question}</h3>
              <p class="text-sm text-ink-900 mt-2" set:html={renderInline(q.data.why_unknown)}></p>
            </li>
          ))}
        </ul>
      </section>
    )}
    <MaterialEvidence artifacts={materialEvidence} />

    <Bibliography
      claims={relatedClaims}
      principalSourceIds={(data.principal_sources ?? []).map((s: any) => s.id)}
    />
    </article>
  </div>
</BaseLayout>
