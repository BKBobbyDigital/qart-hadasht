---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const groups = await getCollection('groups');
  return groups.map((g) => ({
    params: { slug: g.id },
    props: { group: g },
  }));
}

const { group } = Astro.props;
const d = group.data;

const fmtDate = (date: any) => {
  if (!date) return null;
  const year = Math.abs(date.value);
  const era = date.value < 0 ? 'BCE' : 'CE';
  return `${date.circa ? 'c. ' : ''}${year} ${era}`;
};
---

<BaseLayout title={d.name_display} description={d.summary}>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <p class="text-xs uppercase tracking-widest text-sand-700 mb-2">Group · {d.type.replace('_', ' ')}</p>
    <h1 class="font-serif text-4xl mb-2">{d.name_display}</h1>
    <p class="text-sand-700">
      {d.active_from && <>active {fmtDate(d.active_from)}</>}
      {d.active_from && d.active_to && <> – {fmtDate(d.active_to)}</>}
      {d.polity_affiliation && <> · {d.polity_affiliation}</>}
    </p>

    {d.name_alt && (
      <section class="mt-8 border border-sand-300 rounded-lg p-5 bg-white/60">
        <h2 class="font-serif text-xl mb-3">Names</h2>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
          {d.name_alt.greek && (<><dt class="font-semibold text-sand-700">Greek</dt><dd>{d.name_alt.greek}</dd></>)}
          {d.name_alt.latin && (<><dt class="font-semibold text-sand-700">Latin</dt><dd>{d.name_alt.latin}</dd></>)}
          {d.name_alt.punic && (<><dt class="font-semibold text-sand-700">Punic</dt><dd>{d.name_alt.punic}</dd></>)}
          {d.name_alt.modern && (<><dt class="font-semibold text-sand-700">Modern</dt><dd>{d.name_alt.modern}</dd></>)}
        </dl>
      </section>
    )}

    <div class="prose-encyclopedia mt-8 text-lg text-sand-900">
      <p>{d.summary}</p>
    </div>
  </article>
</BaseLayout>
