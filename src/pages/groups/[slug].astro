---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Infobox, { type InfoboxRow } from '../../components/Infobox.astro';
import Bibliography from '../../components/Bibliography.astro';
import MaterialEvidence from '../../components/MaterialEvidence.astro';
import { formatDateRange, dateQualifier } from '../../lib/historicalDate';
import { autolink, buildLinkRegistry } from '../../lib/autolink';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const groups = await getCollection('groups');
  return groups.map((g) => ({
    params: { slug: g.id },
    props: { group: g },
  }));
}

const { group } = Astro.props;
const d = group.data;

// Auto-link registry
const allEvents = await getCollection('events');
const allPeople = await getCollection('people');
const allPlaces = await getCollection('places');
const allInstitutions = await getCollection('institutions');
const allGroups = await getCollection('groups');
const allThemes = await getCollection('themes');
const allDeities = await getCollection('deities');
const allArtifacts = await getCollection('artifacts');
const linkRegistry = buildLinkRegistry({
  events: allEvents,
  people: allPeople,
  places: allPlaces,
  institutions: allInstitutions,
  groups: allGroups,
  themes: allThemes,
  deities: allDeities,
  artifacts: allArtifacts,
});
const summaryHtml = autolink(d.summary, linkRegistry, {
  excludeKey: `group:${group.id}`,
});

// Reverse lookup: claims that reference this group via the entities array
const allClaims = await getCollection('claims');
const referencingClaims = allClaims.filter((c) =>
  (c.data.entities ?? []).some((e: any) => e.type === 'group' && e.slug === group.id)
);

// Material evidence: artifacts co-referenced with this group in any
// of the referencing claims. (allArtifacts already loaded above.)
const artifactSlugs = new Set<string>();
for (const c of referencingClaims) {
  for (const e of (c.data.entities ?? []) as any[]) {
    if (e.type === 'artifact') artifactSlugs.add(e.slug);
  }
}
const materialEvidence = allArtifacts.filter((a) => artifactSlugs.has(a.id));

const typeLabel = d.type.replace('_', ' ');
const typeLabelCap = typeLabel.charAt(0).toUpperCase() + typeLabel.slice(1);
const activeText = formatDateRange(d.active_from, d.active_to);
const activeQual = dateQualifier(d.active_from);

const groupInfoboxRows: InfoboxRow[] = [
  { label: 'Type', value: typeLabelCap },
  { label: 'Affiliation', value: d.polity_affiliation ?? null },
  { label: 'Active', value: activeText, qualifier: activeQual },
];
---

<BaseLayout title={d.name_display} description={d.summary}>
  <div class="max-w-5xl mx-auto px-6 py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-10 lg:items-start">
    <Infobox
      title={d.name_display}
      subtitle={`Group · ${typeLabel}`}
      rows={groupInfoboxRows}
    />
    <article class="lg:col-start-1 lg:row-start-1 min-w-0">
      <span hidden data-pagefind-filter="type:Groups" data-pagefind-meta="type:Group"></span>
    <p class="eyebrow mb-3">Group · {d.type.replace('_', ' ')}</p>
    <h1 class="font-serif text-4xl sm:text-5xl mb-3">{d.name_display}</h1>
    {(activeText || d.polity_affiliation) && (
      <p class="text-sand-700">
        {activeText && <>active {activeText}</>}
        {activeText && d.polity_affiliation && <> · </>}
        {d.polity_affiliation}
      </p>
    )}

    {d.name_alt && (
      <section class="mt-8 border border-sand-300 rounded-lg p-5 bg-white/60">
        <h2 class="font-serif text-xl mb-3">Names</h2>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
          {d.name_alt.greek && (<><dt class="font-semibold text-sand-700">Greek</dt><dd>{d.name_alt.greek}</dd></>)}
          {d.name_alt.latin && (<><dt class="font-semibold text-sand-700">Latin</dt><dd>{d.name_alt.latin}</dd></>)}
          {d.name_alt.punic && (<><dt class="font-semibold text-sand-700">Punic</dt><dd>{d.name_alt.punic}</dd></>)}
          {d.name_alt.modern && (<><dt class="font-semibold text-sand-700">Modern</dt><dd>{d.name_alt.modern}</dd></>)}
        </dl>
      </section>
    )}

    <div class="prose-encyclopedia mt-8 text-lg text-sand-900">
      <p set:html={summaryHtml} />
    </div>

    <MaterialEvidence artifacts={materialEvidence} />

    <Bibliography claims={referencingClaims} />
    </article>
  </div>
</BaseLayout>
