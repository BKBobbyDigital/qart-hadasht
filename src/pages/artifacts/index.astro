---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TanitMark from '../../components/TanitMark.astro';
import { getCollection } from 'astro:content';

const artifacts = (await getCollection('artifacts')).sort((a, b) =>
  a.data.name_display.localeCompare(b.data.name_display)
);

const typeLabel: Record<string, string> = {
  statuary: 'Statuary',
  inscription: 'Inscription',
  stele: 'Stele',
  coin: 'Coin',
  vessel: 'Vessel',
  architecture: 'Architecture',
  sarcophagus: 'Sarcophagus',
  shipwreck: 'Shipwreck',
  metalwork: 'Metalwork',
  jewelry: 'Jewelry',
  mosaic: 'Mosaic',
  composite: 'Composite',
};
---

<BaseLayout
  title="Artifacts"
  description="Material culture as first-class evidence — inscriptions, stelae, statuary, coins, ships, and architectural finds from the Carthaginian-Punic world."
>
  <div class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="font-serif mb-3">Artifacts</h1>
    <p class="text-sand-700 mb-8 max-w-2xl">
      Material culture as first-class evidence. Modern Punic studies has shifted
      decisively toward the archaeological record over the last half-century —
      the Tophet bioarchaeology, Quinn's reframing of Phoenician identity, the
      long arc of Moscati and Lancel — because the surviving literary tradition
      is so heavily weighted toward Carthage's enemies. The artifacts below are
      the principal pieces of material evidence the encyclopedia draws on.
    </p>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {artifacts.map((a) => (
        <li>
          <a
            href={`/artifacts/${a.id}`}
            class="flex flex-col h-full border border-sand-300 bg-sand-50 rounded-lg overflow-hidden hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors"
          >
            {a.data.image ? (
              <div class="aspect-[4/3] bg-sand-100 overflow-hidden">
                <img
                  src={a.data.image.src}
                  alt={a.data.image.alt}
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </div>
            ) : (
              <div class="aspect-[4/3] bg-sand-100 flex items-center justify-center text-tyrian-700/30">
                <TanitMark size={48} />
              </div>
            )}
            <div class="p-4 flex flex-col flex-1">
              <p class="text-[10px] uppercase tracking-widest font-semibold text-sand-700">
                {typeLabel[a.data.type] ?? a.data.type}
              </p>
              <h2 class="font-serif text-lg text-ink-900 mt-1 leading-tight">{a.data.name_display}</h2>
              <p class="text-sm text-sand-900 mt-2 leading-relaxed line-clamp-3">
                {a.data.summary_short}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
