---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const people = (await getCollection('people')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);
const groups = (await getCollection('groups')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);
---

<BaseLayout title="People & Groups">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="font-serif text-4xl mb-2">People &amp; Groups</h1>
    <p class="text-sand-700 mb-8">
      Individual figures and the collective entities — peoples, mercenary
      bands, factions — that participate in Carthage's history alongside them.
    </p>

    {groups.length > 0 && (
      <section class="mb-12">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">Groups</h2>
        <ul class="grid sm:grid-cols-2 gap-3">
          {groups.map((g) => (
            <li>
              <a href={`/groups/${g.id}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white">
                <h3 class="font-serif text-lg text-tyrian-700">{g.data.name_display}</h3>
                <p class="text-xs uppercase tracking-wider text-sand-700 mt-1">{g.data.type.replace('_', ' ')}</p>
                {g.data.polity_affiliation && (
                  <p class="text-sm text-sand-700 mt-1">{g.data.polity_affiliation}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section>
      <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">People</h2>
      <ul class="grid sm:grid-cols-2 gap-3">
        {people.map((p) => (
          <li>
            <a href={`/people/${p.id}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white">
              <h3 class="font-serif text-lg text-tyrian-700">{p.data.name_display}</h3>
              {p.data.name_punic && <p class="text-sm text-sand-700">{p.data.name_punic}</p>}
              <p class="text-xs text-sand-700 mt-1">{p.data.polity} · {p.data.roles.join(', ')}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
