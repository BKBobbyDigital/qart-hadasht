---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexViewToggle from '../../components/IndexViewToggle.astro';
import { formatHistoricalDate } from '../../lib/historicalDate';
import { getCollection } from 'astro:content';

const people = (await getCollection('people')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);
const groups = (await getCollection('groups')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);

// Bucket people by polity for sub-section grouping. The polity field
// is a freeform string ("Rome", "Carthage", "Numidia (Massylii)",
// "Sparta (mercenary in Carthaginian service)", etc.) so we match on
// substring rather than equality. Each person lands in exactly one
// bucket; "Other" catches anything unmatched.
function polityBucket(polity: string | undefined): string {
  const p = (polity || '').toLowerCase();
  // Order matters — first match wins. Carthage's variants come first
  // since the Punic identity is the principal lens. Mercenaries and
  // rebels are a distinct category from the polities they fought
  // for/against.
  if (p.includes('mercenary') || p.includes('rebellion') || p.includes('rebel')) return 'Mercenary / rebel';
  if (p.includes('carthage') || p === 'tyre') return 'Carthaginian';
  if (p.includes('rome')) return 'Roman';
  if (p.includes('numidia')) return 'Numidian';
  if (p.includes('syracuse') || p.includes('akragas') || p.includes('epirus') || p.includes('corinth') || p.includes('cyrene') || p.includes('sparta')) return 'Greek';
  if (p.includes('iberian') || p.includes('ilergetes')) return 'Iberian';
  return 'Other';
}

const bucketOrder = ['Carthaginian', 'Roman', 'Numidian', 'Greek', 'Iberian', 'Mercenary / rebel', 'Other'];
const bucketSlug = (b: string) => b.toLowerCase().replace(/\s*\/\s*/g, '-').replace(/\s+/g, '-');
const peopleBuckets: Record<string, typeof people> = {};
for (const b of bucketOrder) peopleBuckets[b] = [];
for (const p of people) {
  peopleBuckets[polityBucket(p.data.polity)].push(p);
}
// Drop empty buckets from display
const displayBuckets = bucketOrder
  .map((b) => ({ label: b, slug: bucketSlug(b), items: peopleBuckets[b] }))
  .filter((b) => b.items.length > 0);

// Reverse-lookup event count per person
const allEvents = await getCollection('events');
const eventsByPerson = new Map<string, number>();
for (const e of allEvents) {
  for (const p of e.data.participants ?? []) {
    eventsByPerson.set(p.person.id, (eventsByPerson.get(p.person.id) ?? 0) + 1);
  }
}

const personRow = (p: any) => {
  const dates = p.data.birth || p.data.death
    ? `${formatHistoricalDate(p.data.birth) ?? '?'} – ${formatHistoricalDate(p.data.death) ?? '?'}`
    : (formatHistoricalDate(p.data.floruit) ?? '');
  const sortYear = p.data.birth?.value ?? p.data.floruit?.value ?? p.data.death?.value ?? 9999;
  return {
    id: p.id,
    name: p.data.name_display,
    role: (p.data.roles && p.data.roles[0]) || '',
    polity: p.data.polity || '',
    dates,
    sortYear,
    events: eventsByPerson.get(p.id) ?? 0,
  };
};
const personRows = people.map(personRow);
---

<BaseLayout title="People & Peoples">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="font-serif text-4xl sm:text-5xl mb-3">People &amp; Peoples</h1>
    <p class="text-sand-700 mb-6 max-w-2xl">
      Individual figures, and the collective entities — peoples, dynasties,
      mercenary bands, factions — that participate in Carthage's history
      alongside them. People are grouped below by polity; the Peoples
      section covers the collective actors.
    </p>

    {/* Jump-to TOC: small pill nav with anchor links to every sub-section */}
    <nav aria-label="Sections on this page" class="mb-10 flex flex-wrap items-baseline gap-x-2 gap-y-2 text-sm">
      <span class="eyebrow text-[10px] mr-1">Jump to</span>
      {groups.length > 0 && (
        <a href="#peoples" class="inline-flex items-baseline gap-1.5 px-2.5 py-1 border border-sand-300 bg-sand-50 rounded-full hover:bg-[#faf6ec] hover:border-tyrian-500 transition-colors">
          <span class="text-sand-900">Peoples</span>
          <span class="text-xs text-sand-700 tabular-nums">{groups.length}</span>
        </a>
      )}
      {displayBuckets.map((b) => (
        <a
          href={`#${b.slug}`}
          class="inline-flex items-baseline gap-1.5 px-2.5 py-1 border border-sand-300 bg-sand-50 rounded-full hover:bg-[#faf6ec] hover:border-tyrian-500 transition-colors"
        >
          <span class="text-sand-900">{b.label}</span>
          <span class="text-xs text-sand-700 tabular-nums">{b.items.length}</span>
        </a>
      ))}
    </nav>

    {groups.length > 0 && (
      <section id="peoples" class="mb-12 scroll-mt-8">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">Peoples <span class="text-sm text-sand-700 font-normal tabular-nums ml-1">({groups.length})</span></h2>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 items-stretch">
          {groups.map((g) => (
            <li class="h-full">
              <a
                href={`/groups/${g.id}`}
                class="card-uniform flex flex-col h-full p-4 border border-sand-300 bg-white/60 rounded-lg hover:bg-[#faf6ec] hover:border-tyrian-500 active:bg-purple-100 transition-colors"
              >
                <h3 class="font-serif text-lg text-tyrian-800 leading-tight line-clamp-1">{g.data.name_display}</h3>
                <p class="mt-1.5">
                  <span class="inline-block text-[10px] uppercase tracking-wider text-sand-700 font-medium bg-sand-100 border border-sand-300 px-1.5 py-0.5 rounded">{g.data.type.replace('_', ' ')}</span>
                </p>
                <p class="text-sm text-sand-700 mt-2 line-clamp-2 leading-snug card-body">
                  {g.data.polity_affiliation || ''}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section data-view-container>
      <div class="flex items-baseline justify-between gap-4 border-b border-sand-300 pb-2 mb-4">
        <h2 class="font-serif text-2xl">People <span class="text-sm text-sand-700 font-normal tabular-nums ml-1">({people.length})</span></h2>
        <IndexViewToggle />
      </div>

      <div data-view-cards class="space-y-10">
        {displayBuckets.map((b) => (
          <div id={b.slug} class="scroll-mt-8">
            <h3 class="font-serif text-xl text-tyrian-800 mb-3 flex items-baseline gap-2">
              <span>{b.label}</span>
              <span class="text-xs text-sand-700 font-normal tabular-nums">({b.items.length})</span>
            </h3>
            <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 items-stretch">
              {b.items.map((p: any) => {
                const row = personRow(p);
                const bodyText = [row.role, row.dates].filter(Boolean).join(' · ');
                return (
                  <li class="h-full">
                    <a
                      href={`/people/${p.id}`}
                      class="card-uniform flex flex-col h-full p-4 border border-sand-300 bg-white/60 rounded-lg hover:bg-[#faf6ec] hover:border-tyrian-500 active:bg-purple-100 transition-colors"
                    >
                      <h3 class="font-serif text-lg text-tyrian-800 leading-tight line-clamp-1">{p.data.name_display}</h3>
                      <p class="mt-1.5">
                        <span class="inline-block text-[10px] uppercase tracking-wider text-sand-700 font-medium bg-sand-100 border border-sand-300 px-1.5 py-0.5 rounded">{p.data.polity}</span>
                      </p>
                      <p class="text-sm text-sand-700 mt-2 line-clamp-2 leading-snug card-body">
                        {bodyText}
                      </p>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>

      <div data-view-table class="overflow-x-auto">
        <table data-sortable class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-sand-300 bg-sand-50">
              <th data-sort-key="name" data-sort-active="asc" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Name</th>
              <th data-sort-key="role" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Role</th>
              <th data-sort-key="polity" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Affiliation</th>
              <th data-sort-key="year" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Dates</th>
              <th data-sort-key="events" class="text-right font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Events</th>
            </tr>
          </thead>
          <tbody>
            {personRows.map((r) => (
              <tr
                class="border-b border-sand-200 hover:bg-[#faf6ec] active:bg-purple-100 transition-colors"
                data-sort-name={r.name}
                data-sort-role={r.role}
                data-sort-polity={r.polity}
                data-sort-year={r.sortYear}
                data-sort-events={r.events}
              >
                <td class="px-3 py-2"><a href={`/people/${r.id}`} class="font-serif text-tyrian-700 hover:underline">{r.name}</a></td>
                <td class="px-3 py-2 text-sand-900 capitalize">{r.role}</td>
                <td class="px-3 py-2 text-sand-900">{r.polity}</td>
                <td class="px-3 py-2 text-sand-700 tabular-nums whitespace-nowrap">{r.dates}</td>
                <td class="px-3 py-2 text-right text-sand-700 tabular-nums">{r.events || ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
