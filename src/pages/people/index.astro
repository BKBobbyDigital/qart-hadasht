---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexViewToggle from '../../components/IndexViewToggle.astro';
import { formatHistoricalDate } from '../../lib/historicalDate';
import { getCollection } from 'astro:content';

const people = (await getCollection('people')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);
const groups = (await getCollection('groups')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);

// Reverse-lookup event count per person
const allEvents = await getCollection('events');
const eventsByPerson = new Map<string, number>();
for (const e of allEvents) {
  for (const p of e.data.participants ?? []) {
    eventsByPerson.set(p.person.id, (eventsByPerson.get(p.person.id) ?? 0) + 1);
  }
}

const personRow = (p: any) => {
  const dates = p.data.birth || p.data.death
    ? `${formatHistoricalDate(p.data.birth) ?? '?'} – ${formatHistoricalDate(p.data.death) ?? '?'}`
    : (formatHistoricalDate(p.data.floruit) ?? '');
  const sortYear = p.data.birth?.value ?? p.data.floruit?.value ?? p.data.death?.value ?? 9999;
  return {
    id: p.id,
    name: p.data.name_display,
    role: (p.data.roles && p.data.roles[0]) || '',
    polity: p.data.polity || '',
    dates,
    sortYear,
    events: eventsByPerson.get(p.id) ?? 0,
  };
};
const personRows = people.map(personRow);
---

<BaseLayout title="People & Groups">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="font-serif text-4xl sm:text-5xl mb-3">People &amp; Groups</h1>
    <p class="text-sand-700 mb-8">
      Individual figures and the collective entities — peoples, mercenary
      bands, factions — that participate in Carthage's history alongside them.
    </p>

    {groups.length > 0 && (
      <section class="mb-12">
        <h2 class="font-serif text-2xl border-b border-sand-300 pb-2 mb-4">Groups</h2>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 items-stretch">
          {groups.map((g) => (
            <li class="h-full">
              <a
                href={`/groups/${g.id}`}
                class="card-uniform flex flex-col h-full p-4 border border-sand-300 bg-white/60 rounded-lg hover:bg-[#faf6ec] hover:border-tyrian-500 active:bg-purple-100 transition-colors"
              >
                <h3 class="font-serif text-lg text-tyrian-800 leading-tight line-clamp-1">{g.data.name_display}</h3>
                <p class="mt-1.5">
                  <span class="inline-block text-[10px] uppercase tracking-wider text-sand-700 font-medium bg-sand-100 border border-sand-300 px-1.5 py-0.5 rounded">{g.data.type.replace('_', ' ')}</span>
                </p>
                <p class="text-sm text-sand-700 mt-2 line-clamp-2 leading-snug card-body">
                  {g.data.polity_affiliation || ''}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section data-view-container>
      <div class="flex items-baseline justify-between gap-4 border-b border-sand-300 pb-2 mb-4">
        <h2 class="font-serif text-2xl">People</h2>
        <IndexViewToggle />
      </div>

      <div data-view-cards>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 items-stretch">
          {people.map((p) => {
            const row = personRow(p);
            const bodyText = [row.role, row.dates].filter(Boolean).join(' · ');
            return (
            <li class="h-full">
              <a
                href={`/people/${p.id}`}
                class="card-uniform flex flex-col h-full p-4 border border-sand-300 bg-white/60 rounded-lg hover:bg-[#faf6ec] hover:border-tyrian-500 active:bg-purple-100 transition-colors"
              >
                <h3 class="font-serif text-lg text-tyrian-800 leading-tight line-clamp-1">{p.data.name_display}</h3>
                <p class="mt-1.5">
                  <span class="inline-block text-[10px] uppercase tracking-wider text-sand-700 font-medium bg-sand-100 border border-sand-300 px-1.5 py-0.5 rounded">{p.data.polity}</span>
                </p>
                <p class="text-sm text-sand-700 mt-2 line-clamp-2 leading-snug card-body">
                  {bodyText}
                </p>
              </a>
            </li>
            );
          })}
        </ul>
      </div>

      <div data-view-table class="overflow-x-auto">
        <table data-sortable class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-sand-300 bg-sand-50">
              <th data-sort-key="name" data-sort-active="asc" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Name</th>
              <th data-sort-key="role" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Role</th>
              <th data-sort-key="polity" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Affiliation</th>
              <th data-sort-key="year" class="text-left font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Dates</th>
              <th data-sort-key="events" class="text-right font-semibold text-sand-700 px-3 py-2 text-xs uppercase tracking-wider">Events</th>
            </tr>
          </thead>
          <tbody>
            {personRows.map((r) => (
              <tr
                class="border-b border-sand-200 hover:bg-[#faf6ec] active:bg-purple-100 transition-colors"
                data-sort-name={r.name}
                data-sort-role={r.role}
                data-sort-polity={r.polity}
                data-sort-year={r.sortYear}
                data-sort-events={r.events}
              >
                <td class="px-3 py-2"><a href={`/people/${r.id}`} class="font-serif text-tyrian-700 hover:underline">{r.name}</a></td>
                <td class="px-3 py-2 text-sand-900 capitalize">{r.role}</td>
                <td class="px-3 py-2 text-sand-900">{r.polity}</td>
                <td class="px-3 py-2 text-sand-700 tabular-nums whitespace-nowrap">{r.dates}</td>
                <td class="px-3 py-2 text-right text-sand-700 tabular-nums">{r.events || ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
