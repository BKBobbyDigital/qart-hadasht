---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Infobox, { type InfoboxRow, type InfoboxLink } from '../../components/Infobox.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import { formatHistoricalDate, dateQualifier } from '../../lib/historicalDate';
import { autolink, buildLinkRegistry } from '../../lib/autolink';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((p) => ({
    params: { slug: p.id },
    props: { person: p },
  }));
}

const { person } = Astro.props;
const d = person.data;

const fmtDate = (date: any) => {
  if (!date) return null;
  const year = Math.abs(date.value);
  const era = date.value < 0 ? 'BCE' : 'CE';
  return `${date.circa ? 'c. ' : ''}${year} ${era}`;
};

// Reverse lookup: events where this person is a participant
const allEvents = await getCollection('events');
const referencingEvents = allEvents
  .filter((e) =>
    (e.data.participants ?? []).some((p: any) => p.person.id === person.id)
  )
  .map((e) => {
    const participation = e.data.participants.find((p: any) => p.person.id === person.id);
    return { event: e, role: participation?.role, side: participation?.side };
  })
  .sort((a, b) => a.event.data.date_start.value - b.event.data.date_start.value);

// Reverse lookup: claims referencing this person via entities
const allClaims = await getCollection('claims');
const referencingClaims = allClaims.filter((c) =>
  (c.data.entities ?? []).some((e: any) => e.type === 'person' && e.slug === person.id)
);

// Resolve referenced institutions and themes (if any)
const { getEntry } = await import('astro:content');
const personInstitutions = await Promise.all(
  (d.referenced_institutions ?? []).map(async (ref: any) => await getEntry('institutions', ref.id))
);
const personThemes = await Promise.all(
  (d.referenced_themes ?? []).map(async (ref: any) => await getEntry('themes', ref.id))
);

// Find narratives whose primary subject is this person
const allNarratives = await getCollection('narratives');
const personNarratives = allNarratives.filter((n) =>
  n.data.primary_entities?.some((e: any) => e.type === 'person' && e.slug === person.id)
);

// ─── Infobox derivations ─────────────────────────────────────────────────────
const primaryRole = (d.roles && d.roles.length > 0) ? d.roles[0] : null;

// Resolve unique sources cited about this person
const sourceIds = new Set<string>();
referencingClaims.forEach((c) =>
  (c.data.sources ?? []).forEach((s: any) => sourceIds.add(s.source.id))
);
const sourcesCount = sourceIds.size;
const sourcesCited = (
  await Promise.all(Array.from(sourceIds).map((id) => getEntry('sources', id)))
)
  .filter(Boolean)
  .sort((a: any, b: any) => a!.data.title.localeCompare(b!.data.title));

// Auto-link registry
const allPlaces = await getCollection('places');
const allInstitutions = await getCollection('institutions');
const allGroups = await getCollection('groups');
const allThemes = await getCollection('themes');
const allPeople = await getCollection('people');
const allDeities = await getCollection('deities');
const linkRegistry = buildLinkRegistry({
  events: allEvents,
  people: allPeople,
  places: allPlaces,
  institutions: allInstitutions,
  groups: allGroups,
  themes: allThemes,
  deities: allDeities,
});
const summaryHtml = autolink(d.summary, linkRegistry, {
  excludeKey: `person:${person.id}`,
});

const personInfoboxRows: InfoboxRow[] = [
  {
    label: 'Born',
    value: formatHistoricalDate(d.birth),
    qualifier: dateQualifier(d.birth),
  },
  {
    label: 'Died',
    value: formatHistoricalDate(d.death),
    qualifier: dateQualifier(d.death),
  },
  {
    label: 'Active',
    value: formatHistoricalDate(d.floruit),
    qualifier: dateQualifier(d.floruit),
  },
  {
    label: 'Role',
    value: primaryRole,
  },
  {
    label: 'Affiliation',
    value: d.polity ?? null,
  },
  {
    label: 'Appears in',
    value: referencingEvents.length > 0 ? `${referencingEvents.length} event${referencingEvents.length === 1 ? '' : 's'}` : null,
    href: referencingEvents.length > 0 ? '#events' : undefined,
    emptyLabel: 'none',
  },
  {
    label: 'Sources cited',
    value: sourcesCount > 0 ? `${sourcesCount}` : null,
    href: sourcesCount > 0 ? '#sources' : undefined,
  },
];
---

<BaseLayout title={d.name_display} description={d.summary}>
  <div class="max-w-5xl mx-auto px-6 py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-10 lg:items-start">
    <Infobox
      title={d.name_display}
      subtitle={d.polity ?? primaryRole ?? undefined}
      rows={personInfoboxRows}
    />
    <article class="lg:col-start-1 lg:row-start-1 min-w-0">
      <span hidden data-pagefind-filter="type:People" data-pagefind-meta="type:Person"></span>
    {d.name_punic_script && (
      <p class="font-phoenician text-3xl text-tyrian-700 mb-2">{d.name_punic_script}</p>
    )}
    <h1 class="font-serif text-4xl sm:text-5xl mb-3">{d.name_display}</h1>
    <p class="text-sand-700">
      {d.birth && <>b. {fmtDate(d.birth)}</>}
      {d.birth && d.death && <> · </>}
      {d.death && <>d. {fmtDate(d.death)}</>}
      {d.polity && <> · {d.polity}</>}
    </p>

    {(d.name_punic || d.name_greek || d.name_latin) && (
      <section class="mt-8 border border-sand-300 rounded-lg p-5 bg-white/60">
        <h2 class="font-serif text-xl mb-3">Name</h2>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
          {d.name_punic && (<><dt class="font-semibold text-sand-700">Punic</dt><dd>{d.name_punic} {d.name_punic_script && <span class="font-phoenician text-tyrian-700 ml-2">{d.name_punic_script}</span>}</dd></>)}
          {d.name_greek && (<><dt class="font-semibold text-sand-700">Greek</dt><dd>{d.name_greek}</dd></>)}
          {d.name_latin && (<><dt class="font-semibold text-sand-700">Latin</dt><dd>{d.name_latin}</dd></>)}
        </dl>
        {d.etymology && <p class="text-sm mt-3 text-sand-900">{d.etymology}</p>}
      </section>
    )}

    <div class="prose-encyclopedia mt-8 text-lg text-sand-900">
      <p set:html={summaryHtml} />
    </div>

    {personNarratives.map((n) => (
      <a href={`/narratives/${n.id.replace(/\.md$/, '')}`} class="block mt-6 p-4 border border-tyrian-300 bg-tyrian-50 rounded-lg hover:bg-tyrian-100 transition-colors">
        <p class="text-[11px] uppercase tracking-widest font-bold text-tyrian-700">Read the full narrative →</p>
        <p class="font-serif text-lg text-tyrian-900 mt-1">{n.data.title}</p>
        <p class="text-sm text-sand-900 mt-1">{n.data.thesis}</p>
      </a>
    ))}

    {referencingEvents.length > 0 && (
      <section class="mt-12 pt-6 border-t border-sand-300" id="events">
        <h2 class="font-serif text-2xl mb-3">Events</h2>
        <ul class="space-y-2">
          {referencingEvents.map((entry) => (
            <li class="flex items-baseline gap-3">
              <span class="text-sm text-sand-700 shrink-0 tabular-nums w-20">
                {Math.abs(entry.event.data.date_start.value)} BCE
              </span>
              <div class="flex-1">
                <a href={`/events/${entry.event.id}`} class="text-tyrian-700 hover:underline font-serif">
                  {entry.event.data.name}
                </a>
                {entry.role && (
                  <p class="text-xs text-sand-700 mt-0.5">
                    {entry.role}{entry.side ? ` · ${entry.side}` : ''}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {(personInstitutions.filter(Boolean).length > 0 || personThemes.filter(Boolean).length > 0) && (
      <section class="mt-10 pt-6 border-t border-sand-300">
        <h2 class="font-serif text-2xl mb-3">Civilization context</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {personInstitutions.filter(Boolean).length > 0 && (
            <div class="border border-sand-300 rounded-lg p-4 bg-sand-50">
              <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">Institutions</h3>
              <ul class="space-y-2 text-sm">
                {personInstitutions.filter(Boolean).map((i: any) => (
                  <li>
                    <a href={`/institutions/${i.id}`} class="font-serif text-tyrian-700 hover:underline">{i.data.name_display}</a>
                    <p class="text-xs text-sand-700 mt-0.5">{i.data.type}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {personThemes.filter(Boolean).length > 0 && (
            <div class="border border-sand-300 rounded-lg p-4 bg-sand-50">
              <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">Themes</h3>
              <ul class="space-y-2 text-sm">
                {personThemes.filter(Boolean).map((t: any) => (
                  <li>
                    <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="font-serif text-tyrian-700 hover:underline">{t.data.title}</a>
                    <p class="text-xs text-sand-700 mt-0.5">{t.data.scope.replace('_', ' ')}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    {referencingClaims.length > 0 && (
      <section class="mt-10 pt-6 border-t border-sand-300">
        <h2 class="font-serif text-2xl mb-3">Mentioned in claims</h2>
        <ul class="space-y-2">
          {referencingClaims.map((c) => (
            <li class="text-sm">
              <p class="text-ink-900">{c.data.statement}</p>
              <div class="mt-1"><ConfidenceBadge confidence={c.data.confidence} size="xs" /></div>
            </li>
          ))}
        </ul>
      </section>
    )}
    {sourcesCited.length > 0 && (
      <section class="mt-10 pt-6 border-t border-sand-300" id="sources">
        <h2 class="font-serif text-2xl mb-3">Sources cited</h2>
        <ul class="space-y-2">
          {sourcesCited.map((s: any) => (
            <li class="text-sm">
              <a href={`/sources/${s.id}`} class="text-tyrian-700 hover:underline font-serif">{s.data.title}</a>
              {s.data.author && <span class="text-sand-700"> · {s.data.author}</span>}
              <span class="text-sand-700"> · <span class="italic">{s.data.type.replace('_', ' ')}</span></span>
            </li>
          ))}
        </ul>
      </section>
    )}
    </article>
  </div>
</BaseLayout>
