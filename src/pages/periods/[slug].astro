---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleSchema } from '../../lib/structuredData';
import { stripMarkdownForMeta, renderInline } from '../../lib/autolink';
import HistoricalMap from '../../components/HistoricalMap.astro';
import ContentToc from '../../components/ContentToc.astro';
import VersionStamp from '../../components/VersionStamp.astro';
import CiteThisPage from '../../components/CiteThisPage.astro';
import { getCollection, getEntry, render } from 'astro:content';

// Eagerly import every map config under src/data/maps/*.json so the
// period frontmatter `map_id` field can resolve at build time.
const mapModules = import.meta.glob('../../data/maps/*.json', { eager: true });
const mapConfigs: Record<string, any> = {};
for (const [path, mod] of Object.entries(mapModules)) {
  const stem = path.split('/').pop()!.replace(/\.json$/, '');
  mapConfigs[stem] = (mod as any).default ?? mod;
}

export async function getStaticPaths() {
  const periods = await getCollection('periods');
  return periods.map((p) => ({
    params: { slug: p.id.replace(/\.md$/, '') },
    props: { period: p },
  }));
}

const { period } = Astro.props;
const { Content } = await render(period);
const d = period.data;

// Resolve all the curated entity collections
const events = await Promise.all(
  (d.key_events ?? []).map(async (ref: any) => await getEntry('events', ref.id))
);
const people = await Promise.all(
  (d.key_people ?? []).map(async (ref: any) => await getEntry('people', ref.id))
);
const places = await Promise.all(
  (d.key_places ?? []).map(async (ref: any) => await getEntry('places', ref.id))
);
const themes = await Promise.all(
  (d.key_themes ?? []).map(async (ref: any) => await getEntry('themes', ref.id))
);
const sources = await Promise.all(
  (d.principal_sources ?? []).map(async (ref: any) => await getEntry('sources', ref.id))
);

const eventsResolved = events.filter(Boolean).sort(
  (a: any, b: any) => a.data.date_start.value - b.data.date_start.value
);

const fmtYear = (y: number) => `${Math.abs(y)} ${y < 0 ? 'BCE' : 'CE'}`;
const dateRange = `${fmtYear(d.start_year)} – ${fmtYear(d.end_year)}`;

// Reading time: rough word count of body + summary at 200 wpm.
const periodBodyText = (period.body || '') + ' ' + (d.summary || '');
const periodWordCount = (periodBodyText.match(/\b[\w'-]+\b/g) ?? []).length;
const periodReadingMinutes = Math.max(1, Math.round(periodWordCount / 200));

// Themes resolved for the tag cluster (key_themes references, already
// loaded above as `themes` — reuse, filter falsy).
const themeTags = themes.filter(Boolean) as any[];

// Related editorial takes + open questions referencing any key_event
// or key_theme. (Periods touch many entities; restrict to the curated
// key_events and key_themes lists for relevance.)
const periodKeyKeys = new Set<string>([
  ...(d.key_events ?? []).map((ref: any) => `event:${ref}`),
  ...(d.key_themes ?? []).map((ref: any) => `theme:${ref.id ?? ref}`),
]);
const periodRelatedTakes = (await getCollection('editorialTakes')).filter((t: any) => {
  const se = t.data.subject_entity;
  return se && periodKeyKeys.has(`${se.type}:${se.slug}`);
});
const periodRelatedQuestions = (await getCollection('openQuestions')).filter((q: any) =>
  (q.data.relevant_entities ?? []).some((e: any) => periodKeyKeys.has(`${e.type}:${e.slug}`))
);

// Reverse lookup: narratives whose primary_entities include any of this
// period's key themes or events (typically scope=period narratives, but
// any narrative anchored to a key entity of this period will surface).
const periodRelatedNarratives = (await getCollection('narratives')).filter((n: any) =>
  (n.data.primary_entities ?? []).some((e: any) => periodKeyKeys.has(`${e.type}:${e.slug}`))
);

// All periods sorted chronologically for prev/next navigation
const allPeriods = (await getCollection('periods')).sort(
  (a: any, b: any) => a.data.start_year - b.data.start_year
);
const idx = allPeriods.findIndex((p: any) => p.id === period.id);
const prev = idx > 0 ? allPeriods[idx - 1] : null;
const next = idx < allPeriods.length - 1 ? allPeriods[idx + 1] : null;
---

<BaseLayout title={d.title} description={stripMarkdownForMeta(d.summary)} jsonld={articleSchema(d.title, d, { description: stripMarkdownForMeta(d.summary) })}>
  <div class="max-w-6xl mx-auto px-6 py-12">
    <header class="mb-8">
      <p class="eyebrow mb-3">
        Period · <a href="/periods" class="text-tyrian-700 hover:underline">All periods</a> · {periodReadingMinutes} min read
      </p>
      <h1 class="font-serif mb-3">{d.title}</h1>
      <p class="text-lg text-sand-700">{dateRange}</p>
      {themeTags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {themeTags.map((t: any) => (
            <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="inline-block text-[11px] uppercase tracking-wider text-sand-700 font-medium bg-sand-100 border border-sand-300 px-2 py-0.5 rounded hover:bg-sand-100 hover:border-tyrian-500 transition-colors">{t.data.title}</a>
          ))}
        </div>
      )}
    </header>
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-10 lg:items-start">
      <aside class="lg:col-start-2 lg:row-start-1 lg:sticky lg:top-6 self-start">
        <ContentToc contentSelector=".period-content" nonSticky />
      </aside>
      <article class="lg:col-start-1 lg:row-start-1 min-w-0">
        <span hidden data-pagefind-filter="type:Periods" data-pagefind-meta="type:Period"></span>

        <p class="lead mt-2 mb-8" set:html={renderInline(d.summary)}></p>

    {d.map_id && mapConfigs[d.map_id] && (
      <HistoricalMap
        config={mapConfigs[d.map_id]}
        caption={d.map_caption}
      />
    )}

    <p class="mt-8 mb-2 text-xs text-sand-700 italic">
      This page is the encyclopedia's own narrative reading of the period —
      interpretive synthesis, not impersonal reportage. Positions taken are
      the site's own; principal sources are listed below; underlying claims
      with confidence assessments and citations are linked throughout.
    </p>

    <div class="prose-encyclopedia longform period-content text-sand-900 mt-4">
      <Content />
    </div>

    {(eventsResolved.length > 0 || people.filter(Boolean).length > 0 || places.filter(Boolean).length > 0 || themes.filter(Boolean).length > 0) && (
      <section class="mt-12 pt-8 border-t border-sand-300">
        <h2 class="font-serif text-2xl mb-6">In this period</h2>

        {eventsResolved.length > 0 && (
          <div class="mb-8">
            <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">Events ({eventsResolved.length})</h3>
            <ul class="grid sm:grid-cols-2 gap-2 text-sm">
              {eventsResolved.map((e: any) => (
                <li class="flex items-baseline gap-3">
                  <span class="text-sand-700 shrink-0 tabular-nums w-16 text-xs">{Math.abs(e.data.date_start.value)} BCE</span>
                  <a href={`/events/${e.id}`} class="text-tyrian-700 hover:underline font-serif">{e.data.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {people.filter(Boolean).length > 0 && (
          <div class="mb-8">
            <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">People</h3>
            <ul class="grid sm:grid-cols-2 gap-2 text-sm">
              {people.filter(Boolean).map((p: any) => (
                <li>
                  <a href={`/people/${p.id}`} class="text-tyrian-700 hover:underline font-serif">{p.data.name_display}</a>
                  {p.data.polity && <span class="text-xs text-sand-700 ml-2">{p.data.polity}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}

        {places.filter(Boolean).length > 0 && (
          <div class="mb-8">
            <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">Places</h3>
            <ul class="grid sm:grid-cols-2 gap-2 text-sm">
              {places.filter(Boolean).map((p: any) => (
                <li>
                  <a href={`/places/${p.id}`} class="text-tyrian-700 hover:underline font-serif">{p.data.name_display}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {themes.filter(Boolean).length > 0 && (
          <div class="mb-8">
            <h3 class="text-[11px] uppercase tracking-widest font-bold text-sand-700 mb-3">Themes</h3>
            <ul class="grid sm:grid-cols-2 gap-2 text-sm">
              {themes.filter(Boolean).map((t: any) => (
                <li>
                  <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="text-tyrian-700 hover:underline font-serif">{t.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    {sources.filter(Boolean).length > 0 && (
      <section class="mt-12 pt-8 border-t border-sand-300">
        <h2 class="font-serif text-2xl mb-3">Principal sources</h2>
        <p class="text-sm text-sand-700 mb-4">
          The ancient sources and modern scholarship the synthesis above draws
          on. Individual claims throughout the entity pages link to specific
          passages.
        </p>
        <ul class="space-y-2 text-sm">
          {sources.filter(Boolean).map((s: any) => (
            <li>
              <a href={`/sources/${s.id}`} class="text-tyrian-700 hover:underline">
                {s.data.author ? `${s.data.author}, ` : ''}<em>{s.data.title}</em>
              </a>
              <span class="text-sand-700"> · <span class="italic">{s.data.type.replace('_', ' ')}</span></span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="mt-12 pt-6 border-t border-sand-300 flex justify-between gap-4 text-sm">
      {prev ? (
        <a href={`/periods/${prev.id.replace(/\.md$/, '')}`} class="text-tyrian-700 hover:underline">
          ← {prev.data.title}
        </a>
      ) : <span></span>}
      {next ? (
        <a href={`/periods/${next.id.replace(/\.md$/, '')}`} class="text-tyrian-700 hover:underline text-right">
          {next.data.title} →
        </a>
      ) : <span></span>}
    </nav>

    <p class="mt-8 text-xs text-sand-700 italic">
      Period synthesis · open to revision. Where the prose takes a position,
      the position is the site's own and may be challenged. Underlying
      claims with their own confidence assessments and source citations
      are linked throughout.
    </p>

        {(periodRelatedTakes.length > 0 || periodRelatedQuestions.length > 0 || periodRelatedNarratives.length > 0 || themeTags.length > 0) && (
          <section class="mt-12 pt-6 border-t border-sand-300">
            <h2 class="font-serif text-xl mb-4" style="border: none; padding: 0; margin-top: 0;">Related</h2>
            <div class="grid sm:grid-cols-2 gap-x-8 gap-y-6 text-sm">
              {periodRelatedNarratives.length > 0 && (
                <div>
                  <p class="eyebrow mb-2">Narratives</p>
                  <ul class="space-y-1.5">
                    {periodRelatedNarratives.map((n: any) => (
                      <li>
                        <a href={`/narratives/${n.id.replace(/\.md$/, '')}`} class="text-tyrian-700 hover:underline leading-snug">{n.data.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {periodRelatedTakes.length > 0 && (
                <div>
                  <p class="eyebrow mb-2">Editorial takes</p>
                  <ul class="space-y-1.5">
                    {periodRelatedTakes.map((t: any) => (
                      <li>
                        <a href={`/editorialTakes/${t.id}`} class="text-tyrian-700 hover:underline leading-snug" set:html={renderInline(t.data.subject_question)}></a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {periodRelatedQuestions.length > 0 && (
                <div>
                  <p class="eyebrow mb-2">Open questions</p>
                  <ul class="space-y-1.5">
                    {periodRelatedQuestions.map((q: any) => (
                      <li>
                        <a href={`/openQuestions/${q.id}`} class="text-tyrian-700 hover:underline leading-snug">{q.data.question}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {themeTags.length > 0 && (
                <div>
                  <p class="eyebrow mb-2">Themes</p>
                  <ul class="space-y-1.5">
                    {themeTags.map((t: any) => (
                      <li>
                        <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="text-tyrian-700 hover:underline leading-snug">{t.data.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )}

        <CiteThisPage title={d.title} lastRevised={d.last_revised} path={`/periods/${period.id.replace(/\.md$/, '')}`} />
        <VersionStamp date={d.last_revised} filePath={`src/content/periods/${period.id}`} />
      </article>
    </div>
  </div>
</BaseLayout>
