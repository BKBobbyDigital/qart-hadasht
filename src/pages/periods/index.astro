---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const periods = (await getCollection('periods')).sort(
  (a: any, b: any) => a.data.start_year - b.data.start_year
);

const fmtYear = (y: number) => `${Math.abs(y)} ${y < 0 ? 'BCE' : 'CE'}`;
---

<BaseLayout title="Periods">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="font-serif text-4xl sm:text-5xl mb-3">Browse by period</h1>
    <p class="text-sand-700 mb-8 max-w-2xl">
      Carthaginian history in seven eras. Each period page synthesizes the
      events, people, places, and themes of its era into a coherent narrative
      arc, with cross-links to the structured entity pages for depth.
    </p>

    <ol class="space-y-4">
      {periods.map((p: any) => (
        <li>
          <a href={`/periods/${p.id.replace(/\.md$/, '')}`} class="block p-5 border border-sand-300 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-300 transition-colors">
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <h2 class="font-serif text-xl text-tyrian-700">{p.data.title}</h2>
              <span class="text-sm text-sand-700 tabular-nums shrink-0">
                {fmtYear(p.data.start_year)} – {fmtYear(p.data.end_year)}
              </span>
            </div>
            <p class="text-sm text-ink-900 mt-2">{p.data.summary}</p>
          </a>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>
