---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const takes = (await getCollection('editorialTakes')).sort((a, b) =>
  a.data.subject_question.localeCompare(b.data.subject_question)
);

const confidenceLabel: Record<string, string> = {
  tentative: 'tentative',
  moderate: 'moderate',
  strong: 'strong',
};
---

<BaseLayout title="Editorial takes">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="font-serif text-4xl sm:text-5xl mb-3">Editorial takes</h1>
    <p class="text-sand-700 mb-8 max-w-2xl">
      The encyclopedia's labeled positions on contested or interpretive
      questions. Each take has a stated position, structured reasoning,
      explicit competing positions, and a confidence rating
      (<em>tentative</em>, <em>moderate</em>, <em>strong</em>). Takes are
      open to revision and any reader can challenge them.
    </p>

    <ul class="space-y-3">
      {takes.map((t: any) => (
        <li>
          <a href={`/editorialTakes/${t.id}`} class="block p-5 border border-tyrian-300 bg-tyrian-50 rounded-lg hover:bg-tyrian-100 transition-colors">
            <div class="flex items-baseline justify-between gap-4 flex-wrap">
              <h2 class="font-serif text-xl text-tyrian-900">{t.data.subject_question}</h2>
              <span class="text-xs uppercase tracking-wider text-tyrian-700">{confidenceLabel[t.data.confidence]} confidence</span>
            </div>
            <p class="text-sm text-sand-900 mt-3 line-clamp-3">{t.data.position}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
