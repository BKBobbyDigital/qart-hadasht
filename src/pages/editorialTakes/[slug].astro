---
import { renderInline, stripMarkdownForMeta } from '../../lib/autolink';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleSchema } from '../../lib/structuredData';
import EditorialTake from '../../components/EditorialTake.astro';
import VersionStamp from '../../components/VersionStamp.astro';
import CiteThisPage from '../../components/CiteThisPage.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const takes = await getCollection('editorialTakes');
  return takes.map((t) => ({
    params: { slug: t.id },
    props: { take: t },
  }));
}

const { take } = Astro.props;
const d = take.data;

// Resolve weighed claims
const weighedClaims = await Promise.all(
  (d.weighed_claims ?? []).map(async (ref: any) => await getEntry('claims', ref.id))
);

// Resolve subject entity if present
let subjectEntity: any = null;
let subjectHref: string | null = null;
const subjectMap: Record<string, string> = {
  event: 'events',
  person: 'people',
  place: 'places',
  institution: 'institutions',
  group: 'groups',
  deity: 'deities',
  theme: 'themes',
};
if (d.subject_entity) {
  const collection = subjectMap[d.subject_entity.type];
  if (collection) {
    subjectEntity = await getEntry(collection as any, d.subject_entity.slug);
    subjectHref = subjectEntity ? `/${collection}/${subjectEntity.id.replace(/\.md$/, '')}` : null;
  }
}

// Find source comparisons that reference this take
const allComparisons = await getCollection('sourceComparisons');
const relatedComparisons = allComparisons.filter((c: any) =>
  (c.data.related_takes ?? []).includes(take.id)
);

const subjectSlug = d.subject_entity?.slug ?? null;

// Open questions on the same subject. A take says what the site argues; a
// question on the same evidence says what it will not claim to settle. A
// take that does not point at its own open question reads more confident
// than the site is, which is charter principle 8 leaking.
const allQuestions = await getCollection('openQuestions');
const relatedQuestions = subjectSlug
  ? allQuestions.filter((q: any) =>
      (q.data.relevant_entities ?? []).some(
        (e: any) =>
          (e.role === 'subject' || e.role === 'object') && e.slug === subjectSlug
      )
    )
  : [];

// The long-form treatment of the same subject, for a reader who wants the
// story rather than the argument.
const allNarratives = await getCollection('narratives');
const relatedNarratives = subjectSlug
  ? allNarratives.filter((n: any) =>
      (n.data.primary_entities ?? []).some((e: any) => e.slug === subjectSlug)
    )
  : [];
---

<BaseLayout title={stripMarkdownForMeta(d.subject_question)} description={stripMarkdownForMeta(d.position, 200)} jsonld={articleSchema(stripMarkdownForMeta(d.subject_question), d, { description: stripMarkdownForMeta(d.position, 200) })}>
  <div class="max-w-6xl mx-auto px-6 py-12">
   <article class="max-w-3xl">
    <span hidden data-pagefind-filter="type:Editorial takes" data-pagefind-meta="type:Editorial take"></span>

    <p class="eyebrow mb-3">
      Editorial take · <a href="/editorialTakes" class="text-tyrian-700 hover:underline">All takes</a>
    </p>
    <h1 class="font-serif mb-4" set:html={renderInline(d.subject_question)}></h1>

    {subjectEntity && subjectHref && (
      <p class="text-sm text-sand-700 mb-6">
        On <a href={subjectHref} class="text-tyrian-700 hover:underline font-serif">
          {subjectEntity.data.name || subjectEntity.data.name_display || subjectEntity.data.title}
        </a>
      </p>
    )}

    <EditorialTake take={take} />

    {weighedClaims.filter(Boolean).length > 0 && (
      <section class="mt-10">
        <h2 class="font-serif text-xl mb-3">Claims weighed in this take</h2>
        <ul class="space-y-2">
          {weighedClaims.filter(Boolean).map((c: any) => (
            <li class="text-sm border-l-2 border-sand-300 pl-3">
              <p class="text-ink-900" set:html={renderInline(c.data.statement)}></p>
              <p class="text-xs text-sand-700 mt-0.5 uppercase tracking-wider">{c.data.confidence}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedComparisons.length > 0 && (
      <section class="mt-10">
        <h2 class="font-serif text-xl mb-3">Compare the ancient sources</h2>
        <ul class="space-y-2">
          {relatedComparisons.map((c: any) => (
            <li>
              <a href={`/sourceComparisons/${c.id}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 transition-colors">
                <p class="font-serif text-tyrian-700">{c.data.title}</p>
                <p class="text-xs text-sand-700 mt-1">{c.data.source_passages.length} sources in parallel</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedQuestions.length > 0 && (
      <section class="mt-10">
        <h2 class="font-serif text-xl mb-1">Open questions on this subject</h2>
        <p class="text-sm text-sand-700 mb-3">
          Where the site weighs candidate answers instead of arguing one.
          Where a question overlaps this take, the take is the answer the site
          gives and the question is the case for the alternatives.
        </p>
        <ul class="space-y-2">
          {relatedQuestions.map((q: any) => (
            <li>
              <a href={`/openQuestions/${q.id}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 transition-colors">
                <p class="text-[11px] uppercase tracking-widest text-sand-700 font-semibold mb-1">Open question</p>
                <p class="font-serif text-tyrian-700 leading-snug">
                  {stripMarkdownForMeta(q.data.question, 130)}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedNarratives.length > 0 && (
      <section class="mt-10">
        <h2 class="font-serif text-xl mb-3">The long-form treatment</h2>
        <ul class="space-y-2">
          {relatedNarratives.map((n: any) => (
            <li>
              <a href={`/narratives/${n.id.replace(/\.md$/, '')}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 transition-colors">
                <p class="text-[11px] uppercase tracking-widest text-sand-700 font-semibold mb-1">Narrative</p>
                <p class="font-serif text-tyrian-700 leading-snug">{n.data.title}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="mt-10 pt-5 border-t border-sand-300 text-sm text-sand-700">
      This is a position the site takes, not a fact it reports. The rules it
      is held to, and the reasoning failures it tries to avoid, are set out in
      the <a href="/charter" class="text-tyrian-700 hover:underline">evidentiary charter</a>.
    </p>

    <CiteThisPage title={stripMarkdownForMeta(d.subject_question)} lastRevised={d.last_reviewed} path={`/editorialTakes/${take.id}`} />
    <VersionStamp date={d.last_reviewed} filePath={`src/content/editorialTakes/${take.id}.yaml`} />
   </article>
  </div>
</BaseLayout>
