---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { stripMarkdownForMeta } from '../../lib/autolink';
import { getCollection, getEntry } from 'astro:content';

const themes = (await getCollection('themes')).sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);
const institutions = (await getCollection('institutions')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);
const groups = (await getCollection('groups')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);
const deities = (await getCollection('deities')).sort(
  (a, b) => a.data.name_display.localeCompare(b.data.name_display)
);
const carthage = await getEntry('places', 'carthage');

// Jump-to sections (only those with content), glossed like the
// narratives synthesis hub so the category labels are self-explanatory.
type TocItem = { label: string; anchor: string; count?: number; gloss: string };
const tocItems: TocItem[] = [
  { label: 'Themes', anchor: 'themes-essays', count: themes.length, gloss: 'cross-cutting essays — religion, trade, daily life, identity' },
];
if (carthage) tocItems.push({ label: 'The city', anchor: 'the-city', gloss: 'Carthage itself' });
tocItems.push({ label: 'Institutions', anchor: 'institutions', count: institutions.length, gloss: 'formal civic, political, and judicial bodies' });
if (deities.length > 0) tocItems.push({ label: 'Deities', anchor: 'deities', count: deities.length, gloss: 'the Carthaginian pantheon' });
if (groups.length > 0) tocItems.push({ label: 'Groups and peoples', anchor: 'groups', count: groups.length, gloss: 'collective entities and mercenary specialists' });
---

<BaseLayout title="Themes" description="The cultural side of Carthage: themes, institutions, groups, deities, the city itself.">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="font-serif mb-3">Themes</h1>
    <p class="text-sand-700 mb-8 max-w-2xl">
      The cultural side of Carthage. Themes are the cross-cutting essays
      — religion, daily life, language, trade, identity. This page also
      collects the supporting structural entities they touch: institutions,
      groups, deities, and the city itself.
    </p>

    <nav aria-label="Sections on this page" class="mb-12 border border-sand-300 rounded-lg p-4 bg-sand-50">
      <p class="eyebrow mb-3">Jump to</p>
      <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-sm">
        {tocItems.map((item) => (
          <li class="flex items-baseline gap-2">
            <a href={`#${item.anchor}`} class="text-tyrian-700 hover:underline font-semibold shrink-0">{item.label}</a>
            {item.count !== undefined && <span class="text-sand-700">({item.count})</span>}
            <span class="text-sand-700 min-w-0">— {item.gloss}</span>
          </li>
        ))}
      </ul>
    </nav>

  <section id="themes-essays" class="mb-12 scroll-mt-24">
    <h2 class="font-serif text-2xl mb-4">Themes <span class="text-sm text-sand-700 font-normal">({themes.length})</span></h2>
    <ul class="grid sm:grid-cols-2 gap-3">
      {themes.map((t) => (
        <li>
          <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 transition-colors h-full">
            <div class="flex items-baseline justify-between gap-3 flex-wrap">
              <h3 class="font-serif text-lg text-tyrian-700">{t.data.title}</h3>
              <span class="text-[10px] uppercase tracking-widest text-sand-700">{t.data.scope.replace('_', ' ')}</span>
            </div>
            <p class="text-sm text-ink-900 mt-2 line-clamp-3">{stripMarkdownForMeta(t.data.summary, 400)}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {carthage && (
    <section id="the-city" class="mb-12 scroll-mt-24">
      <h2 class="font-serif text-2xl mb-4">The city</h2>
      <a href={`/places/${carthage.id}`} class="block p-5 border border-tyrian-300 bg-sand-50 rounded-lg hover:bg-tyrian-50">
        <div class="flex items-baseline gap-3 flex-wrap">
          {carthage.data.names_alt?.punic_script && (
            <span class="font-phoenician text-2xl text-tyrian-700">{carthage.data.names_alt.punic_script}</span>
          )}
          <h3 class="font-serif text-xl text-tyrian-900">{carthage.data.name_display}</h3>
        </div>
        <p class="text-sm text-ink-900 mt-2 line-clamp-3">{stripMarkdownForMeta(carthage.data.summary, 400)}</p>
      </a>
    </section>
  )}

  <section id="institutions" class="mb-12 scroll-mt-24">
    <h2 class="font-serif text-2xl mb-4">Institutions <span class="text-sm text-sand-700 font-normal">({institutions.length})</span></h2>
    <p class="text-sand-700 text-sm mb-4">
      Formal civic, political, and judicial bodies of Carthage.
    </p>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
      {institutions.map((i) => (
        <li>
          <a href={`/institutions/${i.id}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 transition-colors text-sm">
            <h3 class="font-serif text-tyrian-700">{i.data.name_display}</h3>
            <p class="text-[11px] uppercase tracking-wider text-sand-700 mt-0.5">{i.data.type}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {deities.length > 0 && (
    <section id="deities" class="mb-12 scroll-mt-24">
      <h2 class="font-serif text-2xl mb-4">Deities <span class="text-sm text-sand-700 font-normal">({deities.length})</span></h2>
      <p class="text-sand-700 text-sm mb-4">
        The principal gods of the Carthaginian pantheon. See <a href="/themes/punic-religion" class="text-tyrian-700 hover:underline">Punic religion</a> for the framing prose.
      </p>
      <ul class="flex flex-wrap gap-2">
        {deities.map((d) => (
          <li>
            <a href={`/deities/${d.id}`} class="inline-flex items-baseline gap-2 px-3 py-1.5 border border-sand-300 rounded-full hover:bg-tyrian-50 hover:border-tyrian-500 transition-colors text-sm">
              {d.data.name_punic_script && (
                <span class="font-phoenician text-tyrian-700">{d.data.name_punic_script}</span>
              )}
              <span class="font-serif text-sand-900">{d.data.name_display}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {groups.length > 0 && (
    <section id="groups" class="mb-12 scroll-mt-24">
      <h2 class="font-serif text-2xl mb-4">Groups and peoples <span class="text-sm text-sand-700 font-normal">({groups.length})</span></h2>
      <p class="text-sand-700 text-sm mb-4">
        Collective entities — peoples, mercenary specialists, military units, dynasties — distinct from individual people and from formal institutions.
      </p>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
        {groups.map((g) => (
          <li>
            <a href={`/groups/${g.id}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-tyrian-50 hover:border-tyrian-500 transition-colors text-sm">
              <h3 class="font-serif text-tyrian-700">{g.data.name_display}</h3>
              <p class="text-[11px] uppercase tracking-wider text-sand-700 mt-0.5">{g.data.type.replace('_', ' ')}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  </div>
</BaseLayout>
