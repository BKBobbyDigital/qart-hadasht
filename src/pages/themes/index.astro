---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const themes = (await getCollection('themes')).sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);
---

<BaseLayout title="Themes">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="font-serif text-4xl mb-2">Themes</h1>
    <p class="text-sand-700 mb-8">
      Cross-cutting topics in Carthaginian civilization: religion, daily life,
      trade, identity, and the questions that span every event and place on
      the site.
    </p>
    <ul class="space-y-3">
      {themes.map((t) => (
        <li>
          <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="block p-4 border border-sand-300 rounded-lg hover:bg-white">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="font-serif text-xl text-tyrian-700">{t.data.title}</h2>
              <span class="text-xs uppercase tracking-wider text-sand-700">{t.data.scope.replace('_', ' ')}</span>
            </div>
            <p class="text-sm text-sand-900 mt-2">{t.data.summary.slice(0, 240)}...</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
