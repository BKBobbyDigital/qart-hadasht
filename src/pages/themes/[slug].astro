---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleSchema } from '../../lib/structuredData';
import { stripMarkdownForMeta, renderInline } from '../../lib/autolink';
import Infobox, { type InfoboxRow } from '../../components/Infobox.astro';
import ContentToc from '../../components/ContentToc.astro';
import Bibliography from '../../components/Bibliography.astro';
import MaterialEvidence from '../../components/MaterialEvidence.astro';
import VersionStamp from '../../components/VersionStamp.astro';
import CiteThisPage from '../../components/CiteThisPage.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const themes = await getCollection('themes');
  return themes.map((t) => ({
    params: { slug: t.id.replace(/\.md$/, '') },
    props: { theme: t },
  }));
}

const { theme } = Astro.props;
const { Content } = await render(theme);
const d = theme.data;
const themeSlug = theme.id.replace(/\.md$/, '');

// Resolve related themes
const allThemes = await getCollection('themes');
const relatedThemes = (d.related_themes ?? [])
  .map((r: any) => allThemes.find((t) => t.id === r.id || t.id.replace(/\.md$/, '') === r.id))
  .filter(Boolean);

// Reverse lookup: events that reference this theme
const allEvents = await getCollection('events');
const referencingEvents = allEvents
  .filter((e) =>
    (e.data.referenced_themes ?? []).some((ref: any) => ref.id === theme.id || ref.id === themeSlug)
  )
  .sort((a, b) => a.data.date_start.value - b.data.date_start.value);

// Reverse lookup: people who reference this theme
const allPeople = await getCollection('people');
const referencingPeople = allPeople
  .filter((p) =>
    (p.data.referenced_themes ?? []).some((ref: any) => ref.id === theme.id || ref.id === themeSlug)
  )
  .sort((a, b) => a.data.name_display.localeCompare(b.data.name_display));

// Reverse lookup: deities that reference this theme
const allDeities = await getCollection('deities');
const referencingDeities = allDeities
  .filter((dty) =>
    (dty.data.referenced_themes ?? []).some((ref: any) => ref.id === theme.id || ref.id === themeSlug)
  )
  .sort((a, b) => a.data.name_display.localeCompare(b.data.name_display));

// Reverse lookup: claims that name this theme as an entity
// Material evidence: artifacts whose `referenced_themes` includes
// this theme (direct frontmatter linkage on the artifact side).
const allArtifacts = await getCollection('artifacts');
const materialEvidence = allArtifacts.filter((a) =>
  (a.data.referenced_themes ?? []).some((ref: any) => ref.id === theme.id.replace(/\.md$/, ''))
);

const allClaims = await getCollection('claims');
const referencingClaims = allClaims.filter((c) =>
  (c.data.entities ?? []).some((e: any) => e.type === 'theme' && (e.slug === themeSlug || e.slug === theme.id))
);

// Reverse lookup: narratives whose primary_entities include this theme
const allNarratives = await getCollection('narratives');
const referencingNarratives = allNarratives.filter((n) =>
  (n.data.primary_entities ?? []).some((e: any) => e.type === 'theme' && (e.slug === themeSlug || e.slug === theme.id))
);

// Reverse lookup: periods that include this theme as a key_theme
const allPeriods = await getCollection('periods');
const referencingPeriods = allPeriods
  .filter((p: any) =>
    (p.data.key_themes ?? []).some((ref: any) => ref.id === theme.id || ref.id === themeSlug)
  )
  .sort((a: any, b: any) => a.data.start_year - b.data.start_year);

const scopeLabel = d.scope.replace('_', ' ');

// Reading time: rough word count of body + summary at 200 wpm.
const themeBodyText = (theme.body || '') + ' ' + (d.summary || '');
const themeWordCount = (themeBodyText.match(/\b[\w'-]+\b/g) ?? []).length;
const themeReadingMinutes = Math.max(1, Math.round(themeWordCount / 200));

// Editorial takes whose subject is this theme
const themeRelatedTakes = (await getCollection('editorialTakes')).filter((t: any) => {
  const se = t.data.subject_entity;
  return se && se.type === 'theme' && se.slug === themeSlug;
});
// Open questions referencing this theme
const themeRelatedQuestions = (await getCollection('openQuestions')).filter((q: any) =>
  (q.data.relevant_entities ?? []).some((e: any) => e.type === 'theme' && e.slug === themeSlug)
);

const themeInfoboxRows: InfoboxRow[] = [
  { label: 'Scope', value: scopeLabel.charAt(0).toUpperCase() + scopeLabel.slice(1) },
  {
    label: 'Events',
    value: referencingEvents.length > 0 ? `${referencingEvents.length}` : null,
    href: referencingEvents.length > 0 ? '#events' : undefined,
    emptyLabel: 'none',
  },
  {
    label: 'People',
    value: referencingPeople.length > 0 ? `${referencingPeople.length}` : null,
    href: referencingPeople.length > 0 ? '#people' : undefined,
    emptyLabel: 'none',
  },
  {
    label: 'Deities',
    value: referencingDeities.length > 0 ? `${referencingDeities.length}` : null,
    href: referencingDeities.length > 0 ? '#deities' : undefined,
    emptyLabel: 'none',
  },
  {
    label: 'Claims',
    value: referencingClaims.length > 0 ? `${referencingClaims.length}` : null,
    href: referencingClaims.length > 0 ? '#claims' : undefined,
    emptyLabel: 'none',
  },
  {
    label: 'Narratives',
    value: referencingNarratives.length > 0 ? `${referencingNarratives.length}` : null,
    href: referencingNarratives.length > 0 ? '#narratives' : undefined,
    emptyLabel: 'none',
  },
  { label: 'Reading time', value: `${themeReadingMinutes} min` },
  { label: 'Last revised', value: d.last_revised },
];

// Quick-jump tile config for the hub band
type Jump = { label: string; href: string; count: number };
const jumps: Jump[] = [
  { label: 'Events', href: '#events', count: referencingEvents.length },
  { label: 'People', href: '#people', count: referencingPeople.length },
  { label: 'Deities', href: '#deities', count: referencingDeities.length },
  { label: 'Periods', href: '#periods', count: referencingPeriods.length },
  { label: 'Claims', href: '#claims', count: referencingClaims.length },
  { label: 'Narratives', href: '#narratives', count: referencingNarratives.length },
].filter((j) => j.count > 0);
---

<BaseLayout title={d.title} description={stripMarkdownForMeta(d.summary)} jsonld={articleSchema(d.title, d, { description: stripMarkdownForMeta(d.summary) })}>
  <div class="max-w-6xl mx-auto px-6 py-12">
    <header class="mb-8">
      <p class="eyebrow mb-3">Theme · {d.scope.replace('_', ' ')} · {themeReadingMinutes} min read</p>
      <h1 class="font-serif">{d.title}</h1>
      {relatedThemes.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {relatedThemes.map((t: any) => (
            <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="inline-block text-[11px] uppercase tracking-wider text-sand-700 font-medium bg-sand-100 border border-sand-300 px-2 py-0.5 rounded hover:bg-tyrian-50 hover:border-tyrian-500 transition-colors">{t.data.title}</a>
          ))}
        </div>
      )}
    </header>
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-10 lg:items-start">
      <div class="lg:col-start-2 lg:row-start-1 lg:sticky lg:top-6 self-start space-y-6">
        <Infobox
          title={d.title}
          subtitle={`Theme · ${scopeLabel}`}
          rows={themeInfoboxRows}
          nonSticky
        />
        <ContentToc contentSelector=".theme-content" nonSticky />
      </div>
      <article class="lg:col-start-1 lg:row-start-1 min-w-0">
        <span hidden data-pagefind-filter="type:Themes" data-pagefind-meta="type:Theme"></span>

        <aside class="border border-tyrian-300 bg-sand-50/60 p-6 mb-6 rounded-lg">
          <p class="eyebrow mb-2 text-tyrian-700">Abstract</p>
          <p class="font-serif text-lg leading-snug text-ink-900 italic" set:html={renderInline(d.summary)}></p>
        </aside>

      {jumps.length > 0 && (
        <nav class="my-6 p-4 border border-sand-300 rounded-lg bg-sand-50" aria-label="In this theme">
          <p class="text-[10px] uppercase tracking-widest font-bold text-sand-700 mb-3">In this theme</p>
          <ul class="flex flex-wrap gap-2">
            {jumps.map((j) => (
              <li>
                <a
                  href={j.href}
                  class="inline-flex items-baseline gap-1.5 px-3 py-1 border border-sand-300 rounded-full text-sm bg-white hover:bg-tyrian-50 hover:border-tyrian-500 active:bg-tyrian-100 transition-colors"
                >
                  <span class="font-medium text-sand-900">{j.label}</span>
                  <span class="text-xs text-sand-700 tabular-nums">{j.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose-encyclopedia longform theme-content text-sand-900 mt-8">
        <Content />
      </div>

      {referencingPeriods.length > 0 && (
        <section class="mt-12 pt-6 border-t border-sand-300" id="periods">
          <h2 class="font-serif text-2xl mb-3">In which periods</h2>
          <ul class="space-y-2">
            {referencingPeriods.map((p: any) => (
              <li>
                <a href={`/periods/${p.id.replace(/\.md$/, '')}`} class="text-tyrian-700 hover:underline font-serif">{p.data.title}</a>
                <span class="text-xs text-sand-700 ml-2 tabular-nums">
                  {Math.abs(p.data.start_year)}–{Math.abs(p.data.end_year)} BCE
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {referencingEvents.length > 0 && (
        <section class="mt-12 pt-6 border-t border-sand-300" id="events">
          <h2 class="font-serif text-2xl mb-3">Referenced in events <span class="text-base text-sand-700 font-normal">({referencingEvents.length})</span></h2>
          <ul class="space-y-2">
            {referencingEvents.map((e) => (
              <li class="flex items-baseline gap-3">
                <span class="text-sm text-sand-700 shrink-0 tabular-nums w-20">
                  {Math.abs(e.data.date_start.value)} BCE
                </span>
                <a href={`/events/${e.id}`} class="text-tyrian-700 hover:underline font-serif">
                  {e.data.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {referencingPeople.length > 0 && (
        <section class="mt-12 pt-6 border-t border-sand-300" id="people">
          <h2 class="font-serif text-2xl mb-3">Associated people <span class="text-base text-sand-700 font-normal">({referencingPeople.length})</span></h2>
          <ul class="grid sm:grid-cols-2 gap-2 text-sm">
            {referencingPeople.map((p) => (
              <li>
                <a href={`/people/${p.id}`} class="text-tyrian-700 hover:underline font-serif">
                  {p.data.name_display}
                </a>
                {p.data.polity && <span class="text-xs text-sand-700 ml-2">{p.data.polity}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {referencingDeities.length > 0 && (
        <section class="mt-12 pt-6 border-t border-sand-300" id="deities">
          <h2 class="font-serif text-2xl mb-3">Deities <span class="text-base text-sand-700 font-normal">({referencingDeities.length})</span></h2>
          <ul class="grid sm:grid-cols-2 gap-2 text-sm">
            {referencingDeities.map((dty: any) => (
              <li class="flex items-baseline gap-2">
                {dty.data.name_punic_script && (
                  <span class="font-phoenician text-tyrian-700 shrink-0">{dty.data.name_punic_script}</span>
                )}
                <a href={`/deities/${dty.id}`} class="text-tyrian-700 hover:underline font-serif">
                  {dty.data.name_display}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {referencingNarratives.length > 0 && (
        <section class="mt-12 pt-6 border-t border-sand-300" id="narratives">
          <h2 class="font-serif text-2xl mb-3">Narratives <span class="text-base text-sand-700 font-normal">({referencingNarratives.length})</span></h2>
          <ul class="space-y-3">
            {referencingNarratives.map((n: any) => (
              <li>
                <a href={`/narratives/${n.id.replace(/\.md$/, '')}`} class="font-serif text-lg text-tyrian-700 hover:underline">
                  {n.data.title}
                </a>
                <p class="text-sm text-sand-700 mt-1">{n.data.thesis.slice(0, 200)}...</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      {referencingClaims.length > 0 && (
        <section class="mt-12 pt-6 border-t border-sand-300" id="claims">
          <h2 class="font-serif text-2xl mb-3">Claims <span class="text-base text-sand-700 font-normal">({referencingClaims.length})</span></h2>
          <ul class="space-y-3">
            {referencingClaims.map((c) => (
              <li class="text-sm border-l-2 border-sand-300 pl-3">
                <p class="text-ink-900" set:html={renderInline(c.data.statement)}></p>
                <p class="text-xs text-sand-700 mt-1 uppercase tracking-wider">{c.data.confidence}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <MaterialEvidence artifacts={materialEvidence} />

      <Bibliography claims={referencingClaims} />

      {relatedThemes.length > 0 && (
        <section class="mt-12 pt-6 border-t border-sand-300">
          <h2 class="font-serif text-2xl mb-3">Related themes</h2>
          <ul class="space-y-2">
            {relatedThemes.map((rt: any) => (
              <li>
                <a href={`/themes/${rt.id.replace(/\.md$/, '')}`} class="text-tyrian-700 hover:underline font-serif text-lg">{rt.data.title}</a>
                <p class="text-sm text-sand-700">{rt.data.summary.slice(0, 160)}...</p>
              </li>
            ))}
          </ul>
        </section>
      )}

        {(themeRelatedTakes.length > 0 || themeRelatedQuestions.length > 0 || relatedThemes.length > 0) && (
          <section class="mt-12 pt-6 border-t border-sand-300">
            <h2 class="font-serif text-xl mb-4" style="border: none; padding: 0; margin-top: 0;">Related</h2>
            <div class="grid sm:grid-cols-2 gap-x-8 gap-y-6 text-sm">
              {themeRelatedTakes.length > 0 && (
                <div>
                  <p class="eyebrow mb-2">Editorial takes</p>
                  <ul class="space-y-1.5">
                    {themeRelatedTakes.map((t: any) => (
                      <li>
                        <a href={`/editorialTakes/${t.id}`} class="text-tyrian-700 hover:underline leading-snug" set:html={renderInline(t.data.subject_question)}></a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {themeRelatedQuestions.length > 0 && (
                <div>
                  <p class="eyebrow mb-2">Open questions</p>
                  <ul class="space-y-1.5">
                    {themeRelatedQuestions.map((q: any) => (
                      <li>
                        <a href={`/openQuestions/${q.id}`} class="text-tyrian-700 hover:underline leading-snug">{q.data.question}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {relatedThemes.length > 0 && (
                <div>
                  <p class="eyebrow mb-2">Related themes</p>
                  <ul class="space-y-1.5">
                    {relatedThemes.map((t: any) => (
                      <li>
                        <a href={`/themes/${t.id.replace(/\.md$/, '')}`} class="text-tyrian-700 hover:underline leading-snug">{t.data.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )}

        <CiteThisPage title={d.title} lastRevised={d.last_revised} path={`/themes/${theme.id.replace(/\.md$/, '')}`} />
        <VersionStamp date={d.last_revised} filePath={`src/content/themes/${theme.id}`} />
      </article>
    </div>
  </div>
</BaseLayout>
