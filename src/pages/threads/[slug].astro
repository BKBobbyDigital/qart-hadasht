---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const threads = await getCollection('threads');
  return threads.map((t) => ({
    params: { slug: t.id.replace(/\.md$/, '') },
    props: { thread: t },
  }));
}

const { thread } = Astro.props;
const { Content } = await render(thread);
const d = thread.data;

const collectionMap: Record<string, string> = {
  event: 'events',
  person: 'people',
  place: 'places',
  institution: 'institutions',
  group: 'groups',
  deity: 'deities',
  theme: 'themes',
  narrative: 'narratives',
  claim: 'claims',
  'editorial-take': 'editorialTakes',
  period: 'periods',
  source: 'sources',
};

const stopUrlMap: Record<string, string> = {
  event: '/events',
  person: '/people',
  place: '/places',
  institution: '/institutions',
  group: '/groups',
  deity: '/deities',
  theme: '/themes',
  narrative: '/narratives',
  claim: '/claims',
  'editorial-take': '/editorialTakes',
  period: '/periods',
  source: '/sources',
};

// Resolve each stop to its entity data for title/year/summary display
const stops = await Promise.all(
  d.stops.map(async (s: any) => {
    const collection = collectionMap[s.type];
    if (!collection) return null;
    try {
      const entry: any = await getEntry(collection as any, s.slug);
      if (!entry) return null;
      const ed = entry.data;
      const slug = entry.id.replace(/\.md$/, '');
      let title = '';
      let subtitle = '';
      if (s.type === 'event') {
        title = ed.name;
        subtitle = ed.date_end
          ? `${Math.abs(ed.date_start.value)}–${Math.abs(ed.date_end.value)} BCE · ${ed.type}`
          : `${Math.abs(ed.date_start.value)} BCE · ${ed.type}`;
      } else if (s.type === 'person' || s.type === 'place' || s.type === 'institution' || s.type === 'group' || s.type === 'deity') {
        title = ed.name_display;
        subtitle = ed.polity || ed.type || '';
      } else if (s.type === 'theme' || s.type === 'narrative') {
        title = ed.title;
        subtitle = (ed.scope || '').replace('_', ' ');
      } else if (s.type === 'claim') {
        title = ed.statement.slice(0, 120) + (ed.statement.length > 120 ? '…' : '');
        subtitle = `claim · ${ed.confidence}`;
      } else if (s.type === 'editorial-take') {
        title = ed.subject_question;
        subtitle = `editorial take · ${ed.confidence} confidence`;
      } else if (s.type === 'period') {
        title = ed.title;
        subtitle = `${Math.abs(ed.start_year)}–${Math.abs(ed.end_year)} BCE`;
      } else if (s.type === 'source') {
        title = ed.title;
        subtitle = `source · ${ed.author ? ed.author + ' · ' : ''}${(ed.type ?? '').replace('_', ' ')}`;
      }
      return {
        type: s.type,
        href: `${stopUrlMap[s.type]}/${slug}`,
        title,
        subtitle,
        note: s.note,
      };
    } catch {
      return null;
    }
  })
).then((arr) => arr.filter(Boolean) as Array<any>);

const scopeLabel = d.scope.charAt(0).toUpperCase() + d.scope.slice(1);
---

<BaseLayout title={d.title} description={d.summary}>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <span hidden data-pagefind-filter="type:Threads" data-pagefind-meta="type:Thread"></span>

    <p class="eyebrow mb-3">
      Reading thread · <a href="/threads" class="text-tyrian-700 hover:underline">All threads</a>
    </p>
    <h1 class="font-serif text-4xl sm:text-5xl mb-3">{d.title}</h1>
    <p class="text-base text-sand-700 italic">{d.summary}</p>
    <p class="mt-3 text-sm text-sand-700">
      {scopeLabel} · {stops.length} stops · last revised {d.last_revised}
    </p>

    <aside class="border-l-4 border-tyrian-500 bg-tyrian-50 p-5 my-8 rounded-r-lg">
      <p class="text-[11px] uppercase tracking-widest font-bold text-tyrian-700 mb-2">Site curation</p>
      <p class="text-sm text-sand-900 leading-snug">
        Threads are explicitly curated reading paths through existing
        encyclopedia content. Each stop is an entity page in its own right;
        the thread frames an ordered journey through them with editorial
        annotation about what to look for at each stop. Where the prose below
        takes positions, the position is the site's own.
      </p>
    </aside>

    <div class="prose-encyclopedia text-sand-900 mt-8">
      <Content />
    </div>

    <section class="mt-12 pt-8 border-t border-sand-300">
      <h2 class="font-serif text-2xl mb-6">The thread</h2>
      <ol class="space-y-4">
        {stops.map((stop, i) => (
          <li class="flex gap-4">
            <span class="font-serif text-2xl text-tyrian-300 leading-none tabular-nums shrink-0 w-8 text-right">{i + 1}</span>
            <a href={stop.href} class="block flex-1 p-4 border border-sand-300 rounded-lg hover:bg-[#faf6ec] hover:border-tyrian-500 active:bg-purple-100 transition-colors">
              <div class="flex items-baseline justify-between gap-3 flex-wrap">
                <h3 class="font-serif text-lg text-tyrian-700">{stop.title}</h3>
                <span class="text-xs text-sand-700 shrink-0">{stop.subtitle}</span>
              </div>
              {stop.note && <p class="text-sm text-ink-900 mt-2 italic">{stop.note}</p>}
            </a>
          </li>
        ))}
      </ol>
    </section>

    <footer class="mt-12 pt-6 border-t border-sand-300 text-xs text-sand-700 italic">
      Reading thread · last revised {d.last_revised} · open to revision.
    </footer>
  </article>
</BaseLayout>
