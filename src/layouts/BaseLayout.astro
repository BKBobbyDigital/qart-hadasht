---
import '../styles/global.css';
import CmdKSearch from '../components/CmdKSearch.astro';
import TanitMark from '../components/TanitMark.astro';

interface Props {
  title: string;
  description?: string;
  /**
   * Header layout. 'editorial' is the magazine-cover masthead used on
   * the homepage: utility row, big wordmark block, full primary nav
   * with dividers. 'condensed' (the default) is the slim single-row
   * version used on every other page: small brand lockup left, primary
   * nav center, search right.
   */
  variant?: 'editorial' | 'condensed';
}

const {
  title,
  description = 'Qart-Hadasht — The Carthage Encyclopedia. A reference for ancient Carthage from founding to destruction.',
  variant = 'condensed',
} = Astro.props;
const fullTitle = title === 'Qart-Hadasht' ? title : `${title} — Qart-Hadasht`;

// Primary nav items, in order. Dividers go between every item on the
// editorial homepage; the condensed inner-page strip uses a slightly
// looser scheme (pipes between content sections, About sits at the end
// without a pipe — a small visual demotion).
const primaryNav = [
  { href: '/periods', label: 'Periods' },
  { href: '/themes', label: 'Themes' },
  { href: '/threads', label: 'Threads' },
  { href: '/narratives', label: 'Narratives' },
  { href: '/events', label: 'Events' },
  { href: '/people', label: 'People' },
  { href: '/places', label: 'Places' },
  { href: '/sources', label: 'Sources' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-sand-50">

    {variant === 'editorial' ? (
      <header class="bg-sand-100">
        <!-- Top tyrian rule -->
        <div class="h-[2px] bg-tyrian-700"></div>

        <!-- Utility row: About left, Search right -->
        <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between text-sm">
          <a href="/about" class="text-ink-900 hover:text-tyrian-700 transition-colors">About</a>
          <CmdKSearch />
        </div>

        <!-- Tyrian rule -->
        <div class="border-t border-tyrian-700"></div>

        <!-- Editorial masthead block: Phoenician + giant wordmark, Tanit+tagline floated right -->
        <div class="max-w-6xl mx-auto px-6 py-10 sm:py-14 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6">
          <a href="/" class="block group">
            <p class="font-phoenician text-3xl sm:text-4xl text-tyrian-700 leading-none mb-3">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
            <h1 class="font-serif text-6xl sm:text-8xl text-ink-900 leading-none tracking-tight group-hover:text-tyrian-900 transition-colors">Qart-Hadasht</h1>
          </a>
          <div class="flex items-center gap-3 sm:flex-col sm:items-end sm:text-right shrink-0">
            <span class="text-tyrian-700">
              <TanitMark size={36} />
            </span>
            <p class="eyebrow leading-tight">An encyclopedia<br class="hidden sm:inline" /> of ancient Carthage</p>
          </div>
        </div>

        <!-- Tyrian rule -->
        <div class="border-t border-tyrian-700"></div>

        <!-- Primary nav, dividers between every item -->
        <nav class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap items-center justify-center gap-x-3 sm:gap-x-4 gap-y-2 text-sm font-medium text-ink-900">
          {primaryNav.map((item, i) => (
            <>
              {i > 0 && <span class="text-sand-400" aria-hidden="true">|</span>}
              <a href={item.href} class="hover:text-tyrian-700 transition-colors">{item.label}</a>
            </>
          ))}
        </nav>

        <!-- Bottom tyrian rule -->
        <div class="border-t border-tyrian-700"></div>
      </header>
    ) : (
      <header class="bg-sand-50">
        <!-- Top tyrian rule -->
        <div class="h-[2px] bg-tyrian-700"></div>

        <!-- Condensed strip: brand lockup left, nav center, search right -->
        <div class="max-w-6xl mx-auto px-6 py-3 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/" class="group flex items-center gap-2.5 shrink-0">
            <span class="text-tyrian-700 group-hover:text-tyrian-900 transition-colors">
              <TanitMark size={28} />
            </span>
            <span class="flex flex-col leading-none">
              <span class="font-phoenician text-xs text-tyrian-700">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</span>
              <span class="font-serif text-base text-ink-900 mt-0.5">Qart-Hadasht</span>
            </span>
          </a>
          <nav class="flex flex-wrap items-center gap-x-2.5 sm:gap-x-3 gap-y-1 text-sm font-medium text-ink-900 flex-1 sm:justify-center">
            {primaryNav.map((item, i) => (
              <>
                {i > 0 && <span class="text-sand-400" aria-hidden="true">|</span>}
                <a href={item.href} class="hover:text-tyrian-700 transition-colors">{item.label}</a>
              </>
            ))}
            <a href="/about" class="ml-2 text-sand-700 hover:text-tyrian-700 transition-colors">About</a>
            <a href="/search" class="md:hidden text-sand-700 hover:text-tyrian-700 transition-colors">Search</a>
          </nav>
          <div class="shrink-0 ml-auto sm:ml-0">
            <CmdKSearch />
          </div>
        </div>

        <!-- Bottom tyrian rule -->
        <div class="border-t border-tyrian-700"></div>
      </header>
    )}

    <main class="flex-1" data-pagefind-body>
      <slot />
    </main>

    <footer class="mt-16 border-t border-tyrian-700 bg-sand-50">
      <div class="max-w-5xl mx-auto px-6 py-10 text-sm text-sand-700">
        <div class="flex items-start gap-4">
          <span class="text-tyrian-700 shrink-0">
            <TanitMark size={28} />
          </span>
          <div>
            <p class="text-ink-900">
              <span class="font-serif text-base">Qart-Hadasht</span> ·
              <span class="font-phoenician text-tyrian-700">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</span>
              <span class="text-sand-700"> · The Carthage Encyclopedia</span>
            </p>
            <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
              <a href="/about" class="text-tyrian-700 hover:underline">About</a>
              <a href="/methodology" class="text-tyrian-700 hover:underline">Methodology</a>
              <a href="/sources" class="text-tyrian-700 hover:underline">Sources</a>
              <a href="/threads" class="text-tyrian-700 hover:underline">Reading threads</a>
            </nav>
            <p class="mt-3 text-xs">
              Content licensed CC&nbsp;BY&nbsp;4.0 · Code MIT · An evolving reference for ancient Carthage.
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
