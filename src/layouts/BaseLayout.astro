---
import '../styles/global.css';
import CmdKSearch from '../components/CmdKSearch.astro';
import TanitMark from '../components/TanitMark.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Qart-Hadasht — The Carthage Encyclopedia. A reference for ancient Carthage from founding to destruction.',
} = Astro.props;
const fullTitle = title === 'Qart-Hadasht' ? title : `${title} — Qart-Hadasht`;

// Primary nav items, in order. Pipes between every item on every page.
const primaryNav = [
  { href: '/periods', label: 'Periods' },
  { href: '/themes', label: 'Themes' },
  { href: '/threads', label: 'Threads' },
  { href: '/narratives', label: 'Narratives' },
  { href: '/events', label: 'Events' },
  { href: '/people', label: 'People' },
  { href: '/places', label: 'Places' },
  { href: '/sources', label: 'Sources' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-sand-50">

    <!-- Editorial masthead — used across every page. Magazine-cover
         identity treatment: utility row (About + Search), then a big
         wordmark block with Tanit + tagline left and Phoenician script
         + Qart-Hadasht wordmark right, then the primary nav with pipes
         between every item. Sealed top and bottom by tyrian rules; an
         additional rule between each band gives the editorial rhythm. -->
    <header class="bg-sand-100">
      <!-- Top tyrian rule -->
      <div class="h-[2px] bg-tyrian-700"></div>

      <!-- Utility row: About left-of-search, both anchored right -->
      <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-end gap-5 text-sm">
        <a href="/about" class="text-ink-900 hover:text-tyrian-700 transition-colors">About</a>
        <CmdKSearch />
      </div>

      <!-- Tyrian rule -->
      <div class="border-t border-tyrian-700"></div>

      <!-- Editorial masthead block.
           Mobile: stacks vertically (Tanit + tagline above wordmark).
           Desktop: Tanit + tagline left, Phoenician + wordmark right,
           with the wordmark right-aligned for editorial weight. -->
      <a href="/" class="block group">
        <div class="max-w-6xl mx-auto px-6 py-8 sm:py-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 sm:gap-10">
          <div class="flex items-center gap-4 sm:flex-col sm:items-start shrink-0">
            <span class="text-tyrian-700 group-hover:text-tyrian-900 transition-colors">
              <TanitMark size={56} />
            </span>
            <p class="eyebrow leading-tight">An encyclopedia<br /> of ancient Carthage</p>
          </div>
          <div class="text-right">
            <p class="font-phoenician text-2xl sm:text-3xl text-tyrian-700 leading-none mb-2 sm:mb-3">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
            <h1 class="font-serif text-5xl sm:text-7xl lg:text-8xl text-ink-900 leading-[0.95] tracking-tight group-hover:text-tyrian-900 transition-colors">Qart-Hadasht</h1>
          </div>
        </div>
      </a>

      <!-- Tyrian rule -->
      <div class="border-t border-tyrian-700"></div>

      <!-- Primary nav, dividers between every item -->
      <nav class="max-w-6xl mx-auto px-6 py-3 flex flex-wrap items-center justify-center gap-x-3 sm:gap-x-4 gap-y-2 text-sm font-medium text-ink-900">
        {primaryNav.map((item, i) => (
          <>
            {i > 0 && <span class="text-sand-400" aria-hidden="true">|</span>}
            <a href={item.href} class="hover:text-tyrian-700 transition-colors">{item.label}</a>
          </>
        ))}
      </nav>

      <!-- Bottom tyrian rule -->
      <div class="border-t border-tyrian-700"></div>
    </header>

    <main class="flex-1" data-pagefind-body>
      <slot />
    </main>

    <footer class="mt-16 border-t border-tyrian-700 bg-sand-50">
      <div class="max-w-5xl mx-auto px-6 py-10 text-sm text-sand-700">
        <div class="flex items-start gap-4">
          <span class="text-tyrian-700 shrink-0">
            <TanitMark size={28} />
          </span>
          <div>
            <p class="text-ink-900">
              <span class="font-serif text-base">Qart-Hadasht</span> ·
              <span class="font-phoenician text-tyrian-700">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</span>
              <span class="text-sand-700"> · The Carthage Encyclopedia</span>
            </p>
            <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
              <a href="/about" class="text-tyrian-700 hover:underline">About</a>
              <a href="/methodology" class="text-tyrian-700 hover:underline">Methodology</a>
              <a href="/sources" class="text-tyrian-700 hover:underline">Sources</a>
              <a href="/threads" class="text-tyrian-700 hover:underline">Reading threads</a>
            </nav>
            <p class="mt-3 text-xs">
              Content licensed CC&nbsp;BY&nbsp;4.0 · Code MIT · An evolving reference for ancient Carthage.
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
