---
import '../styles/global.css';
import CmdKSearch from '../components/CmdKSearch.astro';
import TanitMark from '../components/TanitMark.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Qart-Hadasht — The Carthage Encyclopedia. A reference for ancient Carthage from founding to destruction.',
} = Astro.props;
const fullTitle = title === 'Qart-Hadasht' ? title : `${title} — Qart-Hadasht`;

// Primary nav items, in order. Pipes between every item on every page.
const primaryNav = [
  { href: '/periods', label: 'Periods' },
  { href: '/themes', label: 'Themes' },
  { href: '/threads', label: 'Threads' },
  { href: '/narratives', label: 'Narratives' },
  { href: '/events', label: 'Events' },
  { href: '/people', label: 'People' },
  { href: '/places', label: 'Places' },
  { href: '/sources', label: 'Sources' },
  { href: '/artifacts', label: 'Artifacts' },
];
---

<!DOCTYPE html>
<!--
  Qart-Hadasht — The Carthage Encyclopedia
  https://qart-hadasht.org
  Content licensed CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/).
  Code MIT.
  If you're seeing this comment on any other domain, the page was
  copied from qart-hadasht.org. The license requires attribution back
  to the original.
-->
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- AI-training opt-out at the HTML level. The robots.txt
         block is the primary signal; this is a per-page reinforcement
         that some crawlers consult separately. Cooperative
         protocol — bad-faith scrapers ignore it; the major AI
         companies have committed to honor it. -->
    <meta name="robots" content="noai, noimageai" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <!-- Schema.org provenance markers. Helps search engines
         understand the site and its license, and provides a
         machine-readable signature that survives content copying. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': 'Qart-Hadasht',
      'alternateName': 'The Carthage Encyclopedia',
      'url': 'https://qart-hadasht.org',
      'description': 'An evolving encyclopedia of ancient Carthage from its founding to its destruction in 146 BCE. Every claim is sourced, every confidence level made explicit, every gap in the record named.',
      'license': 'https://creativecommons.org/licenses/by/4.0/',
      'inLanguage': 'en',
      'isAccessibleForFree': true,
      'keywords': 'Carthage, Punic, Phoenician, Hannibal, ancient history, Mediterranean history, Tophet, Tanit, Punic Wars',
    })} />
  </head>
  <body class="min-h-screen flex flex-col bg-sand-50">

    <!-- Editorial masthead — sealed top and bottom by tyrian rules,
         no internal rules. All three bands (utility row, masthead,
         primary nav) share one parent max-w-6xl px-6 container so the
         bounds are guaranteed identical: Periods/wordmark/About-side
         line up on the left, Sources/Tanit-cluster/Search line up on
         the right. Mobile (below sm) collapses to centered stacks. -->
    <header class="bg-sand-100">
      <!-- Top tyrian rule -->
      <div class="h-[2px] bg-tyrian-700"></div>

      <div class="max-w-4xl mx-auto px-6">
        <!-- Utility row -->
        <div class="py-2 flex items-center justify-end gap-5 text-sm">
          <a href="/about" class="text-ink-900 hover:text-tyrian-700 transition-colors">About</a>
          <CmdKSearch />
        </div>

        <!-- Masthead block.
             Desktop: Phoenician + Qart-Hadasht wordmark left-bound,
             Tanit + tagline cluster right-bound (content centered
             within itself).
             Mobile: stacks vertically, both centered. -->
        <a href="/" class="block group py-4 sm:py-5">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 sm:gap-8">
            <div class="text-center sm:text-left">
              <p class="font-phoenician text-xl sm:text-2xl text-tyrian-700 leading-none mb-1.5">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
              <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-ink-900 leading-none tracking-tight group-hover:text-tyrian-900 transition-colors">Qart-Hadasht</h1>
            </div>
            <div class="flex flex-col items-center text-center shrink-0">
              <span class="text-tyrian-700 group-hover:text-tyrian-900 transition-colors">
                <TanitMark size={32} />
              </span>
              <p class="eyebrow leading-tight mt-1.5">An encyclopedia<br />of ancient Carthage</p>
            </div>
          </div>
        </a>

        <!-- Primary nav. justify-between on desktop binds Periods to
             left edge and Sources to right edge of this same parent
             container. Mobile wraps and centers. -->
        <nav class="py-2 flex flex-wrap items-center justify-center sm:justify-between gap-x-3 sm:gap-x-4 gap-y-2 text-sm font-medium text-ink-900">
          {primaryNav.map((item, i) => (
            <>
              {i > 0 && <span class="text-sand-400" aria-hidden="true">|</span>}
              <a href={item.href} class="hover:text-tyrian-700 transition-colors">{item.label}</a>
            </>
          ))}
        </nav>
      </div>

      <!-- Bottom tyrian rule -->
      <div class="border-t border-tyrian-700"></div>
    </header>

    <main class="flex-1" data-pagefind-body>
      <slot />
    </main>

    <footer class="mt-16 border-t border-tyrian-700 bg-sand-50">
      <div class="max-w-4xl mx-auto px-6 py-10 text-sm text-sand-700">
        <div class="flex items-start gap-4">
          <span class="text-tyrian-700 shrink-0">
            <TanitMark size={28} />
          </span>
          <div>
            <p class="text-ink-900">
              <span class="font-serif text-base">Qart-Hadasht</span> ·
              <span class="font-phoenician text-tyrian-700">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</span>
              <span class="text-sand-700"> · The Carthage Encyclopedia</span>
            </p>
            <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
              <a href="/about" class="text-tyrian-700 hover:underline">About</a>
              <a href="/methodology" class="text-tyrian-700 hover:underline">Methodology</a>
              <a href="/sources" class="text-tyrian-700 hover:underline">Sources</a>
              <a href="/threads" class="text-tyrian-700 hover:underline">Reading threads</a>
            </nav>
            <p class="mt-3 text-xs">
              Content licensed CC&nbsp;BY&nbsp;4.0 · Code MIT · An evolving reference for ancient Carthage.
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
