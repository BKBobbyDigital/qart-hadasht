---
import '../styles/global.css';
import CmdKSearch from '../components/CmdKSearch.astro';
import TanitMark from '../components/TanitMark.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Qart-Hadasht — The Carthage Encyclopedia. A reference for ancient Carthage from founding to destruction.' } = Astro.props;
const fullTitle = title === 'Qart-Hadasht' ? title : `${title} — Qart-Hadasht`;

// Pages can provide a `hero` slot to render an editorial hero block
// merged into the masthead — one continuous header surface rather than
// nav + separate hero stack. When the slot is present, the masthead
// shifts to a slightly elevated cream and drops its bottom border so
// the nav row and the hero share one visual block (Monocle-style).
const hasHero = Astro.slots.has('hero');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-sand-50">
    <header class={hasHero ? 'bg-sand-100' : 'border-b border-sand-300 bg-sand-50'}>
      <!-- Top tyrian rule — small visual signature reading from across the room -->
      <div class="h-1 bg-tyrian-700"></div>
      <div class="max-w-5xl mx-auto px-6 py-5 flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between">
        <a href="/" class="group flex items-center gap-3">
          <span class="text-tyrian-700 group-hover:text-tyrian-900 transition-colors">
            <TanitMark size={32} />
          </span>
          <span class="flex flex-col leading-tight">
            <span class="font-serif text-xl text-ink-900">Qart-Hadasht</span>
            <span class="font-phoenician text-base text-tyrian-700 leading-none mt-0.5">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</span>
            <span class="eyebrow-muted mt-1.5">The Carthage Encyclopedia</span>
          </span>
        </a>
        <nav class="flex flex-wrap items-center gap-x-3 sm:gap-x-4 gap-y-1 text-sm font-medium text-ink-900 sm:justify-end">
          <a href="/periods" class="hover:text-tyrian-700 transition-colors">Periods</a>
          <a href="/themes" class="hover:text-tyrian-700 transition-colors">Themes</a>
          <a href="/threads" class="hover:text-tyrian-700 transition-colors">Threads</a>
          <a href="/narratives" class="hover:text-tyrian-700 transition-colors">Narratives</a>
          <span class="hidden sm:inline-block w-px h-3 bg-sand-300" aria-hidden="true"></span>
          <a href="/events" class="hover:text-tyrian-700 transition-colors">Events</a>
          <a href="/people" class="hover:text-tyrian-700 transition-colors">People</a>
          <a href="/places" class="hover:text-tyrian-700 transition-colors">Places</a>
          <a href="/sources" class="hover:text-tyrian-700 transition-colors">Sources</a>
          <span class="hidden sm:inline-block w-px h-3 bg-sand-300" aria-hidden="true"></span>
          <a href="/about" class="hover:text-tyrian-700 transition-colors">About</a>
          <a href="/search" class="md:hidden hover:text-tyrian-700 transition-colors">Search</a>
          <CmdKSearch />
        </nav>
      </div>
      {hasHero && <slot name="hero" />}
    </header>
    {hasHero && <div class="border-b border-tyrian-700"></div>}

    <main class="flex-1" data-pagefind-body>
      <slot />
    </main>

    <footer class="mt-16 border-t border-tyrian-700 bg-sand-50">
      <div class="max-w-5xl mx-auto px-6 py-10 text-sm text-sand-700">
        <div class="flex items-start gap-4">
          <span class="text-tyrian-700 shrink-0">
            <TanitMark size={28} />
          </span>
          <div>
            <p class="text-ink-900">
              <span class="font-serif text-base">Qart-Hadasht</span> ·
              <span class="font-phoenician text-tyrian-700">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</span>
              <span class="text-sand-700"> · The Carthage Encyclopedia</span>
            </p>
            <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
              <a href="/about" class="text-tyrian-700 hover:underline">About</a>
              <a href="/methodology" class="text-tyrian-700 hover:underline">Methodology</a>
              <a href="/sources" class="text-tyrian-700 hover:underline">Sources</a>
              <a href="/threads" class="text-tyrian-700 hover:underline">Reading threads</a>
            </nav>
            <p class="mt-3 text-xs">
              Content licensed CC&nbsp;BY&nbsp;4.0 · Code MIT · An evolving reference for ancient Carthage.
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
