---
import '../styles/global.css';
import CmdKSearch from '../components/CmdKSearch.astro';
import TanitMark from '../components/TanitMark.astro';

interface Props {
  title: string;
  description?: string;
  /**
   * Open Graph / Twitter card type. 'website' for the homepage and
   * listing pages; 'article' for entity and long-form pages.
   */
  ogType?: 'website' | 'article';
  /** Absolute or root-relative share image; defaults to the branded card. */
  image?: string;
  /**
   * Optional page-specific schema.org JSON-LD (object or array), built by
   * src/lib/structuredData.ts. The canonical `url`/`mainEntityOfPage` are
   * injected here so routes don't need the absolute URL. Invisible <head>
   * metadata only.
   */
  jsonld?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = 'Qart-Hadasht — The Carthage Encyclopedia. A reference for ancient Carthage from founding to destruction.',
  ogType = 'website',
  image = '/og-default.png',
  jsonld,
} = Astro.props;
const fullTitle = title === 'Qart-Hadasht' ? title : `${title} — Qart-Hadasht`;

// Canonical + absolute URLs. Astro.site is set in astro.config.mjs, so
// these resolve to https://qart-hadasht.org/... at build time.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Page-specific JSON-LD: inject the canonical URL onto each entity object.
const jsonldList = (jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : []).map(
  (obj) => ({ ...obj, url: canonicalURL.href, mainEntityOfPage: canonicalURL.href })
);

// Auto-generated BreadcrumbList from the path (Home › Section › Title).
// Google renders these directly in results; no visible page change.
const segs = Astro.url.pathname.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
const prettySeg = (s: string) =>
  s.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^./, (c) => c.toUpperCase());
let breadcrumbLd: Record<string, any> | null = null;
if (segs.length > 0) {
  const crumbs: { name: string; item: string }[] = [
    { name: 'Home', item: new URL('/', Astro.site).href },
  ];
  let acc = '';
  segs.forEach((seg, i) => {
    acc += '/' + seg;
    const isLast = i === segs.length - 1;
    crumbs.push({
      name: isLast ? title : prettySeg(seg),
      item: new URL(acc, Astro.site).href,
    });
  });
  breadcrumbLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: c.name,
      item: c.item,
    })),
  };
}

// Primary nav, grouped by epistemic kind:
//   - REFERENCE: atomic encyclopedia entries (what/who/where lookups)
//   - SYNTHESIS: the site's interpretive voice (long-form, curated,
//     visualized)
//   - EVIDENCE: source material backing the claims (ancient texts,
//     modern scholarship, material culture)
// Rendered as three groups separated by ‖ dividers, with eyebrow
// labels centered over each group.
const navGroups = [
  {
    label: 'Reference',
    items: [
      { href: '/events', label: 'Events' },
      { href: '/people', label: 'People' },
      { href: '/places', label: 'Places' },
    ],
  },
  {
    label: 'Synthesis',
    items: [
      { href: '/periods', label: 'Periods' },
      { href: '/themes', label: 'Themes' },
      { href: '/narratives', label: 'Narratives' },
      { href: '/threads', label: 'Threads' },
      { href: '/maps', label: 'Maps' },
    ],
  },
  {
    label: 'Evidence',
    items: [
      { href: '/sources', label: 'Sources' },
      { href: '/artifacts', label: 'Artifacts' },
    ],
  },
];
---

<!DOCTYPE html>
<!--
  Qart-Hadasht — The Carthage Encyclopedia
  https://qart-hadasht.org
  Content licensed CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/).
  Code MIT.
  If you're seeing this comment on any other domain, the page was
  copied from qart-hadasht.org. The license requires attribution back
  to the original.
-->
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph — link previews in social, chat apps, and some
         search/AI preview cards. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Qart-Hadasht" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X card. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <!-- AI-training opt-out at the HTML level. The robots.txt
         block is the primary signal; this is a per-page reinforcement
         that some crawlers consult separately. Cooperative
         protocol — bad-faith scrapers ignore it; the major AI
         companies have committed to honor it. -->
    <meta name="robots" content="noai, noimageai" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PWA: web manifest + theme color + iOS home-screen meta. The
         site is installable as a home-screen app on modern browsers
         (no service worker — this is "installable" not
         "offline-capable"). The Tanit-mark icon set lives in /public
         as SVG (favicon.svg, icon-maskable.svg, apple-touch-icon.svg). -->
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <meta name="theme-color" content="#5b0f31" />
    <meta name="apple-mobile-web-app-title" content="Qart-Hadasht" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{fullTitle}</title>
    <!-- Schema.org provenance markers. Helps search engines
         understand the site and its license, and provides a
         machine-readable signature that survives content copying. -->
    <!-- GoatCounter analytics. Privacy-first, no cookies, no personal
         data collected. Only aggregate page views and a small set of
         site-instrumented custom events (citation-panel opens, citation
         format copies, anchor-link copies, etc.). Async so it doesn't
         block page render; the script's failure to load is silent and
         the page works normally without it. See /methodology for the
         full list of what's tracked. -->
    <script data-goatcounter="https://carthage.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': 'Qart-Hadasht',
      'alternateName': 'The Carthage Encyclopedia',
      'url': 'https://qart-hadasht.org',
      'description': 'An evolving encyclopedia of ancient Carthage from its founding to its destruction in 146 BCE. Every claim is sourced, every confidence level made explicit, every gap in the record named.',
      'license': 'https://creativecommons.org/licenses/by/4.0/',
      'inLanguage': 'en',
      'isAccessibleForFree': true,
      'keywords': 'Carthage, Punic, Phoenician, Hannibal, ancient history, Mediterranean history, Tophet, Tanit, Punic Wars',
    })} />

    {/* Page-specific entity schema (Person / Place / Article / …). */}
    {jsonldList.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    {/* Breadcrumb trail for search results. */}
    {breadcrumbLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-[color:var(--color-canvas)]">

    <!-- Skip-to-main-content link for keyboard and screen-reader users.
         Visually hidden until focused; first thing tab-keyboard reaches. -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Editorial masthead (mock-c). Opened by a 5px tyrian rule,
         closed by a 3px ink rule under the nav. All three bands
         (utility row, masthead, primary nav) share one max-w-6xl px-6
         container so their left/right bounds are identical and
         everything is left-aligned: wordmark and nav pack to the left,
         the About/Search utilities and the Tanit tagline cluster sit
         at the right edge. Left alignment holds on mobile; the tagline
         text hides below sm while the Tanit mark stays. -->
    <header class="bg-white">
      <!-- Top tyrian ribbon — full-bleed across the viewport. -->
      <div class="h-[5px] bg-tyrian-700"></div>

      <div class="max-w-6xl mx-auto px-6">
        <!-- Utility row -->
        <div class="py-2 flex items-center justify-end gap-5 text-sm">
          <a href="/about" class="text-ink-900 hover:text-tyrian-700 transition-colors">About</a>
          <CmdKSearch />
        </div>

        <!-- Masthead block.
             Desktop: Phoenician + Qart-Hadasht wordmark left-bound,
             Tanit + tagline cluster right-bound (content centered
             within itself).
             Mobile: stacks vertically, both centered. -->
        <a href="/" class="block group py-4 sm:py-5">
          <div class="flex items-center justify-between gap-4 sm:gap-8">
            <div class="text-left min-w-0">
              <p class="font-phoenician text-lg sm:text-xl text-tyrian-700 leading-none mb-1.5 tracking-[0.15em]">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
              <p aria-label="Qart-Hadasht — homepage link" class="font-heritage text-[2rem] sm:text-5xl text-ink-900 leading-none tracking-tight whitespace-nowrap group-hover:text-tyrian-900 transition-colors">Qart-Hadasht</p>
            </div>
            <div class="flex items-center gap-3 shrink-0 text-tyrian-700 group-hover:text-tyrian-900 transition-colors">
              <TanitMark size={32} />
              <!-- Wrapper carries the responsive display toggle: the inner
                   .eyebrow hard-sets display:inline-flex in global.css, which
                   would override a `hidden` placed directly on it. -->
              <div class="hidden sm:block">
                <p class="eyebrow no-bar leading-tight text-right">An encyclopedia<br />of ancient Carthage</p>
              </div>
            </div>
          </div>
        </a>

        <!-- Thin sand rule separating the brand block from the
             primary nav. Editorial-quiet, doesn't compete with the
             top/bottom tyrian rules bookending the masthead. -->
        <div class="border-t border-sand-300"></div>

        <!-- Primary nav grouped by epistemic kind (Reference /
             Synthesis / Evidence). Option B "stacked" layout: each
             group is a left-aligned column — a tyrian eyebrow label
             sitting above its links (separated by · middots). The
             three columns sit side by side and wrap as whole units;
             on mobile they stack, label-over-links, still left-aligned.
             Stacking the label above its links is what separates the
             group heads from the link text (the inline version read
             as one jumbled string). -->

        <nav class="py-3 flex flex-wrap gap-x-12 gap-y-3 text-[15px] font-semibold text-ink-900" aria-label="Primary navigation">
          {navGroups.map((group) => (
            <div class="flex flex-col gap-y-1.5">
              <span class="eyebrow no-bar text-[10px]">{group.label}</span>
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                {group.items.map((item, ii) => (
                  <>
                    {ii > 0 && <span class="text-sand-500" aria-hidden="true">·</span>}
                    <a href={item.href} class="whitespace-nowrap hover:text-tyrian-700 transition-colors">{item.label}</a>
                  </>
                ))}
              </div>
            </div>
          ))}
        </nav>

        <!-- Strong ink rule closing the nav — held to the content column,
             not full-bleed (Direction C: 3px). -->
        <div class="border-t-[3px] border-ink-900"></div>
      </div>
    </header>

    <main id="main-content" class="flex-1" data-pagefind-body tabindex="-1">
      <slot />
    </main>

    <!-- Footer — a brand sign-off (Direction C): the Phoenician wordmark
         glyph row + Fraunces wordmark as a closing moment, then a flat
         link row and the license line. Opened by a 4px tyrian bar on the
         faint-gray surface, bookending the 5px tyrian bar up top. -->
    <footer class="mt-16 border-t-4 border-tyrian-700 bg-[#f6f6f7]">
      <div class="max-w-6xl mx-auto px-6 pt-11 pb-8">
        <p class="font-phoenician text-3xl text-tyrian-700 leading-none tracking-[0.14em]">𐤒𐤓𐤕𐤇𐤃𐤔𐤕</p>
        <p class="font-heritage text-[2rem] sm:text-[2.6rem] text-ink-900 leading-none tracking-tight mt-3">Qart-Hadasht</p>
        <p class="text-sand-700 text-[15px] leading-relaxed mt-3 max-w-[52ch]">
          The Carthage Encyclopedia. An evolving, sourced reference from the
          founding to 146 BCE.
        </p>
        <nav class="flex flex-wrap gap-x-6 gap-y-2 mt-6 pt-4 border-t border-sand-300 text-sm" aria-label="Footer">
          <a href="/about" class="text-ink-900 hover:text-tyrian-700 transition-colors">About</a>
          <a href="/methodology" class="text-ink-900 hover:text-tyrian-700 transition-colors">Methodology</a>
          <a href="/sources" class="text-ink-900 hover:text-tyrian-700 transition-colors">Sources</a>
          <a href="/threads" class="text-ink-900 hover:text-tyrian-700 transition-colors">Reading threads</a>
          <a href="/maps" class="text-ink-900 hover:text-tyrian-700 transition-colors">Maps</a>
        </nav>
        <p class="text-xs text-sand-700 mt-5">
          Content licensed CC&nbsp;BY&nbsp;4.0 · Code MIT · An evolving reference for ancient Carthage.
        </p>
      </div>
    </footer>

    <!-- Privacy-first analytics helper. Wraps GoatCounter's custom-event
         API so the rest of the site can call `window.qhTrack(name)`
         without checking whether GoatCounter loaded. Silent no-op if
         GoatCounter is blocked or hasn't loaded yet. -->
    <script is:inline>
      window.qhTrack = function (name, detail) {
        try {
          if (!window.goatcounter || typeof window.goatcounter.count !== 'function') return;
          window.goatcounter.count({
            path: 'event:' + name + (detail ? ':' + detail : ''),
            title: name + (detail ? ' / ' + detail : ''),
            event: true,
          });
        } catch (_) { /* silent */ }
      };
    </script>

    <!-- Heading permalink anchors.
         The renderSummaryHtml helper emits ¶ anchor links inline for YAML-
         summary headings; for markdown content (narratives, themes, periods)
         Astro injects heading ids but no anchor markup, so we append a ¶
         anchor to every h2/h3 with an id at page load.
         Clicking any ¶ anchor copies the absolute URL+hash to clipboard so
         academic readers can paste a stable permalink directly into a
         citation. -->
    <script is:inline>
      (() => {
        // Inject ¶ anchors on prose headings that don't already have one
        // (server-rendered YAML-summary headings already have theirs).
        const proseContainers = document.querySelectorAll('.prose-encyclopedia, article > main, article');
        const seen = new Set();
        proseContainers.forEach((container) => {
          container.querySelectorAll('h2[id], h3[id]').forEach((h) => {
            if (seen.has(h)) return;
            seen.add(h);
            if (h.querySelector('.anchor-link')) return;
            const id = h.getAttribute('id');
            if (!id) return;
            const a = document.createElement('a');
            a.className = 'anchor-link';
            a.href = '#' + id;
            a.setAttribute('aria-label', 'Copy link to this section');
            a.setAttribute('data-anchor', '');
            a.textContent = '¶';
            h.appendChild(document.createTextNode(' '));
            h.appendChild(a);
          });
        });

        // Click handler: copy absolute URL+hash to clipboard.
        document.addEventListener('click', (e) => {
          const a = e.target instanceof Element ? e.target.closest('a.anchor-link[data-anchor]') : null;
          if (!a) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const hash = a.getAttribute('href') || '';
          const url = window.location.origin + window.location.pathname + hash;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(() => {
              a.classList.add('anchor-copied');
              setTimeout(() => a.classList.remove('anchor-copied'), 1400);
              if (window.qhTrack) window.qhTrack('anchor-copy');
            }).catch(() => { /* fall through to default nav */ });
          }
        });

        // Track outbound clicks to external URLs (anything not on this
        // site's domain). Strong signal of academic-quality engagement:
        // people following citation links to verify sources at publishers,
        // archives, JSTOR, Wikipedia, Wikimedia Commons, etc. Records the
        // destination domain only (not the full URL or query string).
        document.addEventListener('click', (e) => {
          const a = e.target instanceof Element ? e.target.closest('a[href^="http"]') : null;
          if (!a) return;
          let host;
          try { host = new URL(a.href).host; } catch { return; }
          if (!host) return;
          // Skip same-origin links (some absolute self-references exist).
          if (host === window.location.host) return;
          if (window.qhTrack) window.qhTrack('outbound-click', host);
        });

        // Read-completion tracking. When a substantive page's VersionStamp
        // footer scrolls into view, fire `read-complete`. This means the
        // reader scrolled to the bottom of the prose; the strongest
        // available signal that long-form content is being read rather
        // than skimmed. Uses IntersectionObserver; fires at most once
        // per page load.
        if ('IntersectionObserver' in window) {
          const versionFooter = document.querySelector('[data-version-stamp]');
          if (versionFooter) {
            let fired = false;
            const obs = new IntersectionObserver((entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting && !fired) {
                  fired = true;
                  obs.disconnect();
                  if (window.qhTrack) window.qhTrack('read-complete');
                  break;
                }
              }
            }, { threshold: 0.5 });
            obs.observe(versionFooter);
          }
        }
      })();
    </script>
  </body>
</html>
